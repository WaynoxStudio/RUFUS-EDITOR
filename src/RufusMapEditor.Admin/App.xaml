<Application x:Class="RufusMapEditor.Admin.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="App_OnStartup"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/RufusMapEditor;component/Themes/ColorsDark.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/RufusMapEditor;component/Themes/Controls.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/RufusMapEditor;component/Themes/ToolIcons.xaml"/>
      </ResourceDictionary.MergedDictionaries>

    <!-- Admin shell (updated at runtime by AdminShellTheme) -->
    <SolidColorBrush x:Key="Bg" Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="SidebarBg" Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="ShellText" Color="#FFF3F3F3"/>
    <SolidColorBrush x:Key="ShellMuted" Color="#FFD0D0D0"/>
    <SolidColorBrush x:Key="SidebarConnectionBackground" Color="#FF2A241C"/>
    <SolidColorBrush x:Key="SidebarConnectionBorder" Color="#FF3D3528"/>
    <SolidColorBrush x:Key="SidebarBorder" Color="#FF2A2A2A"/>

    <!-- Content panels (warm beige — same as editor de contenido) -->
    <SolidColorBrush x:Key="Panel" Color="#FFE6E0C8"/>
    <SolidColorBrush x:Key="PanelElevated" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text" Color="#FF2C2416"/>
    <SolidColorBrush x:Key="Muted" Color="#FF5C4F3A"/>
    <SolidColorBrush x:Key="Danger" Color="#FFC0392B"/>
    <SolidColorBrush x:Key="DataGridAltRow" Color="#FFEDE8D4"/>
    <SolidColorBrush x:Key="NavHover" Color="#FF2E2A24"/>

    <FontFamily x:Key="AppFont">Segoe UI Variable, Segoe UI, sans-serif</FontFamily>

    <Style TargetType="Window">
      <Setter Property="Background" Value="{DynamicResource Bg}"/>
      <Setter Property="Foreground" Value="{DynamicResource ShellText}"/>
      <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
    </Style>

    <Style x:Key="ShellTextBlock" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ShellText}"/>
      <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    </Style>

    <Style x:Key="ShellMutedText" TargetType="TextBlock" BasedOn="{StaticResource ShellTextBlock}">
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="26"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="SectionCaption" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Margin" Value="0,0,0,20"/>
    </Style>

    <Style x:Key="SubSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="Margin" Value="0,8,0,14"/>
    </Style>

    <Style x:Key="SidebarConnectionPanel" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SidebarConnectionBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SidebarConnectionBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="8,7"/>
      <Setter Property="Margin" Value="8,0,8,8"/>
    </Style>

    <Style x:Key="SidebarConnectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="SidebarConnectionName" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Width" Value="52"/>
    </Style>

    <Style x:Key="SidebarConnectionStatus" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource ShellText}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="SidebarConnectionHost" TargetType="TextBlock">
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="Margin" Value="14,4,0,6"/>
      <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
    </Style>

    <Style x:Key="SidebarCheckButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <Style x:Key="MetricLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="MetricValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="34"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Margin" Value="0,10,0,0"/>
    </Style>

    <Style x:Key="MetricValueSm" TargetType="TextBlock" BasedOn="{StaticResource MetricValue}">
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="Margin" Value="0,10,0,0"/>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource PanelElevated}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="18"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.08" Direction="270" Color="#FF000000"/>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CardBrownHeader" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="{DynamicResource Panel}"/>
    </Style>

    <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Padding" Value="20"/>
      <Setter Property="MinWidth" Value="160"/>
      <Setter Property="MinHeight" Value="96"/>
    </Style>

    <!-- TextBox/CheckBox: use shared Controls.xaml styles (warm inputs). Do NOT BasedOn self — crashes WPF. -->

    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource InputForeground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="CaretBrush" Value="{DynamicResource InputForeground}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBackground}"/>
    </Style>

    <!-- Embedded Maps/Content: empty scroll areas inherit workspace surface, not dark chrome -->
    <Style TargetType="ScrollViewer">
      <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource DeleteButton}"/>

    <Style x:Key="NavButton" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource ShellText}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Margin" Value="8,2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="GroupName" Value="AdminNav"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
              <Grid>
                <Border x:Name="AccentBar" Width="3" HorizontalAlignment="Left" Margin="-8,2,0,2"
                        CornerRadius="2" Background="Transparent"/>
                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"
                                  TextElement.Foreground="{TemplateBinding Foreground}" Margin="4,0,0,0"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource NavHover}"/>
                <Setter Property="Foreground" Value="{DynamicResource ShellText}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource HeaderForeground}"/>
                <Setter Property="Foreground" Value="{DynamicResource HeaderForeground}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FilterChip" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackground}"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="GroupName" Value="FilterChip"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource HeaderForeground}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="{DynamicResource PanelElevated}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="RowBackground" Value="{DynamicResource PanelElevated}"/>
      <Setter Property="AlternatingRowBackground" Value="{DynamicResource DataGridAltRow}"/>
      <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Border}"/>
      <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="SelectionMode" Value="Single"/>
      <Setter Property="SelectionUnit" Value="FullRow"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="CanUserDeleteRows" Value="False"/>
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="RowHeight" Value="40"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource DialogHeaderBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource HeaderForeground}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style TargetType="DataGridCell">
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource SelectionBackground}"/>
          <Setter Property="Foreground" Value="{DynamicResource SelectionForeground}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="DataGridRow">
      <Setter Property="Background" Value="Transparent"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource SelectionBackground}"/>
          <Setter Property="Foreground" Value="{DynamicResource SelectionForeground}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="NavButtonCompact" TargetType="RadioButton" BasedOn="{StaticResource NavButton}">
      <Setter Property="GroupName" Value="AdminNavCompact"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="6,2"/>
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="SidebarToggleButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,8,0,8"/>
      <Setter Property="ToolTip" Value="Desplegar barra lateral"/>
    </Style>

    <Style x:Key="SidebarBrandHeader" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SidebarConnectionBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SidebarConnectionBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="8,8"/>
      <Setter Property="Margin" Value="8,8,8,8"/>
    </Style>

    <Style x:Key="SidebarBrandMark" TargetType="Border">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SidebarBrandMarkText" TargetType="TextBlock">
      <Setter Property="Text" Value="R"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{DynamicResource HeaderForeground}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SidebarBrandTitle" TargetType="TextBlock">
      <Setter Property="Text" Value="RUFUS"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{DynamicResource ShellText}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SidebarBrandBadge" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource AccentSubtle}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="7,2"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
    </Style>

    <Style x:Key="SidebarBrandBadgeText" TargetType="TextBlock">
      <Setter Property="Text" Value="Admin"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    </Style>

    <Style x:Key="SidebarHeaderToggle" TargetType="Button">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource ShellMuted}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="ToolTip" Value="Plegar barra lateral"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="2">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavHover}"/>
                <Setter Property="Foreground" Value="{DynamicResource ShellText}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NavGroupLabel" TargetType="TextBlock" BasedOn="{StaticResource ShellMutedText}">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="12,6,10,2"/>
      <Setter Property="Foreground" Value="{DynamicResource ShellText}"/>
      <Setter Property="Opacity" Value="0.55"/>
    </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
