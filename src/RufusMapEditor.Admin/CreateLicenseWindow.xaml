<Window x:Class="RufusMapEditor.Admin.CreateLicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crear licencia" Height="560" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource Panel}" Foreground="{StaticResource Text}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
    <StackPanel>
      <TextBlock Text="Crear licencia" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock Text="Los valores por defecto reflejan 1 dispositivo y 1 sesión."
                 Style="{StaticResource MutedText}" Margin="0,4,0,16"/>

      <TextBlock Text="NOMBRE / TITULAR" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource Muted}"/>
      <TextBlock Text="Opcional — para identificar al cliente en el listado." Style="{StaticResource MutedText}" Margin="0,2,0,6"/>
      <TextBox x:Name="NameBox" Margin="0,0,0,12" ToolTip="Ej. Juan Pérez, prueba interna, beta tester"/>

      <TextBlock Text="DURACIÓN" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource Muted}"/>
      <ComboBox x:Name="DurationCombo" Margin="0,6,0,12" SelectedIndex="4">
        <ComboBoxItem Content="1 día" Tag="1"/>
        <ComboBoxItem Content="3 días" Tag="3"/>
        <ComboBoxItem Content="7 días" Tag="7"/>
        <ComboBoxItem Content="15 días" Tag="15"/>
        <ComboBoxItem Content="30 días" Tag="30"/>
        <ComboBoxItem Content="90 días" Tag="90"/>
        <ComboBoxItem Content="Personalizada…" Tag="custom"/>
      </ComboBox>
      <TextBox x:Name="CustomDaysBox" Margin="0,0,0,12" Visibility="Collapsed"
               ToolTip="Días personalizados"/>

      <TextBlock Text="DISPOSITIVOS" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource Muted}"/>
      <TextBox x:Name="DevicesBox" Text="1" Margin="0,6,0,12"/>

      <TextBlock Text="SESIONES SIMULTÁNEAS" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource Muted}"/>
      <TextBox x:Name="SessionsBox" Text="1" Margin="0,6,0,12"/>

      <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="12">
        <StackPanel>
          <TextBlock Text="PERMISOS" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
          <CheckBox x:Name="EditorCheck" Content="RUFUS Editor" IsChecked="True" Margin="0,0,0,8"/>
          <CheckBox x:Name="AiCheck" Content="Asistente IA" IsChecked="True"/>
        </StackPanel>
      </Border>

      <TextBlock Text="LÍMITES IA (opcional)" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource Muted}"/>
      <TextBlock Text="Vacío = sin límite" Style="{StaticResource MutedText}" Margin="0,2,0,6"/>
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Diario" FontSize="11" Foreground="{StaticResource Muted}"/>
          <TextBox x:Name="DailyLimitBox" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Mensual" FontSize="11" Foreground="{StaticResource Muted}"/>
          <TextBox x:Name="MonthlyLimitBox" Margin="0,4,0,0"/>
        </StackPanel>
      </Grid>

      <TextBlock Text="NOTAS" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource Muted}"/>
      <TextBox x:Name="NotesBox" Height="64" Margin="0,6,0,16" AcceptsReturn="True" TextWrapping="Wrap"/>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancelar" Width="100" Margin="0,0,8,0" IsCancel="True"
                Style="{StaticResource SecondaryButton}"/>
        <Button Content="Crear licencia" Width="140" IsDefault="True" Click="Create_Click"
                Style="{StaticResource PrimaryButton}"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
