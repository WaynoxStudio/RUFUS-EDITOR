<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>RufusAdmin</AssemblyName>
    <RootNamespace>RufusMapEditor.Admin</RootNamespace>
    <ApplicationTitle>RUFUS ADMIN</ApplicationTitle>
    <Product>RUFUS ADMIN</Product>
    <ApplicationIcon>..\RufusMapEditor.App\Assets\RME.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- reuse real Maps UI (MapsEditorView) without duplicating GFX/DB/publish -->
    <ProjectReference Include="..\RufusMapEditor.App\RufusMapEditor.App.csproj" />
  </ItemGroup>

</Project>
