<Window x:Class="RufusMapEditor.Admin.AiSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ASISTENTE IA" Height="360" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Panel}" Foreground="{StaticResource Text}">
  <StackPanel Margin="20">
    <TextBlock Text="Asistente IA" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
    <CheckBox x:Name="AiCheck" Content="Permitir Asistente IA" Margin="0,0,0,16"/>
    <TextBlock Text="Límite diario" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource Muted}"/>
    <TextBlock Text="Vacío = sin límite" Style="{StaticResource MutedText}" Margin="0,2,0,4"/>
    <TextBox x:Name="DailyBox" Margin="0,0,0,12"/>
    <TextBlock Text="Límite mensual" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource Muted}"/>
    <TextBlock Text="Vacío = sin límite" Style="{StaticResource MutedText}" Margin="0,2,0,4"/>
    <TextBox x:Name="MonthlyBox" Margin="0,0,0,20"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancelar" Width="100" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"
              Style="{StaticResource SecondaryButton}"/>
      <Button Content="Guardar" Width="100" Style="{StaticResource PrimaryButton}"
              IsDefault="True" Click="Save_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
