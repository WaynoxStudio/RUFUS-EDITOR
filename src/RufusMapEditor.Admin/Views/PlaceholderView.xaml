<UserControl x:Class="RufusMapEditor.Admin.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Border Style="{StaticResource Card}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            Margin="0" Padding="40">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
        <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}"
                   HorizontalAlignment="Center" TextAlignment="Center"/>
        <TextBlock x:Name="BodyText" Style="{StaticResource MutedText}" FontSize="14"
                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"
                   LineHeight="22"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
