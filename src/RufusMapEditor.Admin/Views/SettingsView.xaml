<UserControl x:Class="RufusMapEditor.Admin.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Foreground="{StaticResource Text}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
      <TextBlock Text="Ajustes" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="Apariencia y conexión al backend RUFUS"
                 Style="{StaticResource SectionCaption}"/>

      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="APARIENCIA" FontWeight="SemiBold" FontSize="12"
                       Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
            <TextBlock Text="Modo claro u oscuro para toda la interfaz del admin."
                       Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
            <TextBlock Text="Claro" VerticalAlignment="Center" Margin="0,0,10,0"
                       Foreground="{StaticResource Muted}"/>
            <ToggleButton x:Name="ThemeToggle" Style="{StaticResource ThemeSunMoonToggle}"
                          Checked="ThemeToggle_Changed" Unchecked="ThemeToggle_Changed"/>
            <TextBlock Text="Oscuro" VerticalAlignment="Center" Margin="10,0,0,0"
                       Foreground="{StaticResource Muted}"/>
          </StackPanel>
        </Grid>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="CLIENTE DOFUS RETRO / PREVIEWS" FontWeight="SemiBold" FontSize="12"
                     Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
          <TextBlock Text="Carpeta del cliente / Clips DOFUS Retro"
                     FontWeight="SemiBold" Margin="0,0,0,6"/>
          <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"
                     Text="Ruta a …/retroclient/clips (debe existir sprites\sprites.xml). Compartida con RUFUS Map Editor."/>
          <DockPanel Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Buscar…" Style="{StaticResource SecondaryButton}"
                    Padding="10,4" Margin="8,0,0,0" Click="BrowseClips_Click"/>
            <TextBox x:Name="ClipsRootBox" Padding="6,4"/>
          </DockPanel>
          <TextBlock x:Name="ClipsStatusText" Style="{StaticResource MutedText}" Margin="0,0,0,10"
                     TextWrapping="Wrap"/>
          <TextBlock x:Name="PreviewLibraryText" Style="{StaticResource MutedText}" Margin="0,0,0,10"
                     TextWrapping="Wrap"/>
          <WrapPanel Margin="0,0,0,10">
            <Button Content="Guardar carpeta clips" Style="{StaticResource PrimaryButton}"
                    Margin="0,0,8,0" Click="SaveClips_Click"/>
            <Button Content="Limpiar caché de previews" Style="{StaticResource SecondaryButton}"
                    Click="ClearPreviewCache_Click"/>
          </WrapPanel>
        </StackPanel>
      </Border>

      <TextBlock Text="Conexión al backend"
                 Style="{StaticResource SectionCaption}" Margin="0,0,0,20"/>

      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="BACKEND" FontWeight="SemiBold" FontSize="12"
                     Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="120"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Estado:" Foreground="{StaticResource Muted}"/>
            <TextBlock x:Name="StateText" Grid.Column="1" FontWeight="SemiBold"/>
          </Grid>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="120"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Servidor:" Foreground="{StaticResource Muted}"/>
            <TextBlock x:Name="HostText" Grid.Column="1"/>
          </Grid>
          <TextBlock x:Name="StatusMsgText" Style="{StaticResource MutedText}" Margin="0,4,0,0"
                     TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="URL del backend" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBox x:Name="BaseUrlBox" Margin="0,0,0,16"/>

          <TextBlock Text="Credencial ADMIN" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock x:Name="SecretHintText" Style="{StaticResource MutedText}" Margin="0,0,0,8"
                     Text="Credencial guardada (DPAPI). No se muestra en texto plano."/>
          <PasswordBox x:Name="SecretBox" Margin="0,0,0,8" Visibility="Collapsed"/>
          <WrapPanel Margin="0,8,0,0">
            <Button Content="Reconectar" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"
                    Click="Reconnect_Click"/>
            <Button x:Name="ChangeCredentialButton" Content="Cambiar credencial"
                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                    Click="ChangeCredential_Click"/>
          </WrapPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
