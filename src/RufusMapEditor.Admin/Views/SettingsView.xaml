<UserControl x:Class="RufusMapEditor.Admin.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Foreground="{DynamicResource Text}"
             SizeChanged="SettingsRoot_SizeChanged">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="0,0,8,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="0,0,0,12">
        <TextBlock Text="Ajustes" Style="{StaticResource SectionTitle}"/>
        <TextBlock Text="Backend, previews y conexión"
                   Style="{StaticResource SectionCaption}" Margin="0"/>
      </StackPanel>

      <!-- Configuración compacta -->
      <Grid x:Name="ConfigGrid" Grid.Row="1" Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="240"/>
          <ColumnDefinition x:Name="ConfigSpacerColumn" Width="12"/>
          <ColumnDefinition Width="*" MinWidth="280"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="BackendCard" Grid.Row="0" Grid.Column="0"
                Style="{StaticResource Card}" Padding="10" VerticalAlignment="Top">
          <StackPanel>
            <TextBlock Text="ESTADO DEL BACKEND" FontWeight="SemiBold" FontSize="11"
                       Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Estado:" FontSize="11" Foreground="{DynamicResource Muted}"/>
              <TextBlock x:Name="StateText" Grid.Column="1" FontSize="11" FontWeight="SemiBold"/>
            </Grid>
            <Grid Margin="0,0,0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Servidor:" FontSize="11" Foreground="{DynamicResource Muted}"/>
              <TextBlock x:Name="HostText" Grid.Column="1" FontSize="11" TextTrimming="CharacterEllipsis"/>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Detalle:" FontSize="11" Foreground="{DynamicResource Muted}"/>
              <TextBlock x:Name="StatusMsgText" Grid.Column="1" FontSize="11" TextTrimming="CharacterEllipsis"/>
            </Grid>
          </StackPanel>
        </Border>

        <Border x:Name="PreviewsCard" Grid.Row="0" Grid.Column="2"
                Style="{StaticResource Card}" Padding="10" VerticalAlignment="Top">
          <StackPanel>
            <TextBlock Text="PREVIEWS / CLIPS" FontWeight="SemiBold" FontSize="11"
                       Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="ClipsRootBox" Padding="5,3" FontSize="11"/>
              <Button Grid.Column="1" Content="Buscar…" Style="{StaticResource SecondaryButton}"
                      Padding="8,3" Margin="6,0,0,0" FontSize="11" Click="BrowseClips_Click"/>
            </Grid>
            <TextBlock x:Name="ClipsStatusText" Style="{StaticResource MutedText}" FontSize="10"
                       TextWrapping="Wrap" Margin="0,0,0,6"/>
            <Expander Header="Rutas de caché" IsExpanded="False" FontSize="11" Margin="0,0,0,6">
              <StackPanel Margin="0,4,0,0">
                <TextBlock x:Name="PreviewLibraryText" FontSize="10" Foreground="{DynamicResource Muted}"
                           TextWrapping="Wrap" Margin="0,0,0,2"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <TextBlock x:Name="PreviewSpriteCacheText" FontSize="10" Foreground="{DynamicResource Muted}"
                           TextWrapping="Wrap" Margin="0,0,0,2"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <TextBlock x:Name="PreviewArtworkCacheText" FontSize="10" Foreground="{DynamicResource Muted}"
                           TextWrapping="Wrap"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
              </StackPanel>
            </Expander>
            <WrapPanel>
              <Button Content="Guardar" Style="{StaticResource PrimaryButton}"
                      Margin="0,0,6,0" Padding="8,3" FontSize="11" Click="SaveClips_Click"/>
              <Button Content="Limpiar caché" Style="{StaticResource SecondaryButton}"
                      Padding="8,3" FontSize="11" Click="ClearPreviewCache_Click"/>
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border x:Name="ConnectionCard" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                Style="{StaticResource Card}" Padding="10" Margin="0,12,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MinWidth="200"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*" MinWidth="200"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
              <TextBlock Text="CONEXIÓN AL BACKEND" FontWeight="SemiBold" FontSize="11"
                         Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/>
              <TextBlock Text="URL" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,2"/>
              <TextBox x:Name="BaseUrlBox" Padding="5,3" FontSize="11"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Margin="0,17,0,0">
              <TextBlock Text="Credencial" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,2"/>
              <TextBlock x:Name="SecretHintText" Style="{StaticResource MutedText}" FontSize="10"
                         Margin="0,0,0,4" TextWrapping="Wrap"
                         Text="Credencial guardada (DPAPI)."/>
              <PasswordBox x:Name="SecretBox" Padding="5,3" Visibility="Collapsed"/>
            </StackPanel>

            <WrapPanel Grid.Column="3" VerticalAlignment="Bottom" Margin="12,0,0,0">
              <Button Content="Reconectar" Style="{StaticResource PrimaryButton}"
                      Margin="0,0,6,0" Padding="8,3" FontSize="11" Click="Reconnect_Click"/>
              <Button x:Name="ChangeCredentialButton" Content="Cambiar credencial"
                      Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11"
                      Click="ChangeCredential_Click"/>
            </WrapPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
