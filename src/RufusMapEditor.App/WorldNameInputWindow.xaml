<Window x:Class="RufusMapEditor.App.WorldNameInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nombre del mundo"
        Width="420" Height="200"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,10"/>
    <TextBlock Grid.Row="1" Text="Nombre del proyecto" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
    <TextBox x:Name="NameBox" Grid.Row="2"/>
    <TextBlock Grid.Row="3" x:Name="HintText" TextWrapping="Wrap" FontSize="11"
               Foreground="{DynamicResource TextMuted}" VerticalAlignment="Bottom" Margin="0,8,0,8"/>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancelar" Width="90" Margin="0,0,8,0" Padding="8,4" IsCancel="True" Click="Cancel_Click"/>
      <Button Content="Guardar" Width="90" Padding="8,4" IsDefault="True" Click="Ok_Click"/>
    </StackPanel>
  </Grid>
</Window>
