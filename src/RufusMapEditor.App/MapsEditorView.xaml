                                              Margin="0,0,12,0" VerticalAlignment="Center"
                                              FontSize="12"
                                              ToolTip="Marca varios para ESTE ÍTEM en todos. Desmarcar quita el borde y la selección GFX de ese mapa."/>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </StackPanel>
                          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Guardar seleccionado" Command="{Binding SaveSelectedCombinedMapCommand}"
                                    Padding="8,4" Margin="0,0,6,0"
                                    Style="{StaticResource PrimaryButton}"
                                    ToolTip="Guarda solo el mapa marcado (necesita exactamente 1 mapa arriba)"/>
                            <Button Content="Guardar todos" Command="{Binding SaveAllCombinedMapsCommand}"
                                    Padding="8,4" Margin="0,0,6,0"
                                    ToolTip="Guarda todos los mapas abiertos con cambios (*)"/>
                            <Button Content="+" Width="28" Height="26" Padding="0" Margin="0,0,6,0"
                                    FontWeight="SemiBold" FontSize="14"
                                    Command="{Binding AddCombinedMapsToPublishQueueCommand}"
                                    ToolTip="Añadir todos los mapas del combinado a la cola de publicación"/>
                            <Button Content="Enviar a MUNDO" Command="{Binding SendCombinedToWorldCommand}"
                                    Padding="8,4" Margin="0,0,8,0"
                                    ToolTip="Pide tamaño de cuadrícula (como Nuevo mundo) y abre MUNDO"/>
                            <Button Content="—" Style="{StaticResource WindowChromeButton}"
                                    Command="{Binding MinimizeCombinedMapsCommand}"
                                    ToolTip="Minimizar · queda en la barra inferior"/>
                            <Button Content="✕" Style="{StaticResource WindowChromeCloseButton}"
                                    Command="{Binding ExitMapCombinedModeCommand}"
                                    ToolTip="Cerrar combinado"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                      <controls:WorldViewport x:Name="MapCombinedViewport"
                                              DataContext="{Binding CombinedMaps}"
                                              IsCombinedMapsSurface="True"/>
                    </DockPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,16,16" Padding="8,6" Panel.ZIndex="100"
                            Background="{DynamicResource PanelCardBackground}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            CornerRadius="8">
                      <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource PanelCard}">
                          <Setter Property="Visibility" Value="Visible"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding MapDbOverlayCollapsed}" Value="True">
                              <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox Text="{Binding LoadMapFromDatabaseIdText, UpdateSourceTrigger=PropertyChanged}"
