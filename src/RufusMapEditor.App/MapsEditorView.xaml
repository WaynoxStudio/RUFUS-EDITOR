            </DockPanel>
            <!-- Search floats over the list so no full-width brown footer strip remains. -->
            <Grid Margin="0,0,0,2">
            <ListBox x:Name="MapList" ItemsSource="{Binding MapListItems}"
                   SelectedValuePath="MapId" SelectedValue="{Binding SelectedMapId}"
                   Background="Transparent" BorderThickness="0" Margin="1,0,0,32"
                   Padding="0"
                   Foreground="{DynamicResource TextPrimary}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Visible"
                   ScrollViewer.CanContentScroll="False"
                   VirtualizingPanel.IsVirtualizing="False"
                   SizeChanged="MapList_SizeChanged"
                   PreviewMouseLeftButtonDown="MapList_PreviewMouseLeftButtonDown"
                   PreviewMouseMove="MapList_PreviewMouseMove"
                   PreviewMouseLeftButtonUp="MapList_PreviewMouseLeftButtonUp"
                   PreviewMouseRightButtonDown="MapList_PreviewMouseRightButtonDown"
                   MouseDoubleClick="MapList_OnMouseDoubleClick" SelectionChanged="MapList_OnSelectionChanged">
            <ListBox.ContextMenu>
              <ContextMenu Opened="MapListContextMenu_Opened">
                <MenuItem Header="Eliminar…" Click="DeleteLibraryMap_Click"
                          Foreground="#FFFF5252" FontWeight="SemiBold"/>
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.Resources>
              <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="16"/>
                <Setter Property="MinWidth" Value="16"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                      <Border x:Name="Rail" Background="{DynamicResource SurfaceBackground}"
                              BorderBrush="{DynamicResource Border}" BorderThickness="1"
                              CornerRadius="6" Margin="0,2,1,2" SnapsToDevicePixels="True">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                          <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/>
                          </Track.DecreaseRepeatButton>
                          <Track.Thumb>
                            <Thumb Cursor="SizeNS">
                              <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                  <Border x:Name="ThumbBd" Background="{DynamicResource HoverBackground}"
                                          BorderBrush="{DynamicResource BrandAccent}" BorderThickness="1"
                                          CornerRadius="5" Margin="1" ClipToBounds="True">
                                    <Viewbox Width="8" Height="12" Stretch="Uniform"
                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                                      <StackPanel>
                                        <Border Width="8" Height="2" CornerRadius="1" Background="{DynamicResource BrandAccent}" Margin="0,1"/>
                                        <Border Width="8" Height="2" CornerRadius="1" Background="{DynamicResource BrandAccent}" Margin="0,1"/>
                                        <Border Width="8" Height="2" CornerRadius="1" Background="{DynamicResource BrandAccent}" Margin="0,1"/>
                                      </StackPanel>
                                    </Viewbox>
                                  </Border>
                                  <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                      <Setter TargetName="ThumbBd" Property="Background" Value="{DynamicResource SelectionBackground}"/>
                                    </Trigger>
                                    <Trigger Property="IsDragging" Value="True">
                                      <Setter TargetName="ThumbBd" Property="Background" Value="{DynamicResource AccentPressed}"/>
                                    </Trigger>
                                  </ControlTemplate.Triggers>
                                </ControlTemplate>
                              </Thumb.Template>
                            </Thumb>
                          </Track.Thumb>
                          <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/>
                          </Track.IncreaseRepeatButton>
                        </Track>
                      </Border>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.Resources>
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemWidth="148" ItemHeight="102"/>
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="ItemBd" Background="{TemplateBinding Background}"
                              CornerRadius="5" Padding="0" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Stretch"/>
                      </Border>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
                <Style.Triggers>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBackground}"/>
                    <Setter Property="Foreground" Value="{DynamicResource SelectionForeground}"/>
                  </Trigger>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                  </Trigger>
                </Style.Triggers>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Margin="1" Padding="3" Background="{DynamicResource ThumbBackground}"
                        BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4"
                        MouseEnter="MapListItem_MouseEnter" MouseLeave="MapListItem_MouseLeave"
                        Loaded="MapThumb_Loaded" SnapsToDevicePixels="True">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource CheckerA}" CornerRadius="3" ClipToBounds="True">
                      <Grid>
                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="1"
                               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="…" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMuted}" FontSize="14">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Visibility" Value="Collapsed"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                  <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Grid>
                    </Border>
                    <TextBlock Grid.Row="1" Text="{Binding MapId}" FontFamily="{StaticResource AppFontFamilyMono}" FontSize="10"
                               HorizontalAlignment="Center" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextSecondary}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
            </ListBox>
              <Border HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                      Margin="8,0,8,4" Padding="0" MaxWidth="220"
                      Background="{DynamicResource InputBackground}"
                      BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4">
                <DockPanel LastChildFill="True">
                  <Button DockPanel.Dock="Right" Content="✕" Width="26" Padding="0"
                          ToolTip="Limpiar filtro"
                          Command="{Binding ClearMapListFilterCommand}"
                          Style="{StaticResource IconButtonCompact}"/>
                  <TextBox Text="{Binding MapListSearchText, UpdateSourceTrigger=PropertyChanged}"
                           Background="Transparent" BorderThickness="0"
                           Padding="8,5" FontFamily="{StaticResource AppFontFamilyMono}" FontSize="12"
                           Foreground="{DynamicResource TextPrimary}"
                           CaretBrush="{DynamicResource Accent}"
                           VerticalContentAlignment="Center"
                           ToolTip="Filtrar por ID de mapa (ej. 31031)"/>
                </DockPanel>
              </Border>
            </Grid>
          </DockPanel>
          </Border>

          <Border x:Name="MapsPanelCollapsed" Visibility="Collapsed"
                  Background="{DynamicResource SurfaceBackground}"
                  BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0"
                  Width="22" ToolTip="Mostrar panel de mapas">
            <DockPanel LastChildFill="True" Margin="0,6,0,6">
              <Button x:Name="ExpandMapsButton" DockPanel.Dock="Top"
                      Content="▸" Width="18" Height="20" Margin="2,0"
                      Padding="0" FontSize="11"
                      HorizontalAlignment="Center"
                      Click="CollapseMaps_Click" ToolTip="Mostrar mapas"
                      Style="{StaticResource IconButtonCompact}"/>
              <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center"
                         Text="{Binding SelectedMapId, Mode=OneWay, TargetNullValue='—'}"
                         FontSize="9" FontFamily="{StaticResource AppFontFamilyMono}" Foreground="{DynamicResource TextMuted}"
                         RenderTransformOrigin="0.5,0.5">
                <TextBlock.LayoutTransform>
                  <RotateTransform Angle="-90"/>
                </TextBlock.LayoutTransform>
              </TextBlock>
            </DockPanel>
          </Border>
        </Grid>

        <GridSplitter x:Name="MapsSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                        DragCompleted="Splitter_DragCompleted"/>

        <Grid Grid.Column="2" Background="{DynamicResource WindowBackground}">
          <TabControl SelectedIndex="{Binding WorkspaceTabIndex}"
                      Background="{DynamicResource WindowBackground}" BorderThickness="0">
            <TabItem Header="MAPA">
              <DockPanel Background="{DynamicResource WindowBackground}">
                <Border x:Name="MapToolBar" DockPanel.Dock="Top"
                        Background="{DynamicResource PanelBackground}"
                        BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                        Padding="8,6">
                  <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Margin="0,0,8,0" Padding="6,4" Command="{Binding UndoCommand}"
                              IsEnabled="{Binding CanUndo}"
                              ToolTip="{Binding UndoLabel}" Style="{StaticResource IconButton}">
                        <Viewbox Width="16" Height="16">
                          <Path Data="{StaticResource IconUndoGeom}" Fill="{DynamicResource TextPrimary}"
                                Stretch="Uniform" Width="24" Height="24"/>
                        </Viewbox>
                      </Button>
                      <Button Margin="0,0,12,0" Padding="6,4" Command="{Binding RedoCommand}"
                              IsEnabled="{Binding CanRedo}"
                              ToolTip="{Binding RedoLabel}" Style="{StaticResource IconButton}">
                        <Viewbox Width="16" Height="16">
                          <Path Data="{StaticResource IconRedoGeom}" Fill="{DynamicResource TextPrimary}"
                                Stretch="Uniform" Width="24" Height="24"/>
                        </Viewbox>
                      </Button>
                      <Border Width="1" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"
                              Background="{DynamicResource Border}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button Content="Nuevo" Command="{Binding NewMapCommand}" Padding="8,4" Margin="0,0,6,0"
                            ToolTip="Nuevo mapa (elige tamaño; el Map ID se pide al guardar)"/>
                    <Button Content="Abrir…" Command="{Binding OpenMapDialogCommand}" Padding="8,4" Margin="0,0,6,0"
                            ToolTip="Abrir mapa de la biblioteca"/>
                    <Button Content="Guardar" Command="{Binding SaveCommand}" Padding="8,4" Margin="0,0,6,0"
                            ToolTip="Guardar mapa oficial (Ctrl+S) · Library\Maps\&lt;ID&gt;"/>
                    <Button Content="Guardar como…" Command="{Binding SaveAsCommand}" Padding="8,4" Margin="0,0,12,0"
                            ToolTip="Guardar con otro Map ID"/>
                    <Border Width="1" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"
                            Background="{DynamicResource Border}"/>
                    <controls:MapEditVisibilityToolbar VerticalAlignment="Center"/>
                    <Border Width="1" Height="18" Margin="12,0,12,0" VerticalAlignment="Center"
                            Background="{DynamicResource Border}"/>
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding ShowMapCombineEntryActions, Converter={StaticResource BoolToVis}}">
                      <Button Content="Combinar mapas…" Command="{Binding CombineOpenMapsCommand}"
                              Padding="8,4" Margin="0,0,6,0"
                              Style="{StaticResource PrimaryButton}"
                              ToolTip="Abre 2+ mapas y pégalos aquí en MAPA (H/V, sin huecos)"/>
                      <Button Content="Añadir al combinado" Command="{Binding AppendActiveMapToWorldCommand}"
                              Padding="8,4" Margin="0,0,6,0"
                              ToolTip="Añade el mapa activo al bloque combinado"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding ShowMapCombinedToolbarExtras, Converter={StaticResource BoolToVis}}">
                      <Button Content="Enviar a MUNDO" Command="{Binding SendCombinedToWorldCommand}"
                              Padding="8,4" Margin="0,0,6,0"
                              ToolTip="Lleva este combinado a la pestaña MUNDO"/>
                      <Button Content="Salir combinado" Command="{Binding ExitMapCombinedModeCommand}"
                              Padding="8,4"
                              ToolTip="Vuelve a ventanas separadas"/>
                    </StackPanel>
                    </StackPanel>
                  </Grid>
                </Border>
                <Grid Background="{DynamicResource CanvasBackground}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="88"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <controls:MapToolSidebarControl x:Name="MapToolSidebar" Grid.Column="0"
                                                  ToolGroupName="MapTool"
                                                  LayerGroupName="Layer"/>
                  <Border Grid.Column="1" Style="{StaticResource ViewportFrame}">
                  <Grid x:Name="MapWorkspaceHost" ClipToBounds="True"
                        Background="{DynamicResource CanvasBackground}">
                    <DockPanel>
                      <Border x:Name="MapTaskbarBar" DockPanel.Dock="Bottom"
                              Background="{DynamicResource PanelBackground}"
                              BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                              Padding="8,4" Visibility="Collapsed">
                        <StackPanel x:Name="MapTaskbarPanel" Orientation="Horizontal"/>
                      </Border>
                      <Grid SizeChanged="MapWorkspaceHost_SizeChanged">
                    <Canvas x:Name="MapWorkspaceCanvas"
                            Visibility="{Binding ShowFloatingMapWindows, Converter={StaticResource BoolToVis}}"/>
                    <DockPanel Visibility="{Binding ShowCombinedMapsViewport, Converter={StaticResource BoolToVis}}">
                      <Border DockPanel.Dock="Top"
                              Background="{DynamicResource ElevatedSurface}"
                              BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                              Padding="4,0,2,0">
                        <Grid MinHeight="28">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <Border Grid.Column="0" Width="16" Height="16" Margin="2,0,8,0"
                                  Background="{DynamicResource BrandAccent}" CornerRadius="3"
                                  VerticalAlignment="Center"/>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,4,8,4">
                            <TextBlock Text="{Binding MapCombinedModeLabel}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrandAccent}" TextWrapping="Wrap"
                                       Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="Mapas:" VerticalAlignment="Center" Margin="0,0,8,0"
                                         FontSize="11" FontWeight="SemiBold"
                                         Foreground="{DynamicResource TextSecondary}"/>
                              <Button Content="Todos" Command="{Binding SelectAllCombinedMapChipsCommand}"
                                      Padding="8,2" Margin="0,0,4,0" FontSize="11"
                                      ToolTip="Marca todos los mapas del combinado"/>
                              <Button Content="Borrar" Command="{Binding ClearCombinedMapChipsKeepFirstCommand}"
                                      Padding="8,2" Margin="0,0,4,0" FontSize="11"
                                      ToolTip="Deja solo el primer mapa de la fila marcado"/>
                              <ToggleButton Content="ID mapa" Padding="8,2" Margin="0,0,10,0" FontSize="11"
                                            IsChecked="{Binding CombinedMaps.ShowMapIds, Mode=TwoWay}"
                                            ToolTip="Muestra el ID de cada mapa encima del mosaico"/>
                              <ItemsControl ItemsSource="{Binding CombinedMapChips}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                  </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <CheckBox Content="{Binding Label}"
