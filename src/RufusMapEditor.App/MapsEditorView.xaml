                                 Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}"
                                 ToolTip="Map ID en estaticos.mapas. Solo descarga ese mapa."/>
                        <Button Content="Cargar BD" Padding="10,5" Margin="0,0,6,0" VerticalAlignment="Center"
                                Command="{Binding LoadMapFromDatabaseCommand}"
                                ToolTip="Lee mapData de estaticos.mapas, crea Library\Maps\{id}\ y abre el mapa."/>
                        <Button Content="Actualizar Map ID" Padding="10,5" Margin="0,0,8,0" VerticalAlignment="Center"
                                Command="{Binding QuickUpdateMapIdToDatabaseCommand}"
                                Style="{StaticResource PrimaryButton}"
                                ToolTip="UPDATE rápido en estaticos.mapas: mapData + bgID + X/Y + fecha(+1). Solo mapas existentes. No toca ancho/alto ni posPelea."/>
                        <Rectangle Width="1" Margin="0,2,8,2"
                                   Fill="{DynamicResource Divider}"/>
                        <Button Padding="10,5" MinWidth="64" VerticalAlignment="Center"
                                Command="{Binding MapPublishQueue.OpenQueueCommand}"
                                ToolTip="{Binding MapPublishQueue.FloatingTooltip}">
                          <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                              <Setter Property="Opacity" Value="0.55"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding MapPublishQueue.HasItems}" Value="True">
                                  <Setter Property="Opacity" Value="1"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding MapPublishQueue.FloatingLabel}" FontWeight="SemiBold"/>
                            <TextBlock Text=" !" FontWeight="Bold"
                                       Visibility="{Binding MapPublishQueue.HasWarnings, Converter={StaticResource BoolToVis}}"/>
                          </StackPanel>
                        </Button>
                        <Button Content="—" Width="28" Height="28" Padding="0" Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Command="{Binding ToggleMapDbOverlayCommand}"
                                Style="{StaticResource WindowChromeButton}"
                                ToolTip="Minimizar barra · se guarda al reabrir"/>
                      </StackPanel>
                    </Border>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,12,12" Padding="6,2" MinWidth="28" MinHeight="22"
                            FontSize="11" FontWeight="SemiBold" Panel.ZIndex="100"
                            Command="{Binding ToggleMapDbOverlayCommand}"
                            ToolTip="Mostrar Cargar BD / Actualizar Map ID"
                            Visibility="{Binding MapDbOverlayCollapsed, Converter={StaticResource BoolToVis}}"
                            Content="BD"/>
                    <Border Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                      <Border Background="{DynamicResource OverlayCellIdShadow}">
                        <TextBlock Text="Cargando mapa..." Foreground="{DynamicResource TextPrimary}" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                    </Border>
                      </Grid>
                    </DockPanel>
                  </Grid>
                  </Border>
                </Grid>
              </DockPanel>
            </TabItem>
            <TabItem Header="MUNDO">
