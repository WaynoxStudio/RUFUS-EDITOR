            <DockPanel DockPanel.Dock="Top" Margin="8,8,4,6">
              <Button x:Name="CollapseMapsButton" DockPanel.Dock="Right" Content="◂" Width="26"
                      Click="CollapseMaps_Click" Margin="2,0,0,0" ToolTip="Ocultar mapas"
                      Style="{StaticResource IconButtonCompact}"/>
              <Button x:Name="LibraryFolderButton" DockPanel.Dock="Right" Content="Biblioteca"
                      Margin="0,0,2,0" Padding="4,2" MinWidth="0"
                      VerticalAlignment="Center" FontSize="11"
                      Command="{Binding SelectLibraryCommand}"
                      ToolTip="Seleccionar carpeta de biblioteca"/>
              <StackPanel x:Name="MapsHeaderTitle" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="3" Height="14" CornerRadius="1.5" Background="{DynamicResource BrandAccent}" Margin="0,0,8,0"/>
