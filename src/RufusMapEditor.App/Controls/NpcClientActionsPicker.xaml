<UserControl x:Class="RufusMapEditor.App.Controls.NpcClientActionsPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RufusMapEditor.App.ViewModels"
             MinHeight="28">
  <Grid>
    <ToggleButton x:Name="DropToggle"
                  HorizontalContentAlignment="Stretch"
                  VerticalContentAlignment="Center"
                  Padding="8,4"
                  MinHeight="28"
                  Background="{DynamicResource InputBackground}"
                  BorderBrush="{DynamicResource InputBorder}"
                  BorderThickness="1"
                  Foreground="{DynamicResource TextPrimary}"
                  FontSize="{DynamicResource FontSizeNormal}"
                  ToolTip="Acciones de menú del cliente (npc_es N.a). Varias acciones → a:[ids] ordenados.">
      <ToggleButton.Template>
        <ControlTemplate TargetType="ToggleButton">
          <Grid x:Name="Root">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    SnapsToDevicePixels="True"/>
            <Grid Margin="{TemplateBinding Padding}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0"
                         Text="{Binding DisplayText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center"
                         Foreground="{TemplateBinding Foreground}"/>
              <Border Grid.Column="1" Width="22" Height="22" Margin="4,0,0,0"
                      HorizontalAlignment="Right" VerticalAlignment="Center">
                <Path Data="M 0,0 L 4,4 L 8,0"
                      Stroke="{DynamicResource TextSecondary}"
                      StrokeThickness="1.5"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
              </Border>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandAccentHover}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandAccent}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandAccent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource TextDisabled}"/>
              <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </ToggleButton.Template>
    </ToggleButton>

    <Popup Placement="Bottom"
           PlacementTarget="{Binding ElementName=DropToggle}"
           IsOpen="{Binding IsChecked, ElementName=DropToggle}"
           StaysOpen="False"
           AllowsTransparency="True"
           PopupAnimation="Slide">
      <Border MinWidth="{Binding ActualWidth, ElementName=DropToggle}"
              MaxWidth="320"
              BorderBrush="{DynamicResource InputBorder}"
              BorderThickness="1"
              CornerRadius="6"
              Margin="0,2,0,0"
              Background="{DynamicResource ElevatedSurface}"
              Padding="6">
        <StackPanel>
          <ItemsControl ItemsSource="{Binding Actions, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:NpcClientActionItemViewModel}">
                <CheckBox Margin="2,3"
                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                          IsEnabled="{Binding CanToggle}"
                          Content="{Binding Label}"
                          Foreground="{DynamicResource TextPrimary}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Margin="4,6,4,2" FontSize="10"
                     Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                     Text="Hablar se activa automáticamente si hay diálogo."/>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>
