<UserControl x:Class="RufusMapEditor.App.Controls.FloatingMapWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RufusMapEditor.App.Controls"
             MinWidth="320" MinHeight="200"
             SnapsToDevicePixels="True">
  <UserControl.Resources>
    <DropShadowEffect x:Key="MapWindowShadow" BlurRadius="12" ShadowDepth="2" Opacity="0.45" Color="#000000"/>
  </UserControl.Resources>
  <Border x:Name="ChromeBorder"
          Background="{DynamicResource PanelBackground}"
          BorderBrush="{DynamicResource Border}" BorderThickness="1"
          Effect="{StaticResource MapWindowShadow}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border x:Name="TitleBar" Grid.Row="0"
              Background="{DynamicResource ElevatedSurface}"
              BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
              Cursor="SizeAll"
              PreviewMouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid Height="28" Margin="4,0,2,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Width="16" Height="16" Margin="2,0,6,0"
                  Background="{DynamicResource BrandAccent}" CornerRadius="3"
                  VerticalAlignment="Center"/>
          <TextBlock x:Name="TitleText" Grid.Column="1" Text="Map"
                     VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button x:Name="QueueAddButton" Content="+" Width="28" Height="22" Margin="0,0,4,0"
                    FontWeight="SemiBold" FontSize="13" Padding="0"
                    Click="QueueAdd_Click"
                    ToolTip="Añadir mapa a la cola de publicación"
                    Style="{StaticResource WindowChromeButton}"/>
            <Button x:Name="MinimizeButton" Content="—" Style="{StaticResource WindowChromeButton}"
                    Click="Minimize_Click" ToolTip="Minimizar"/>
            <Button x:Name="MaximizeButton" Content="□" Style="{StaticResource WindowChromeButton}"
                    Click="Maximize_Click" ToolTip="Maximizar"/>
            <Button Content="✕" Style="{StaticResource WindowChromeCloseButton}"
                    Click="Close_Click" ToolTip="Cerrar mapa"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid x:Name="ContentHost" Grid.Row="1" MinHeight="160" ClipToBounds="True">
        <controls:MapViewport x:Name="MapViewportControl"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"/>
        <Thumb x:Name="ResizeGrip" Width="16" Height="16"
               HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Margin="0,0,1,1" Cursor="SizeNWSE"
               DragStarted="ResizeGrip_DragStarted"
               DragDelta="ResizeGrip_DragDelta"
               DragCompleted="ResizeGrip_DragCompleted"
               Template="{StaticResource ResizeGripTemplate}"/>
      </Grid>
    </Grid>
  </Border>
</UserControl>
