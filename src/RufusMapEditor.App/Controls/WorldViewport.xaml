<UserControl x:Class="RufusMapEditor.App.Controls.WorldViewport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource CanvasBackground}"
             ClipToBounds="True"
             MouseWheel="Viewport_MouseWheel"
             MouseDown="Viewport_MouseDown"
             MouseUp="Viewport_MouseUp"
             MouseMove="Viewport_MouseMove"
             MouseLeave="Viewport_MouseLeave"
             KeyDown="Viewport_KeyDown"
             KeyUp="Viewport_KeyUp">
  <Grid>
    <Canvas x:Name="WorldRoot">
      <Canvas.RenderTransform>
        <TransformGroup>
          <ScaleTransform x:Name="WorldScale" ScaleX="1" ScaleY="1"/>
          <TranslateTransform x:Name="WorldTranslate"/>
        </TransformGroup>
      </Canvas.RenderTransform>
      <Canvas x:Name="ContentCanvas"/>
      <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False"/>
    </Canvas>
    <Canvas x:Name="GridChromeCanvas" IsHitTestVisible="True"/>
    <TextBlock Text="Crea o abre un mundo (Archivo → Mundo)"
               Foreground="{DynamicResource TextMuted}"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               FontSize="14"
               IsHitTestVisible="False">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding World}" Value="{x:Null}">
              <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>
  </Grid>
</UserControl>
