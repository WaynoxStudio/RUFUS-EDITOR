<UserControl x:Class="RufusMapEditor.App.Controls.ContentDialogEditorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RufusMapEditor.App.ViewModels"
             xmlns:ctrl="clr-namespace:RufusMapEditor.App.Controls">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="ConversationBubble" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Cursor" Value="SizeAll"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Bubble_DragPreviewMouseDown"/>
      <EventSetter Event="SizeChanged" Handler="Bubble_SizeChanged"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter Property="Background" Value="{DynamicResource ElevatedSurface}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
          <Setter Property="BorderThickness" Value="3"/>
          <Setter Property="Effect">
            <Setter.Value>
              <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.55" Color="#F39C12"/>
            </Setter.Value>
          </Setter>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ConversationBubbleSelected" TargetType="Border" BasedOn="{StaticResource ConversationBubble}">
      <Setter Property="Background" Value="{DynamicResource ElevatedSurface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="BorderThickness" Value="3"/>
      <Setter Property="Cursor" Value="Arrow"/>
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.55" Color="#F39C12"/>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ActionChip" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource DialogHeaderBackground}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Margin" Value="8,4,8,4"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="TextElement.Foreground" Value="{DynamicResource HeaderForeground}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter Property="Background" Value="{DynamicResource Accent}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource AccentPressed}"/>
          <Setter Property="TextElement.Foreground" Value="{DynamicResource HeaderForeground}"/>
          <Setter Property="Effect">
            <Setter.Value>
              <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.5" Color="#F39C12"/>
            </Setter.Value>
          </Setter>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ResponseActionHeaderChip" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource DialogHeaderBackground}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8,3"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="4,0,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource HeaderForeground}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{DynamicResource AccentPressed}"
                    BorderThickness="2"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentPressed}"/>
                <Setter Property="Foreground" Value="{DynamicResource HeaderForeground}"/>
              </DataTrigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PanelBrownHeader" TargetType="Border" BasedOn="{StaticResource BrownHeaderBar}">
      <Setter Property="CornerRadius" Value="4,4,0,0"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="TextElement.Foreground" Value="{DynamicResource HeaderForeground}"/>
    </Style>
    <Style x:Key="WorkspaceColumnTitle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="BubbleAiButton" TargetType="Button">
      <Setter Property="Width" Value="26"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="ToolTip" Value="Generar con IA"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="2">
              <TextBlock Text="&#10024;" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{DynamicResource BrandAccent}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DialogHeaderBackground}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BubbleBodyTextBox" TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource InputForeground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="MinHeight" Value="56"/>
      <Setter Property="AcceptsReturn" Value="True"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBackground}"/>
      <Setter Property="ToolTip" Value="Escribe el texto aquí"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    SnapsToDevicePixels="True">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Top"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandAccentHover}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandAccent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="QuestionCanvasBubbleTemplate">
      <Grid x:Name="BubbleRoot">
        <Grid.RenderTransform>
          <TranslateTransform X="{Binding LayoutX}" Y="{Binding LayoutY}"/>
        </Grid.RenderTransform>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="72"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Width="58" Height="58" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,14,0,0">
          <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding QuestionAvatarScale}" ScaleY="{Binding QuestionAvatarScale}"/>
          </Grid.LayoutTransform>
          <Border Width="58" Height="58" Background="{DynamicResource PanelBackground}">
            <Border.Clip>
              <EllipseGeometry Center="29,29" RadiusX="29" RadiusY="29"/>
            </Border.Clip>
            <ctrl:LazyArtworkImage GfxId="{Binding DataContext.SelectedNpcGfxId, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    UseNpcSpritePreview="False" Width="58" Height="58" BorderThickness="0"
                                    Background="Transparent" IsHitTestVisible="False"/>
          </Border>
          <Ellipse Stroke="{DynamicResource Accent}" StrokeThickness="2.5" Fill="Transparent" IsHitTestVisible="False"/>
        </Grid>
        <Grid Grid.Column="1">
          <Polygon Points="0,16 14,26 14,8" Fill="{DynamicResource PanelBackground}"
                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-12,16,0,0" IsHitTestVisible="False"/>
          <Border Style="{StaticResource ConversationBubble}"
                  MinWidth="{Binding QuestionBubbleMinWidth}" MaxWidth="{Binding QuestionBubbleMaxWidth}"
                  Padding="{Binding QuestionBubblePadding}" MouseLeftButtonDown="Bubble_MouseLeftButtonDown">
            <StackPanel>
              <DockPanel Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Style="{StaticResource BubbleAiButton}" Click="BubbleAi_Click"/>
                <Button DockPanel.Dock="Right" Content="✕" ToolTip="Eliminar pregunta" Padding="6,2" Margin="4,0,0,0"
                        FontSize="11" FontWeight="Bold" Style="{StaticResource DeleteButton}"
                        Visibility="{Binding ShowDeleteButton, Converter={StaticResource BoolToVis}}"
                        Click="DeleteQuestionBubble_Click"/>
                <Border DockPanel.Dock="Right" Background="{DynamicResource Accent}" CornerRadius="10" Padding="8,2"
                        Margin="8,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding HasMissionRoleTag, Converter={StaticResource BoolToVis}}">
                  <TextBlock Text="{Binding MissionRoleTag}" FontSize="10" FontWeight="SemiBold"
                             Foreground="{DynamicResource HeaderForeground}"/>
                </Border>
                <Border DockPanel.Dock="Right" Background="{DynamicResource Accent}" CornerRadius="10" Padding="8,2"
                        Margin="8,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding ShowKindTagBadge, Converter={StaticResource BoolToVis}}">
                  <TextBlock Text="{Binding KindTag}" FontSize="10" FontWeight="SemiBold"
                             Foreground="{DynamicResource HeaderForeground}"/>
                </Border>
                <TextBlock Text="{Binding HeaderTitle}" FontSize="{Binding QuestionHeaderFontSize}" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              </DockPanel>
              <TextBox Style="{StaticResource BubbleBodyTextBox}" Text="{Binding Question.TextLocal, UpdateSourceTrigger=PropertyChanged}"
                       TextChanged="BubbleText_TextChanged" ToolTip="Texto del NPC"/>
              <Button Content="+ Añadir respuesta" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="10,4" FontSize="11"
                      Style="{StaticResource SecondaryButton}" Click="AddResponseOnBubble_Click"/>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ResponseCanvasBubbleTemplate">
      <Grid x:Name="BubbleRoot">
        <Grid.RenderTransform>
          <TranslateTransform X="{Binding LayoutX}" Y="{Binding LayoutY}"/>
        </Grid.RenderTransform>
        <Polygon Points="14,16 0,26 0,8" Fill="{DynamicResource PanelBackground}"
                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-12,16,0,0" IsHitTestVisible="False"/>
        <Border Style="{StaticResource ConversationBubble}" MinWidth="280" MaxWidth="380" HorizontalAlignment="Left" Padding="0"
                MouseLeftButtonDown="Bubble_MouseLeftButtonDown">
          <StackPanel>
            <StackPanel Margin="14,11,14,10">
              <DockPanel Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Style="{StaticResource BubbleAiButton}" Click="BubbleAi_Click"/>
                <Button DockPanel.Dock="Right" Content="✕" ToolTip="Eliminar respuesta" Padding="6,2" Margin="4,0,0,0"
                        FontSize="11" FontWeight="Bold" Style="{StaticResource DeleteButton}"
                        Visibility="{Binding ShowDeleteButton, Converter={StaticResource BoolToVis}}"
                        Click="DeleteResponseBubble_Click"/>
                <Border DockPanel.Dock="Right" Background="#FFA2C3DA" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="Respuesta" FontSize="10" FontWeight="SemiBold" Foreground="#FF2C3E50"/>
                </Border>
                <TextBlock Text="{Binding HeaderTitle}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
              </DockPanel>
              <TextBox Style="{StaticResource BubbleBodyTextBox}" Text="{Binding Response.TextLocal, UpdateSourceTrigger=PropertyChanged}"
                       TextChanged="BubbleText_TextChanged" ToolTip="Texto del jugador"/>
              <Border Margin="0,8,0,0" Padding="8,6" CornerRadius="6" Background="#FFF8E8E8" BorderBrush="#C0392B" BorderThickness="1"
                      Visibility="{Binding HasActionConflict, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ActionConflictWarning}" TextWrapping="Wrap" FontSize="11" Foreground="#C0392B"/>
              </Border>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Children}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:DialogTreeNodeVm}">
                  <Border Style="{StaticResource ActionChip}" PreviewMouseLeftButtonDown="ActionChip_PreviewMouseLeftButtonDown">
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="✕" ToolTip="Eliminar esta acción" Padding="8,2" Margin="8,0,0,0"
                              FontSize="11" FontWeight="Bold" Style="{StaticResource DeleteButton}" Click="DeleteActionChip_Click"/>
                      <TextBlock Text="{Binding ActionLine}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Expander Margin="8,0,8,8" Padding="0,0,0,4"
                      Visibility="{Binding ShowsInlineCondition, Converter={StaticResource BoolToVis}}"
                      IsExpanded="{Binding DataContext.ActionConditionEditorOpen, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                      Header="{Binding DataContext.InlineConditionExpanderHeader, RelativeSource={RelativeSource AncestorType=UserControl}}">
              <StackPanel Margin="8,6,8,4">
                <TextBox Text="{Binding DataContext.ActionConditionText, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="Field_TextChanged" AcceptsReturn="True" MinHeight="48"
                         TextWrapping="Wrap" FontFamily="Consolas" Margin="0,0,0,6"/>
                <Button Content="Quitar condición"
                        Command="{Binding DataContext.ClearActionConditionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Style="{StaticResource DeleteButton}" Padding="8,4" HorizontalAlignment="Left"/>
              </StackPanel>
            </Expander>
            <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="10,7">
              <WrapPanel>
                <Button Content="+ Añadir acción" Padding="10,4" FontSize="11" Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButton}" Click="AddActionOnBubble_Click">
                  <Button.ContextMenu>
                    <ContextMenu MinWidth="230" Padding="6,6">
                      <ContextMenu.Resources>
                        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
                      </ContextMenu.Resources>
                      <MenuItem Header="Ir a otra pregunta" Command="{Binding Tag.AddGotoActionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                Visibility="{Binding ShowAddGotoActionMenu, Converter={StaticResource BoolToVis}}"/>
                      <MenuItem Header="Teletransporte" Command="{Binding Tag.AddTeleportActionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                Visibility="{Binding ShowAddTeleportActionMenu, Converter={StaticResource BoolToVis}}"/>
                      <MenuItem Header="Iniciar misión" Command="{Binding Tag.AddQuestActionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                Visibility="{Binding ShowAddQuestActionMenu, Converter={StaticResource BoolToVis}}"/>
                      <MenuItem Header="Confirmar objetivo" Command="{Binding Tag.AddConfirmObjectiveActionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                Visibility="{Binding ShowAddConfirmObjectiveActionMenu, Converter={StaticResource BoolToVis}}"/>
                      <MenuItem Header="Confirmar misión" Command="{Binding Tag.AddConfirmMissionActionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                Visibility="{Binding ShowAddConfirmMissionActionMenu, Converter={StaticResource BoolToVis}}"/>
                      <Separator/>
                      <MenuItem Header="Acción avanzada" Command="{Binding Tag.AddAdvancedActionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                  </Button.ContextMenu>
                </Button>
              </WrapPanel>
            </Border>
          </StackPanel>
        </Border>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <!-- MODO A �?" DIÁLOGO SIMPLE (mismo bocadillo + propiedades que conversación) -->
    <Grid Visibility="{Binding IsSimpleMode, Converter={StaticResource BoolToVis}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="Auto" MinWidth="260" MaxWidth="320"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{DynamicResource PanelBackground}"
              BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4" Padding="0">
        <DockPanel>
          <Border DockPanel.Dock="Top" Style="{StaticResource PanelBrownHeader}">
            <DockPanel>
              <Button DockPanel.Dock="Right"
                      Content="Cambiar a conversación"
                      Padding="10,4" FontSize="11"
                      Style="{StaticResource SecondaryButton}"
                      Click="SwitchToInteractiveDialog_Click"
                      ToolTip="Preguntas y respuestas con acciones"/>
              <TextBlock Text="Diálogo simple" Style="{StaticResource BrownHeaderText}"
                         VerticalAlignment="Center"/>
            </DockPanel>
          </Border>

          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        Background="{DynamicResource ElevatedSurface}">
            <StackPanel Margin="16,12,16,16" HorizontalAlignment="Stretch" MinWidth="300">
              <StackPanel HorizontalAlignment="Center" Margin="0,0,0,16">
                <Border Background="{DynamicResource DialogHeaderBackground}" CornerRadius="14"
                        Padding="20,6" HorizontalAlignment="Center">
                  <TextBlock Text="INICIO" FontWeight="Bold" FontSize="12"
                             Foreground="{DynamicResource HeaderForeground}"/>
                </Border>
                <TextBlock Text="&#8595;" HorizontalAlignment="Center" FontSize="22"
                           Foreground="{DynamicResource Accent}" Margin="0,2,0,0"/>
              </StackPanel>

              <Grid HorizontalAlignment="Center" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="72"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="58" Height="58"
                      HorizontalAlignment="Left" VerticalAlignment="Top"
                      Margin="0,14,0,0">
                  <Border Width="58" Height="58" Background="{DynamicResource PanelBackground}">
                    <Border.Clip>
                      <EllipseGeometry Center="29,29" RadiusX="29" RadiusY="29"/>
                    </Border.Clip>
                    <ctrl:LazyArtworkImage
                        GfxId="{Binding SelectedNpcGfxId}"
                        UseNpcSpritePreview="False"
                        Width="58" Height="58"
                        BorderThickness="0"
                        Background="Transparent"
                        Cursor="Arrow"
                        IsHitTestVisible="False"/>
                  </Border>
                  <Ellipse Stroke="{DynamicResource Accent}" StrokeThickness="2.5"
                           Fill="Transparent" IsHitTestVisible="False"/>
                </Grid>

                <Grid Grid.Column="1">
                  <Polygon Points="0,16 14,26 14,8"
                           Fill="{DynamicResource ElevatedSurface}"
                           HorizontalAlignment="Left" VerticalAlignment="Top"
                           Margin="-12,16,0,0"/>

                  <Border Style="{StaticResource ConversationBubbleSelected}"
                          MinWidth="300" MaxWidth="400"
                          Padding="14,12">
                    <StackPanel>
                      <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource BubbleAiButton}"
                                Click="SimpleBubbleAi_Click"/>
                        <Border DockPanel.Dock="Right"
                                Background="{DynamicResource Accent}"
                                CornerRadius="10" Padding="8,2"
                                Margin="8,0,0,0" VerticalAlignment="Center">
                          <TextBlock Text="Diálogo" FontSize="10"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource HeaderForeground}"/>
                        </Border>
                        <TextBlock Text="{Binding SimpleBubbleHeaderTitle}"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                      </DockPanel>

                      <TextBox Style="{StaticResource BubbleBodyTextBox}"
                               Text="{Binding SimpleDialogTextLocal, UpdateSourceTrigger=PropertyChanged}"
                               TextChanged="Field_TextChanged"/>
                    </StackPanel>
                  </Border>
                </Grid>
              </Grid>

              <StackPanel HorizontalAlignment="Center" Margin="0,2,0,0">
                <TextBlock Text="&#8595;" HorizontalAlignment="Center" FontSize="22"
                           Foreground="{DynamicResource Accent}" Margin="0,0,0,2"/>
                <Border Background="{DynamicResource DialogHeaderBackground}"
                        CornerRadius="14" Padding="20,6"
                        HorizontalAlignment="Center">
                  <TextBlock Text="FIN" FontWeight="Bold" FontSize="12"
                             Foreground="{DynamicResource HeaderForeground}"/>
                </Border>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Border Grid.Column="2" Background="{DynamicResource PanelBackground}"
              BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4" Padding="0">
        <DockPanel>
          <Border DockPanel.Dock="Top" Style="{StaticResource PanelBrownHeader}">
            <TextBlock Text="PROPIEDADES DEL DIÁLOGO" Style="{StaticResource BrownHeaderText}"
                       TextTrimming="CharacterEllipsis"/>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,10">
              <Border Visibility="{Binding IsPendingDialogEs, Converter={StaticResource BoolToVis}}"
                      Background="{DynamicResource ElevatedSurface}"
                      BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                      CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                <StackPanel>
                  <TextBlock Text="{Binding SimplePendingTitle}" FontWeight="SemiBold"
                             Foreground="{DynamicResource Accent}"/>
                  <TextBlock Text="{Binding SimplePendingDetails}"
                             FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                             FontFamily="Consolas" Foreground="{DynamicResource TextSecondary}"/>
                  <TextBlock Text="Usa «Publicar cliente» en la barra de Contenido. Este NPC no se publicará en BD hasta entonces."
                             FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                             Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
              </Border>
              <Border Visibility="{Binding IsDialogEsPublished, Converter={StaticResource BoolToVis}}"
                      Background="{DynamicResource ElevatedSurface}"
                      BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                      CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                <StackPanel>
                  <TextBlock Text="&#10003; dialog_es publicado" FontWeight="SemiBold"
                             Foreground="{DynamicResource Accent}"/>
                  <TextBlock Text="{Binding SimplePublishedDetails}"
                             FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                             FontFamily="Consolas" Foreground="{DynamicResource TextSecondary}"/>
                  <TextBlock Text="&#9888; Pendiente de publicación BD"
                             FontSize="11" FontWeight="SemiBold" Margin="0,6,0,0"
                             Foreground="{DynamicResource Accent}"/>
                </StackPanel>
              </Border>

              <TextBlock Text="ID de diálogo (opcional)" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding SimpleDialogIdText, UpdateSourceTrigger=PropertyChanged}"
                       TextChanged="Field_TextChanged" Margin="0,0,0,6" FontFamily="Consolas"/>
              <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"
                         Margin="0,0,0,10"
                         Text="Opcional. Solo para reutilizar un texto ya existente. El texto nuevo no requiere ID manual: se reserva un D.q provisional."/>

              <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"
                         Margin="0,0,0,10"
                         Text="Edita el texto del NPC directamente en el bocadillo."/>
              <Expander Header="&#10024; Generar con IA"
                        IsExpanded="{Binding AiAssistant.BubbleAiPanelOpen, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                        Margin="0,0,0,10">
                <StackPanel Margin="0,8,0,0">
                  <TextBlock Text="¿Qué quieres que diga el NPC?" Style="{StaticResource FieldLabel}"/>
                  <TextBox Text="{Binding AiAssistant.BubbleInstruction, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                           AcceptsReturn="True" MinHeight="48" TextWrapping="Wrap" Margin="0,0,0,8"/>
                  <Button Content="&#10024; Generar texto"
                          Command="{Binding AiAssistant.GenerateNpcBubbleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          Padding="10,4" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                  <TextBlock Text="{Binding AiAssistant.StatusMessage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             TextWrapping="Wrap" Margin="0,0,0,8"
                             Foreground="{DynamicResource BrandAccent}"
                             Visibility="{Binding AiAssistant.HasStatusMessage, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                  <Button Content="Cargar resultado mock"
                          Command="{Binding AiAssistant.LoadMockResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,8"
                          Visibility="{Binding AiAssistant.ShowMockTools, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                  <Border Visibility="{Binding AiAssistant.ShowBubbleAiResult, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                          BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6"
                          Padding="8" Background="{DynamicResource PanelBackground}">
                    <StackPanel>
                      <TextBlock Text="RESULTADO IA" FontWeight="SemiBold" Margin="0,0,0,6"/>
                      <TextBox Text="{Binding AiAssistant.DialoguePreviewText, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                               IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="56" Margin="0,0,0,8"/>
                      <WrapPanel>
                        <Button Content="Usar texto"
                                Command="{Binding AiAssistant.UseBubbleTextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Padding="8,4" Margin="0,0,6,4"/>
                        <Button Content="Regenerar"
                                Command="{Binding AiAssistant.RegenerateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Padding="8,4" Margin="0,0,6,4"/>
                        <Button Content="Cancelar"
                                Command="{Binding AiAssistant.CancelBubbleResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Padding="8,4" Margin="0,0,6,4"/>
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Expander>
              <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"
                         Text="Tabla: npcs_modelo · Columna: pregunta. No crea npc_preguntas ni npc_respuestas."/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <!-- MODO B — CONVERSACIÓN INTERACTIVA (bocadillos) -->
    <Grid x:Name="InteractiveLayoutRoot"
          Visibility="{Binding IsInteractiveMode, Converter={StaticResource BoolToVis}}"
          Background="{DynamicResource PanelBackground}"
          SizeChanged="InteractiveLayoutRoot_SizeChanged">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="HeaderConversationColumn" Width="*"/>
          <ColumnDefinition x:Name="HeaderSplitterColumn" Width="0"/>
          <ColumnDefinition x:Name="HeaderActionColumn" Width="Auto"/>
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0" Margin="12,8,8,4">
          <Button DockPanel.Dock="Right"
                  Content="Cambiar a diálogo simple"
                  Padding="8,3" FontSize="11"
                  Style="{StaticResource SecondaryButton}"
                  Click="SwitchToSimpleDialog_Click"
                  ToolTip="Cambiar a una sola frase del NPC"/>
          <TextBlock Text="Editor visual de conversación"
                     Style="{StaticResource WorkspaceColumnTitle}"/>
        </DockPanel>
        <DockPanel Grid.Column="2" Margin="8,8,12,4"
                   Visibility="{Binding ShowRightPropertiesPanel, Converter={StaticResource BoolToVis}}">
          <ItemsControl DockPanel.Dock="Right"
                        ItemsSource="{Binding ResponseActionTabs}"
                        Visibility="{Binding ShowMultipleResponseActionTabs, Converter={StaticResource BoolToVis}}"
                        VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:ResponseActionTabVm}">
                <Button Content="{Binding Label}"
                        Style="{StaticResource ResponseActionHeaderChip}"
                        Command="{Binding DataContext.SelectResponseActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding Action}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding PropertiesPanelTitle}"
                     Style="{StaticResource WorkspaceColumnTitle}"
                     TextTrimming="CharacterEllipsis"/>
        </DockPanel>
      </Grid>

      <!-- DIALOG.AI.VISUAL_EDITOR.INTEGRATION.1 — asistente IA integrado -->
      <Border Grid.Row="1" Margin="12,0,12,8" Padding="0">
        <StackPanel DataContext="{Binding AiAssistant, RelativeSource={RelativeSource AncestorType=UserControl}}">
          <TextBlock Text="Contexto IA" FontSize="11" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
          <TextBox Text="{Binding NarrativeContext, UpdateSourceTrigger=PropertyChanged}"
                   AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" MaxHeight="88"
                   VerticalScrollBarVisibility="Auto" Margin="0,0,0,6"
                   ToolTip="Qué debe ocurrir / de qué trata esta conversación (contexto creativo para la IA)"/>
          <DockPanel Margin="0,0,0,4">
            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusMessage}" FontSize="11"
                       VerticalAlignment="Center" Foreground="{DynamicResource BrandAccent}"
                       TextTrimming="CharacterEllipsis" MaxWidth="280"
                       Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}"/>
            <Button Content="✨ Generar conversación" Command="{Binding GenerateConversationCommand}"
                    Padding="10,4" HorizontalAlignment="Left"
                    ToolTip="Genera y aplica la conversación (1 respuesta) usando el Contexto IA y el perfil del NPC"/>
          </DockPanel>

          <!-- DIALOG.AI.GENERATION.PROGRESS.1 — progreso estimado (solo Generar conversación) -->
          <StackPanel Margin="0,2,0,4"
                      Visibility="{Binding IsGenerationProgressVisible, Converter={StaticResource BoolToVis}}">
            <DockPanel Margin="0,0,0,2">
              <TextBlock DockPanel.Dock="Right"
                         Text="{Binding GenerationProgressPercentLabel}"
                         FontSize="11" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextSecondary}"
                         VerticalAlignment="Center" Margin="8,0,0,0"/>
              <ProgressBar Height="8" Minimum="0" Maximum="100"
                           Value="{Binding GenerationProgress, Mode=OneWay}"
                           VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="{Binding GenerationProgressText}"
                       FontSize="11" Foreground="{DynamicResource TextMuted}"
                       TextTrimming="CharacterEllipsis"/>
          </StackPanel>

          <Border Visibility="{Binding ShowBubbleAiResult, Converter={StaticResource BoolToVis}}"
                  BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6"
                  Padding="8" Background="{DynamicResource ElevatedSurface}" Margin="0,4,0,0">
            <StackPanel>
              <TextBlock Text="TEXTO BOCADILLO" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
              <TextBox Text="{Binding DialoguePreviewText, Mode=OneWay}" IsReadOnly="True"
                       TextWrapping="Wrap" AcceptsReturn="True" MinHeight="40" MaxHeight="72"
                       VerticalScrollBarVisibility="Auto" Margin="0,0,0,6"/>
              <WrapPanel>
                <Button Content="Usar texto" Command="{Binding UseBubbleTextCommand}"
                        Padding="8,3" Margin="0,0,6,0"/>
                <Button Content="Regenerar" Command="{Binding RegenerateCommand}"
                        Padding="8,3" Margin="0,0,6,0"/>
                <Button Content="Cancelar" Command="{Binding CancelBubbleResultCommand}" Padding="8,3"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <Border Grid.Row="2" Height="1" Background="{DynamicResource Border}"/>

      <Grid Grid.Row="3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="ConversationColumn" Width="*" MinWidth="260"/>
          <ColumnDefinition x:Name="ActionSplitterColumn" Width="0"/>
          <ColumnDefinition x:Name="ActionPanelColumn" Width="Auto" MinWidth="0"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer x:Name="ConversationScrollViewer"
                      Grid.Column="0"
                      VerticalAlignment="Top"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                      Background="{DynamicResource PanelBackground}"
                      SizeChanged="ConversationScrollViewer_SizeChanged">
            <Canvas x:Name="ConversationCanvas"
                    Width="{Binding CanvasExtentWidth}"
                    Height="{Binding CanvasExtentHeight}"
                    Margin="16,12,16,16"
                    Background="Transparent"
                    MouseLeftButtonUp="ConversationCanvas_MouseLeftButtonUp"
                    MouseMove="ConversationCanvas_MouseMove">

              <StackPanel Canvas.Left="{Binding FlowMarkerLeft}" Canvas.Top="0">
                <Border Background="{DynamicResource DialogHeaderBackground}" CornerRadius="14"
                        Padding="20,6" HorizontalAlignment="Center">
                  <TextBlock Text="INICIO" FontWeight="Bold" FontSize="12"
                             Foreground="{DynamicResource HeaderForeground}"/>
                </Border>
                <TextBlock Text="&#8595;" HorizontalAlignment="Center" FontSize="22"
                           Foreground="{DynamicResource Accent}" Margin="0,2,0,0"/>
              </StackPanel>

              <ItemsControl ItemsSource="{Binding Connectors}" IsHitTestVisible="False"
                            Width="{Binding CanvasExtentWidth}" Height="{Binding CanvasExtentHeight}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <Canvas/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Path Data="{Binding PathData}"
                          Stroke="{DynamicResource Accent}"
                          StrokeThickness="2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Fill="Transparent"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <ItemsControl ItemsSource="{Binding FlatBubbles}"
                            Width="{Binding CanvasExtentWidth}"
                            Height="{Binding CanvasExtentHeight}"
                            ClipToBounds="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <Canvas/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:DialogTreeNodeVm}">
                    <ContentControl Content="{Binding}">
                      <ContentControl.Style>
                        <Style TargetType="ContentControl">
                          <Setter Property="ContentTemplate" Value="{StaticResource ResponseCanvasBubbleTemplate}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsQuestion}" Value="True">
                              <Setter Property="ContentTemplate" Value="{StaticResource QuestionCanvasBubbleTemplate}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </ContentControl.Style>
                    </ContentControl>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Canvas.Left="{Binding FlowMarkerLeft}" Canvas.Top="{Binding FinMarkerTop}">
                <TextBlock Text="&#8595;" HorizontalAlignment="Center" FontSize="22"
                           Foreground="{DynamicResource Accent}" Margin="0,0,0,2"/>
                <Border Background="{DynamicResource DialogHeaderBackground}"
                        CornerRadius="14" Padding="20,6"
                        HorizontalAlignment="Center">
                  <TextBlock Text="FIN" FontWeight="Bold" FontSize="12"
                             Foreground="{DynamicResource HeaderForeground}"/>
                </Border>
              </StackPanel>
            </Canvas>
          </ScrollViewer>

          <GridSplitter x:Name="ActionPanelSplitter"
                        Grid.Column="1"
                        Width="6"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        ResizeBehavior="PreviousAndNext"
                        ShowsPreview="True"
                        Background="{DynamicResource Border}"
                        Visibility="Collapsed"/>

          <ScrollViewer x:Name="ActionPropsPanel"
                        Grid.Column="2"
                        VerticalAlignment="Top"
                        MaxHeight="{Binding ElementName=ConversationScrollViewer, Path=ActualHeight, Mode=OneWay}"
                        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        Background="{DynamicResource PanelBackground}"
                        Visibility="{Binding ShowRightPropertiesPanel, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="12,8,12,10">

              <StackPanel Visibility="{Binding ShowFriendlyTeleportEditor, Converter={StaticResource BoolToVis}}"
                          Margin="0,0,0,8">
                <TextBlock Text="Teletransporte" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Map ID" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding TeleportMapText, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="Field_TextChanged" FontFamily="Consolas"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Cell ID" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding TeleportCellText, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="Field_TextChanged" FontFamily="Consolas"/>
                  </StackPanel>
                </Grid>
              </StackPanel>

              <TextBlock Text="{Binding StartQuestLinkStatusText}" FontSize="11"
                         Foreground="{DynamicResource Accent}" Margin="0,0,0,6"
                         Visibility="{Binding ShowStartQuestLinkWarning, Converter={StaticResource BoolToVis}}"/>

              <ctrl:ContentMissionEditorPanel
                  DataContext="{Binding MissionEditor, RelativeSource={RelativeSource AncestorType=ctrl:ContentDialogEditorPanel}}"
                  Visibility="{Binding ShowFriendlyQuestEditor, Converter={StaticResource BoolToVis}}"/>

              <Border Visibility="{Binding IsConfirmActionPending, Converter={StaticResource BoolToVis}}"
                      Background="{DynamicResource ElevatedSurface}" BorderBrush="{DynamicResource Accent}"
                      BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
                <StackPanel>
                  <TextBlock Text="Dato pendiente de confirmar" FontWeight="SemiBold" FontSize="11"
                             Foreground="{DynamicResource Accent}"/>
                  <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                             Foreground="{DynamicResource TextSecondary}"
                             Text="Completa accion / args / condicion abajo."/>
                </StackPanel>
              </Border>

              <StackPanel Visibility="{Binding ShowActionRawFields, Converter={StaticResource BoolToVis}}"
                          Margin="0,0,0,8">
                <TextBlock Text="Acción avanzada" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                <TextBlock Text="accion" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding SelectedAction.Accion, UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="Field_TextChanged" Margin="0,0,0,4" FontFamily="Consolas"/>
                <TextBlock Text="args" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding SelectedAction.Args, UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="Field_TextChanged" Margin="0,0,0,4" FontFamily="Consolas"/>
                <TextBlock Text="condicion" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding SelectedAction.Condicion, UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="Field_TextChanged" FontFamily="Consolas"/>
              </StackPanel>

              <TextBlock Text="{Binding StatusText}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                         Foreground="{DynamicResource TextMuted}"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>
    </Grid>
  </Grid>
</UserControl>
