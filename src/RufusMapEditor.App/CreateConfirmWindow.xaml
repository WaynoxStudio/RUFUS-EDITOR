<Window x:Class="RufusMapEditor.App.CreateConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmar creación de mapa"
        Width="620" Height="650"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Background="{DynamicResource DialogHeaderBackground}" CornerRadius="6"
            BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="12,10" Margin="0,0,0,10">
      <StackPanel Orientation="Horizontal">
        <Border Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource BrandAccent}" Margin="0,0,10,0"/>
        <TextBlock Text="INSERT de mapa nuevo" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>
    <TextBlock x:Name="DatabaseText" Grid.Row="1" Margin="0,0,0,12"
               Foreground="{DynamicResource TextSecondary}"/>
    <Border Grid.Row="2" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource Border}"
            BorderThickness="1" CornerRadius="6" Padding="2">
      <TextBox x:Name="SummaryText" IsReadOnly="True" BorderThickness="0"
               Background="Transparent"
               FontFamily="Consolas" TextWrapping="NoWrap"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
    </Border>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Cancelar" IsCancel="True" Padding="12,5" Margin="0,0,8,0"/>
      <Button Content="Crear mapa" IsDefault="True" Padding="12,5"
              Style="{StaticResource PrimaryButton}" Click="Confirm_Click"/>
    </StackPanel>
  </Grid>
</Window>
