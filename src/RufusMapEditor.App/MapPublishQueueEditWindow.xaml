<Window x:Class="RufusMapEditor.App.MapPublishQueueEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Completar datos de publicación"
        Width="420" Height="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancelar" Width="100" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
      <Button Content="Guardar" Width="100" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Ok_Click"/>
    </StackPanel>
    <StackPanel>
      <TextBlock Text="Completar datos" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"
                 Foreground="{DynamicResource TextPrimary}"/>
      <TextBlock Text="{Binding MapIdLine}" Margin="0,0,0,12" FontFamily="{StaticResource AppFontFamilyMono}"/>
      <TextBlock Text="Coordenada X" Margin="0,0,0,4"/>
      <TextBox x:Name="XBox" Padding="6,4" Margin="0,0,0,8"
               ToolTip="mapas.X — vacío no válido para publicar. 0 es un valor explícito válido."/>
      <TextBlock Text="Coordenada Y" Margin="0,0,0,4"/>
      <TextBox x:Name="YBox" Padding="6,4" Margin="0,0,0,8"
               ToolTip="mapas.Y — vacío no válido para publicar. 0 es un valor explícito válido."/>
      <TextBlock Text="SubArea (sa)" Margin="0,0,0,4"/>
      <TextBox x:Name="SubAreaBox" Padding="6,4" Margin="0,0,0,8"
               ToolTip="Valor sa de MA.m — no se inventa."/>
      <TextBlock Text="EP" Margin="0,0,0,4"/>
      <TextBox x:Name="EpBox" Padding="6,4" Margin="0,0,0,4"
               ToolTip="Predeterminado del proyecto: 2"/>
      <TextBlock Text="EP predeterminado = 2 (editable)." FontSize="11"
                 Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
    </StackPanel>
  </DockPanel>
</Window>
