<Window x:Class="RufusMapEditor.App.ContentDialogEsPublishWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Publicar dialog_es"
        Width="560" Height="620"
        MinWidth="480" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource AppFontFamily}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Text="Contenido → Publicar dialog_es (SFTP)" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>

    <Border Grid.Row="1" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6"
            Background="{DynamicResource PanelBackground}" Padding="12">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <TextBlock Text="{Binding Summary}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
      </ScrollViewer>
    </Border>

    <TextBlock Grid.Row="2" Text="{Binding Status}" Margin="0,10,0,10" TextWrapping="Wrap"
               FontSize="11" Foreground="{DynamicResource TextSecondary}"/>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="CANCELAR" Command="{Binding CancelCommand}" Padding="14,6" Margin="0,0,8,0" IsCancel="True"/>
      <Button Content="PUBLICAR dialog_es" Command="{Binding PublishCommand}" Padding="14,6" FontWeight="SemiBold"
              IsDefault="True"/>
    </StackPanel>
  </Grid>
</Window>
