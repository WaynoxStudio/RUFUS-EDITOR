<Window x:Class="RufusMapEditor.App.ItemPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RufusMapEditor.App.Controls"
        Title="Buscar objeto"
        Height="600" Width="740"
        MinHeight="440" MinWidth="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
  </Window.Resources>
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Cantidad" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBox x:Name="QtyBox" Width="50" Padding="4,2"/>
        </StackPanel>
        <Button DockPanel.Dock="Right" Content="Seleccionar" Padding="12,6" IsDefault="True" Click="Ok_Click"/>
        <TextBlock x:Name="CountText" VerticalAlignment="Center" Margin="12,0,0,0"
                   Foreground="{DynamicResource TextSecondary}"/>
      </DockPanel>
    </StackPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <TextBlock x:Name="StatusText" Margin="0,0,0,6" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
      <Grid Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="SearchBox" Grid.Column="0" Padding="6,4"
                 Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}"
                 TextChanged="SearchBox_TextChanged"
                 ToolTip="Nombre o Item ID"/>
        <ComboBox x:Name="TypeFilter" Grid.Column="2" SelectionChanged="TypeFilter_SelectionChanged"/>
      </Grid>
    </StackPanel>
    <ListBox x:Name="ResultList"
             VirtualizingPanel.IsVirtualizing="True"
             VirtualizingPanel.VirtualizationMode="Recycling"
             VirtualizingPanel.ScrollUnit="Pixel"
             ScrollViewer.CanContentScroll="True"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             Background="{DynamicResource SurfaceBackground}"
             BorderBrush="{DynamicResource Border}"
             MouseDoubleClick="ResultList_MouseDoubleClick">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="Padding" Value="0"/>
          <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Padding="8,6" Background="{DynamicResource ElevatedSurface}"
                  ToolTip="{Binding ToolTipText}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <controls:LazyItemIconImage Grid.Column="0"
                                          GfxId="{Binding GfxId}"
                                          TypeId="{Binding TypeId}"
                                          ReloadToken="{Binding IconReloadToken}"
                                          Width="64" Height="64" Margin="0,0,10,0"/>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Subtitle}" FontFamily="Consolas" FontSize="12"
                           Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding MissingIconHint}" FontSize="10"
                           Foreground="{DynamicResource TextMuted}"
                           Visibility="{Binding ShowMissingIconHint, Converter={StaticResource BoolToVis}}"/>
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
