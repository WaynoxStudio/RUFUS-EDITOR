<Window x:Class="RufusMapEditor.App.ContentMissionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RufusMapEditor.App.ViewModels"
        Title="Contenido · Misiones"
        Width="1120" Height="720"
        MinWidth="920" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource AppFontFamily}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <Style x:Key="SectionHeader" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Margin" Value="0,8,0,6"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>
  </Window.Resources>

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource DialogHeaderBackground}" CornerRadius="6"
            BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="12,10" Margin="0,0,0,10">
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <Button Content="Recargar" Command="{Binding ReloadCommand}" Padding="10,4" Margin="0,0,8,0"/>
          <Button Content="Leer MAX" Command="{Binding RefreshMaxCommand}" Padding="10,4" Margin="0,0,8,0"
                  ToolTip="SELECT MAX etapas/objetivos (solo lectura)"/>
          <Button Content="Cerrar" IsCancel="True" Padding="10,4" Click="Close_Click"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Contenido → Misiones" FontWeight="SemiBold" FontSize="15"/>
          <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource Border}"
              BorderThickness="1" CornerRadius="8" Padding="10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="+ Nueva misión" Command="{Binding NewMissionCommand}" Padding="10,5"/>
            <TextBlock Text="Borradores" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </DockPanel>
          <ListBox Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:MissionListItemVm}">
                <StackPanel Margin="2,4">
                  <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold"/>
                  <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondary}">
                    <Run Text="{Binding Status, Mode=OneWay}"/>
                    <Run Text=" · NPC: "/><Run Text="{Binding NpcLabel, Mode=OneWay}"/>
                    <Run Text=" · Etapas: "/><Run Text="{Binding StageCount, Mode=OneWay}"/>
                  </TextBlock>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Duplicar" Command="{Binding DuplicateMissionCommand}" Padding="10,4" Margin="0,0,8,0"/>
            <Button Content="Eliminar" Command="{Binding DeleteMissionCommand}" Padding="10,4"/>
          </StackPanel>
        </Grid>
      </Border>

      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding EditorEnabled}">
        <StackPanel>
          <!-- Mission block -->
          <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource Border}"
                  BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10"
                  DataContext="{Binding Selected}">
            <StackPanel>
              <TextBlock Text="MISIÓN" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
              <TextBlock Text="{Binding DataContext.QuestIdLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                         FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Nombre" Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="Field_Changed" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="1" Text="Puede repetirse" Style="{StaticResource FieldLabel}"/>
                <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding PuedeRepetirse}" Margin="0,0,0,6"
                          Checked="Field_Changed" Unchecked="Field_Changed"/>
              </Grid>
            </StackPanel>
          </Border>

          <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource Border}"
                  BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="NPC + PREGUNTAS" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="NPC inicial" Style="{StaticResource FieldLabel}"/>
                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding NpcChoices}"
                          SelectedItem="{Binding SelectedStartNpc}" Margin="0,0,0,6">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock>
                        <Run Text="#"/><Run Text="{Binding Id, Mode=OneWay}"/>
                        <Run Text=" — "/><Run Text="{Binding Nombre, Mode=OneWay}"/>
                      </TextBlock>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Grid.Row="1" Text="Pregunta dar misión" Style="{StaticResource FieldLabel}"/>
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding QuestionChoices}"
                          SelectedItem="{Binding SelectedPregDar}" Margin="0,0,0,6"
                          DisplayMemberPath="Id"/>
                <TextBlock Grid.Row="2" Text="Pregunta incompleta" Style="{StaticResource FieldLabel}"/>
                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding QuestionChoices}"
                          SelectedItem="{Binding SelectedPregInc}" Margin="0,0,0,6"
                          DisplayMemberPath="Id"/>
                <TextBlock Grid.Row="3" Text="Pregunta completada" Style="{StaticResource FieldLabel}"/>
                <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding QuestionChoices}"
                          SelectedItem="{Binding SelectedPregComp}" Margin="0,0,0,6"
                          DisplayMemberPath="Id"/>
                <TextBlock Grid.Row="4" Text="Preview preg*" Style="{StaticResource FieldLabel}"/>
                <TextBlock Grid.Row="4" Grid.Column="1" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap">
                  <Run Text="dar="/><Run Text="{Binding PregDarPreview, Mode=OneWay}"/>
                  <LineBreak/>
                  <Run Text="inc="/><Run Text="{Binding PregIncPreview, Mode=OneWay}"/>
                  <LineBreak/>
                  <Run Text="comp="/><Run Text="{Binding PregCompPreview, Mode=OneWay}"/>
                </TextBlock>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Flow -->
          <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource Border}"
                  BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
            <StackPanel>
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="+ Añadir etapa" Command="{Binding AddStageCommand}" Padding="10,4"/>
                <TextBlock Text="FLUJO" Style="{StaticResource SectionHeader}" Margin="0"/>
              </DockPanel>
              <ItemsControl ItemsSource="{Binding FlowStages}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:MissionFlowNodeVm}">
                    <StackPanel HorizontalAlignment="Left" Margin="0,0,0,4">
                      <Border BorderBrush="{DynamicResource BrandAccent}" BorderThickness="1" CornerRadius="6"
                              Padding="12,6" Background="{DynamicResource DialogHeaderBackground}">
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                      </Border>
                      <TextBlock Text="↓" HorizontalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Stages list + detail -->
          <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource Border}"
                  BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="ETAPAS" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                <ListBox ItemsSource="{Binding Selected.Model.Stages}" SelectedItem="{Binding SelectedStage}"
                         DisplayMemberPath="Id" Height="160" Margin="0,0,0,8"/>
                <WrapPanel>
                  <Button Content="Dup" Command="{Binding DuplicateStageCommand}" Padding="8,4" Margin="0,0,4,4"/>
                  <Button Content="Del" Command="{Binding DeleteStageCommand}" Padding="8,4" Margin="0,0,4,4"/>
                  <Button Content="↑" Command="{Binding MoveStageUpCommand}" Padding="8,4" Margin="0,0,4,4"/>
                  <Button Content="↓" Command="{Binding MoveStageDownCommand}" Padding="8,4" Margin="0,0,0,4"/>
                </WrapPanel>
              </StackPanel>

              <StackPanel Grid.Column="2" Visibility="{Binding HasStage, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Etapa seleccionada" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Text="ID provisional" Style="{StaticResource FieldLabel}"/>
                  <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedStage.Id, Mode=OneWay}" IsReadOnly="True"
                           FontFamily="Consolas" Margin="0,0,0,6"/>
                  <TextBlock Grid.Row="1" Text="Nombre" Style="{StaticResource FieldLabel}"/>
                  <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedStage.Nombre, UpdateSourceTrigger=PropertyChanged}"
                           TextChanged="Field_Changed" Margin="0,0,0,6"/>
                  <TextBlock Grid.Row="2" Text="Descripción" Style="{StaticResource FieldLabel}"/>
                  <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedStage.Descripcion, UpdateSourceTrigger=PropertyChanged}"
                           TextChanged="Field_Changed" AcceptsReturn="True" Height="56" TextWrapping="Wrap" Margin="0,0,0,6"/>
                  <TextBlock Grid.Row="3" Text="variosobj" Style="{StaticResource FieldLabel}"/>
                  <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedStage.VariosObj, UpdateSourceTrigger=PropertyChanged}"
                           TextChanged="Field_Changed" FontFamily="Consolas"/>
                </Grid>

                <TextBlock Text="RECOMPENSAS" Style="{StaticResource SectionHeader}"/>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Text="Experiencia" Style="{StaticResource FieldLabel}"/>
                  <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedStage.Rewards.Exp, UpdateSourceTrigger=PropertyChanged}"
                           TextChanged="Rewards_Changed" Margin="0,0,0,6" FontFamily="Consolas"/>
                  <TextBlock Grid.Row="1" Text="Kamas" Style="{StaticResource FieldLabel}"/>
                  <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedStage.Rewards.Kamas, UpdateSourceTrigger=PropertyChanged}"
                           TextChanged="Rewards_Changed" FontFamily="Consolas"/>
                </Grid>
                <DockPanel Margin="0,0,0,4">
                  <Button DockPanel.Dock="Right" Content="+ Objeto" Command="{Binding AddRewardItemCommand}" Padding="8,3"/>
                  <Button DockPanel.Dock="Right" Content="Buscar objeto" Command="{Binding PickRewardItemCommand}"
                          Padding="8,3" Margin="0,0,6,0"/>
                  <TextBlock Text="Objetos (item,cantidad)" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="{Binding ItemsCatalogStatus}" FontSize="11" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                <ListBox ItemsSource="{Binding RewardItems}" SelectedItem="{Binding SelectedRewardItem}" Height="70" Margin="0,0,0,4">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <TextBox Width="70" Text="{Binding ItemId, UpdateSourceTrigger=LostFocus}" Margin="0,0,6,0"/>
                        <TextBox Width="50" Text="{Binding Cantidad, UpdateSourceTrigger=LostFocus}"/>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Button Content="Quitar objeto" Command="{Binding RemoveRewardItemCommand}" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                <Expander Header="Recompensas avanzadas" IsExpanded="{Binding AdvancedRewards}">
                  <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="120"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="emotes" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedStage.Rewards.Emotes, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="Rewards_Changed" Margin="0,0,0,4" FontFamily="Consolas"/>
                    <TextBlock Grid.Row="1" Text="hechizos" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedStage.Rewards.Hechizos, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="Rewards_Changed" Margin="0,0,0,4" FontFamily="Consolas"/>
                    <TextBlock Grid.Row="2" Text="oficios" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedStage.Rewards.Oficios, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="Rewards_Changed" Margin="0,0,0,4" FontFamily="Consolas"/>
                    <TextBlock Grid.Row="3" Text="acciones" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedStage.Rewards.Acciones, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="Rewards_Changed" FontFamily="Consolas"/>
                  </Grid>
                </Expander>
                <TextBlock Margin="0,6,0,0" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextMuted}"
                           Text="{Binding RewardsRawPreview, StringFormat=RAW: {0}}" TextWrapping="Wrap"/>

                <TextBlock Text="OBJETIVOS" Style="{StaticResource SectionHeader}"/>
                <ListBox ItemsSource="{Binding SelectedStage.Objectives}" SelectedItem="{Binding SelectedObjective}"
                         Height="90" Margin="0,0,0,6" DisplayMemberPath="Id"/>
                <WrapPanel Margin="0,0,0,6">
                  <Button Content="Entregar objetos a NPC (tipo 3)" Command="{Binding AddDeliverObjectiveCommand}"
                          Padding="8,4" Margin="0,0,6,4"/>
                  <Button Content="Objetivo avanzado" Command="{Binding AddAdvancedObjectiveCommand}"
                          Padding="8,4" Margin="0,0,6,4"/>
                  <Button Content="Eliminar objetivo" Command="{Binding DeleteObjectiveCommand}" Padding="8,4" Margin="0,0,0,4"/>
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <TextBlock Text="NPC" VerticalAlignment="Center" Margin="0,0,4,0"/>
                  <TextBox Width="60" Text="{Binding DeliverNpcId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                  <TextBlock Text="Item" VerticalAlignment="Center" Margin="0,0,4,0"/>
                  <TextBox Width="60" Text="{Binding DeliverItemId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0"/>
                  <Button Content="Buscar objeto" Command="{Binding PickDeliverItemCommand}" Padding="6,2" Margin="0,0,8,0"/>
                  <TextBlock Text="Qty" VerticalAlignment="Center" Margin="0,0,4,0"/>
                  <TextBox Width="40" Text="{Binding DeliverQty, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Visibility="{Binding HasObjective, Converter={StaticResource BoolToVis}}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="100"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="ID" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedObjective.Id, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,4" FontFamily="Consolas"/>
                    <TextBlock Grid.Row="1" Text="tipo" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedObjective.Tipo, UpdateSourceTrigger=PropertyChanged}" TextChanged="Field_Changed" Margin="0,0,0,4" FontFamily="Consolas"/>
                    <TextBlock Grid.Row="2" Text="args" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedObjective.Args, UpdateSourceTrigger=PropertyChanged}" TextChanged="Field_Changed" Margin="0,0,0,4" FontFamily="Consolas"/>
                    <TextBlock Grid.Row="3" Text="detalle" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedObjective.Detalle, UpdateSourceTrigger=PropertyChanged}" TextChanged="Field_Changed" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="4" Text="esalHablar" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SelectedObjective.EsAlHablar, UpdateSourceTrigger=PropertyChanged}" TextChanged="Field_Changed" Margin="0,0,0,4" FontFamily="Consolas"/>
                    <TextBlock Grid.Row="5" Text="esOculto" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding SelectedObjective.EsOculto, UpdateSourceTrigger=PropertyChanged}" TextChanged="Field_Changed" Margin="0,0,0,4" FontFamily="Consolas"/>
                    <TextBlock Grid.Row="6" Text="condicion" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding SelectedObjective.Condicion, UpdateSourceTrigger=PropertyChanged}" TextChanged="Field_Changed" FontFamily="Consolas"/>
                  </Grid>
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>

          <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                     Text="Borrador local. Sin INSERT BD. Sin quests_es. Quest ID numérico en CONT.5. Textos listos para futura IA/quests_es."/>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <TextBlock Grid.Row="2" Margin="0,10,0,0" FontSize="11" Foreground="{DynamicResource TextMuted}"
               Text="Escrituras BD: 0 · SFTP: 0 · Etapas/objetivos: MAX+1 global · Quest: DraftId"/>
  </Grid>
</Window>
