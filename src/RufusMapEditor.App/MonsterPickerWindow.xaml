<Window x:Class="RufusMapEditor.App.MonsterPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RufusMapEditor.App.Controls"
        Title="Buscar monstruo"
        Height="560" Width="820"
        MinHeight="420" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <TextBlock x:Name="PreviewNote" TextWrapping="Wrap" FontSize="11"
                 Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Seleccionar" Padding="12,6" IsDefault="True" Click="Ok_Click"/>
        <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
      </DockPanel>
    </StackPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <TextBlock x:Name="StatusText" Margin="0,0,0,6" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
      <TextBox x:Name="SearchBox" Padding="6,4"
               Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}"
               TextChanged="SearchBox_TextChanged"
               ToolTip="Nombre, ID o gfxID"/>
    </StackPanel>
    <ListBox x:Name="ResultList"
             VirtualizingPanel.IsVirtualizing="True"
             VirtualizingPanel.VirtualizationMode="Recycling"
             VirtualizingPanel.ScrollUnit="Pixel"
             ScrollViewer.CanContentScroll="True"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             Background="{DynamicResource SurfaceBackground}"
             BorderBrush="{DynamicResource Border}"
             MouseDoubleClick="ResultList_MouseDoubleClick"
             SelectionChanged="ResultList_SelectionChanged">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="Padding" Value="0"/>
          <Setter Property="Margin" Value="0,0,0,4"/>
          <Setter Property="Focusable" Value="False"/>
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Padding="8,6" Margin="0,0,3,0"
                    Background="{DynamicResource ElevatedSurface}" CornerRadius="4"
                    Cursor="Hand" MouseLeftButtonUp="MonsterCard_MouseLeftButtonUp"
                    Tag="{Binding Left}">
              <Border.Style>
                <Style TargetType="Border">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Left}" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Hidden"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <DockPanel>
                <controls:LazyArtworkImage DockPanel.Dock="Left" GfxId="{Binding Left.GfxId}"
                                           Width="56" Height="56" Margin="0,0,8,0"/>
                <StackPanel>
                  <TextBlock Text="{Binding Left.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Left.Subtitle}" FontFamily="Consolas" FontSize="11"
                             TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
                  <TextBlock Text="{Binding Left.PathHint}" FontSize="10" Foreground="{DynamicResource TextMuted}"
                             TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="28"/>
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Grid.Column="1" Padding="8,6" Margin="3,0,0,0"
                    Background="{DynamicResource ElevatedSurface}" CornerRadius="4"
                    Cursor="Hand" MouseLeftButtonUp="MonsterCard_MouseLeftButtonUp"
                    Tag="{Binding Right}">
              <Border.Style>
                <Style TargetType="Border">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Right}" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Hidden"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <DockPanel>
                <controls:LazyArtworkImage DockPanel.Dock="Left" GfxId="{Binding Right.GfxId}"
                                           Width="56" Height="56" Margin="0,0,8,0"/>
                <StackPanel>
                  <TextBlock Text="{Binding Right.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Right.Subtitle}" FontFamily="Consolas" FontSize="11"
                             TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
                  <TextBlock Text="{Binding Right.PathHint}" FontSize="10" Foreground="{DynamicResource TextMuted}"
                             TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="28"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
