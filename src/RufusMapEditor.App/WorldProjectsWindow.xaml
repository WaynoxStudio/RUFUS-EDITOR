<Window x:Class="RufusMapEditor.App.WorldProjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Abrir mundo"
        Width="520" Height="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="#FFF5F0E6">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="Proyectos en Géopositions" FontWeight="SemiBold" Margin="0,0,0,4"
               Foreground="#FFFFFFFF"/>
    <TextBlock x:Name="PathText" Grid.Row="1" TextWrapping="Wrap" FontSize="11"
               Foreground="#FFF0EBE0" Margin="0,0,0,8"/>
    <ListBox x:Name="ProjectsList" Grid.Row="2"
             Background="{DynamicResource SurfaceBackground}"
             BorderBrush="{DynamicResource Border}"
             Foreground="#FFF5F0E6"
             MouseDoubleClick="ProjectsList_OnMouseDoubleClick">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="Foreground" Value="#FFF5F0E6"/>
          <Setter Property="Padding" Value="2"/>
          <Setter Property="Margin" Value="0,1"/>
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent"
                        BorderThickness="1" CornerRadius="5" Padding="6,5"
                        SnapsToDevicePixels="True">
                  <ContentPresenter HorizontalAlignment="Stretch"
                                    TextElement.Foreground="{TemplateBinding Foreground}"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#28FFFFFF"/>
                  </Trigger>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#33F39C12"/>
                    <Setter TargetName="Bd" Property="BorderBrush" Value="#99F39C12"/>
                    <Setter Property="Foreground" Value="#FFFFFFFF"/>
                  </Trigger>
                  <MultiTrigger>
                    <MultiTrigger.Conditions>
                      <Condition Property="IsSelected" Value="True"/>
                      <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="Bd" Property="Background" Value="#44F39C12"/>
                    <Setter TargetName="Bd" Property="BorderBrush" Value="#BBF39C12"/>
                  </MultiTrigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel>
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
            <TextBlock FontSize="11" Foreground="#FFE8DFD0" Margin="0,2,0,0">
              <Run Text="Modificado: "/><Run Text="{Binding ModifiedLocal, Mode=OneWay}"/>
            </TextBlock>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <DockPanel Grid.Row="3" Margin="0,12,0,0">
      <Button DockPanel.Dock="Left" Content="Examinar archivo..." Padding="10,4" Click="Browse_Click"
              Foreground="#FFF5F0E6"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancelar" Width="90" Margin="0,0,8,0" Padding="8,4" IsCancel="True" Click="Cancel_Click"
                Foreground="#FFF5F0E6"/>
        <Button Content="Abrir" Width="90" Padding="8,4" IsDefault="True" Click="Open_Click"
                Foreground="#FFF5F0E6"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
