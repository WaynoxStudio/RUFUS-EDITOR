<Window x:Class="RufusMapEditor.App.Licensing.LicenseStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Licencia"
        Width="460" Height="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource AppFontFamily}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Text="Estado de licencia" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="ESTADO DE LICENCIA" FontWeight="SemiBold" FontSize="12"
                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
        <Grid Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Estado:" Foreground="{DynamicResource TextSecondary}"/>
          <TextBlock x:Name="StatusValue" Grid.Column="1" FontWeight="SemiBold"/>
        </Grid>
        <Grid Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Caduca:" Foreground="{DynamicResource TextSecondary}"/>
          <TextBlock x:Name="ExpiresValue" Grid.Column="1"/>
        </Grid>
        <Grid Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Tiempo restante:" Foreground="{DynamicResource TextSecondary}"/>
          <TextBlock x:Name="RemainingValue" Grid.Column="1"/>
        </Grid>
        <Grid Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Dispositivo:" Foreground="{DynamicResource TextSecondary}"/>
          <TextBlock x:Name="DeviceValue" Grid.Column="1"/>
        </Grid>
        <TextBlock x:Name="ExpiringSoonLine" Margin="0,6,0,0" TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Foreground="{DynamicResource TextSecondary}"
                   Text="Tu licencia caduca pronto."/>
        <TextBlock x:Name="StaleLine" Margin="0,6,0,0" TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Foreground="{DynamicResource TextSecondary}"
                   Text="Estado no actualizado"/>

        <TextBlock Text="PERMISOS" FontWeight="SemiBold" FontSize="12"
                   Foreground="{DynamicResource TextSecondary}" Margin="0,16,0,8"/>
        <Grid Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="RUFUS Editor:" Foreground="{DynamicResource TextSecondary}"/>
          <TextBlock x:Name="EditorValue" Grid.Column="1"/>
        </Grid>
        <Grid Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Asistente IA:" Foreground="{DynamicResource TextSecondary}"/>
          <TextBlock x:Name="AiValue" Grid.Column="1"/>
        </Grid>

        <TextBlock Text="USO IA" FontWeight="SemiBold" FontSize="12"
                   Foreground="{DynamicResource TextSecondary}" Margin="0,16,0,8"/>
        <Grid Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Hoy:" Foreground="{DynamicResource TextSecondary}"/>
          <TextBlock x:Name="AiTodayValue" Grid.Column="1"/>
        </Grid>
        <Grid Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Este mes:" Foreground="{DynamicResource TextSecondary}"/>
          <TextBlock x:Name="AiMonthValue" Grid.Column="1"/>
        </Grid>

        <TextBlock x:Name="NoteLine" Margin="0,16,0,0" FontSize="11"
                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="RefreshButton" Content="Actualizar estado" Width="130" Padding="8,4" Margin="0,0,8,0"
              Click="Refresh_Click"/>
      <Button x:Name="LogoutButton" Content="Cerrar sesión" Width="120" Padding="8,4" Margin="0,0,8,0"
              Click="Logout_Click"/>
      <Button Content="Cerrar" Width="100" Padding="8,4"
              IsCancel="True" IsDefault="True" Click="Close_Click"/>
    </StackPanel>
  </Grid>
</Window>
