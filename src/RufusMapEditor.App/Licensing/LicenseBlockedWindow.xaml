<Window x:Class="RufusMapEditor.App.Licensing.LicenseBlockedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RUFUS EDITOR — Licencia"
        Width="460" Height="280"
        MinWidth="400" MinHeight="240"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource AppFontFamily}">
  <Grid Margin="28,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Text="Acceso bloqueado"
               FontSize="18" FontWeight="SemiBold"
               FontFamily="{DynamicResource AppFontFamilyDisplay}"/>

    <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,16,0,0"
               TextWrapping="Wrap" LineHeight="22"
               Foreground="{DynamicResource TextSecondary}"/>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="Salir" Width="90" Padding="8,6" Margin="0,0,8,0"
              IsCancel="True" Click="Exit_Click"/>
      <Button Content="Activar licencia" Width="130" Padding="8,6"
              Style="{StaticResource PrimaryButton}"
              IsDefault="True" Click="Activate_Click"/>
    </StackPanel>
  </Grid>
</Window>
