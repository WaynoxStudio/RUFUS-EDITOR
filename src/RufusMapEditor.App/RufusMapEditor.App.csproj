<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- UI module hosted by RufusAdmin — no standalone exe. -->
    <OutputType>Library</OutputType>
    <UseAppHost>false</UseAppHost>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <AssemblyName>RufusMapEditor</AssemblyName>
    <RootNamespace>RufusMapEditor.App</RootNamespace>
    <ApplicationTitle>RUFUS Map Editor</ApplicationTitle>
    <Product>RUFUS Map Editor</Product>
    <ApplicationIcon>Assets\RME.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RufusMapEditor.Domain\RufusMapEditor.Domain.csproj" />
    <ProjectReference Include="..\RufusMapEditor.LegacyCompatibility\RufusMapEditor.LegacyCompatibility.csproj" />
    <ProjectReference Include="..\RufusMapEditor.Rendering\RufusMapEditor.Rendering.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\RME.ico" />
    <Resource Include="Assets\RME.png" />
  </ItemGroup>

</Project>

