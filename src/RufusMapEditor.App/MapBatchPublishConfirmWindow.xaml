<Window x:Class="RufusMapEditor.App.MapBatchPublishConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Publicar lote de mapas"
        Width="560" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="CANCELAR" Width="120" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
      <Button x:Name="PublishButton" Content="PUBLICAR" Width="160"
              Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Publish_Click"/>
    </StackPanel>
    <TextBox x:Name="PreviewBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource AppFontFamilyMono}"
             FontSize="12" Padding="10"/>
  </DockPanel>
</Window>
