<Window x:Class="RufusMapEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RufusMapEditor.App"
        Title="{Binding WindowTitle}"
        Height="900" Width="1400"
        MinHeight="560" MinWidth="1000"
        Icon="pack://application:,,,/Assets/RME.ico"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextPrimary}"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
  <local:MapsEditorView x:Name="Editor"/>
</Window>
