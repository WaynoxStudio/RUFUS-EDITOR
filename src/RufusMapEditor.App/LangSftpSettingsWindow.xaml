<Window x:Class="RufusMapEditor.App.LangSftpSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración LANG / SFTP"
        Width="560" Height="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Background="{DynamicResource DialogHeaderBackground}" CornerRadius="6"
            BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="12,10" Margin="0,0,0,12">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <Border Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource BrandAccent}" Margin="0,0,10,0"/>
          <TextBlock Text="LANG / SFTP · solo lectura (11B.1)" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="No sube, borra ni modifica archivos remotos. Contraseña con DPAPI (nunca embebida)."
                   TextWrapping="Wrap" Margin="13,6,0,0" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="130"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Host" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
        <TextBox x:Name="HostBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" FontFamily="Consolas"/>

        <TextBlock Grid.Row="1" Text="Puerto" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
        <TextBox x:Name="PortBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" FontFamily="Consolas" Text="22"/>

        <TextBlock Grid.Row="2" Text="Usuario" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
        <TextBox x:Name="UserBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" FontFamily="Consolas"/>

        <TextBlock Grid.Row="3" Text="Contraseña" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="4" Text="Ruta LANG" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
        <TextBox x:Name="LangPathBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" FontFamily="Consolas"/>

        <TextBlock Grid.Row="5" Text="Ruta SWF" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
        <TextBox x:Name="SwfPathBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" FontFamily="Consolas"/>
      </Grid>
    </ScrollViewer>

    <TextBlock x:Name="StatusText" Grid.Row="2" TextWrapping="Wrap" Margin="0,8,0,8"
               Foreground="{DynamicResource TextSecondary}" MinHeight="36"/>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Probar conexión SFTP" Padding="10,4" Margin="0,0,8,0" Click="Test_Click"/>
      <Button Content="Cancelar" Padding="10,4" Margin="0,0,8,0" IsCancel="True"/>
      <Button Content="Guardar" Padding="10,4" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/>
    </StackPanel>
  </Grid>
</Window>
