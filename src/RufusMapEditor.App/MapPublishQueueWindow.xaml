<Window x:Class="RufusMapEditor.App.MapPublishQueueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cola de publicación"
        Width="680" Height="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">
  <DockPanel Margin="14">
    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
      <Button DockPanel.Dock="Left" Content="Vaciar cola" Command="{Binding ClearQueueCommand}"
              Padding="10,6" Margin="0,0,8,0"/>
      <Button DockPanel.Dock="Left" Content="Quitar" Command="{Binding RemoveSelectedCommand}"
              Padding="10,6" Margin="0,0,8,0"/>
      <Button DockPanel.Dock="Right" Content="PUBLICAR TODOS" Command="{Binding PublishAllCommand}"
              Style="{StaticResource PrimaryButton}" Padding="14,6" Margin="8,0,0,0"
              ToolTip="Publicar toda la cola (BD + un maps_es N+1)"/>
      <Button DockPanel.Dock="Right" Content="PUBLICAR SELECCIONADOS" Command="{Binding PublishSelectedCommand}"
              Padding="10,6" Margin="8,0,0,0"
              ToolTip="Publicar solo el mapa seleccionado (mismas validaciones)"/>
      <Button DockPanel.Dock="Right" Content="Cerrar" IsCancel="True" Padding="10,6" Click="Close_Click"/>
    </DockPanel>

    <TextBlock DockPanel.Dock="Top" Text="COLA DE PUBLICACIÓN" FontWeight="SemiBold" FontSize="16"
               Margin="0,0,0,4" Foreground="{DynamicResource TextPrimary}"/>
    <TextBlock DockPanel.Dock="Top"
               Text="Añade mapas con [+] en cada ventana. Completa sa/X/Y aquí si faltan. Publicar solo desde esta cola."
               FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8" TextWrapping="Wrap"/>
    <TextBlock DockPanel.Dock="Top" Text="{Binding StatusText}" Margin="0,0,0,8"
               Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>

    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <Button DockPanel.Dock="Right" Content="Actualizar" Command="{Binding RefreshCommand}" Padding="8,4" Margin="6,0,0,0"/>
      <Button DockPanel.Dock="Right" Content="Completar datos" Command="{Binding CompletarDatosCommand}"
              Padding="8,4" Margin="6,0,0,0"
              ToolTip="Editar X, Y, SubArea (sa) y EP del mapa seleccionado"/>
      <Button DockPanel.Dock="Right" Content="Abrir mapa" Command="{Binding OpenSelectedCommand}" Padding="8,4"/>
      <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"
                 Text="{Binding Count, StringFormat=Pendientes: {0}}"/>
    </DockPanel>

    <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Padding="8,6" Margin="0,0,0,4" Background="{DynamicResource ElevatedSurface}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{Binding MapId}" FontWeight="SemiBold"
                         FontFamily="{StaticResource AppFontFamilyMono}" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Margin="8,0">
                <TextBlock Text="{Binding DbKindLabel}" FontSize="11"
                           Foreground="{DynamicResource TextSecondary}"/>
                <TextBlock Text="{Binding StatusLabel}" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock FontSize="10" Foreground="{DynamicResource TextMuted}"
                           Text="{Binding EpLine}"/>
                <TextBlock FontSize="10" Foreground="{DynamicResource TextMuted}"
                           Text="{Binding SaLine}"/>
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
