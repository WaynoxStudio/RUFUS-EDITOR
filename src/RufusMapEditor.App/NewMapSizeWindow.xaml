<Window x:Class="RufusMapEditor.App.NewMapSizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuevo mapa"
        Width="440"
        SizeToContent="Height"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FF1A1A1A"
        Foreground="#FFFFFFFF"
        FontFamily="Segoe UI"
        FontSize="13">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Text="Elige el tamaño de la plantilla. El Map ID se pide al guardar."
               TextWrapping="Wrap" Margin="0,0,0,14"
               Foreground="#FFFFFFFF"/>

    <StackPanel Grid.Row="1" Margin="0,0,0,14">
      <RadioButton x:Name="PresetMedio" GroupName="Size" IsChecked="True"
                   Foreground="#FFFFFFFF"
                   Content="Medio — 15 × 17 (estándar, 479 celdas)"
                   Margin="0,0,0,10" Checked="Preset_Changed"/>
      <RadioButton x:Name="PresetGrande" GroupName="Size"
                   Foreground="#FFFFFFFF"
                   Content="Grande — 19 × 22 (796 celdas)"
                   Margin="0,0,0,10" Checked="Preset_Changed"/>
      <RadioButton x:Name="PresetCustom" GroupName="Size"
                   Foreground="#FFFFFFFF"
                   Content="Personalizado — elegir ancho y alto"
                   Margin="0,0,0,10" Checked="Preset_Changed"/>
    </StackPanel>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,14">
      <TextBlock Text="Ancho" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FFFFFFFF"/>
      <TextBox x:Name="WidthBox" Width="56" FontFamily="Consolas" Text="15" IsEnabled="False"
               Foreground="#FF222222" Background="#FFFFFFFF" BorderBrush="#FFCCCCCC" Padding="4,2"/>
      <TextBlock Text="×" VerticalAlignment="Center" Margin="10,0" FontSize="16" Foreground="#FFFFFFFF"/>
      <TextBlock Text="Alto" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FFFFFFFF"/>
      <TextBox x:Name="HeightBox" Width="56" FontFamily="Consolas" Text="17" IsEnabled="False"
               Foreground="#FF222222" Background="#FFFFFFFF" BorderBrush="#FFCCCCCC" Padding="4,2"/>
    </StackPanel>

    <TextBlock Grid.Row="3"
               Text="Se abre una plantilla vacía. Al guardar (Ctrl+S) eliges el Map ID y se crea Library\Maps\&lt;ID&gt;."
               TextWrapping="Wrap" FontSize="12" Margin="0,0,0,16"
               Foreground="#FFE0E0E0"/>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancelar" Width="90" Margin="0,0,8,0" Padding="8,4" IsCancel="True" Click="Cancel_Click"/>
      <Button Content="Crear" Width="90" Padding="8,4" IsDefault="True" Click="Ok_Click"/>
    </StackPanel>
  </Grid>
</Window>
