<Window x:Class="RufusMapEditor.App.AppearanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apariencia"
        Width="420" Height="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{DynamicResource DialogHeaderBackground}" CornerRadius="6"
            BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="12,10" Margin="0,0,0,14">
      <StackPanel Orientation="Horizontal">
        <Border Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource BrandAccent}" Margin="0,0,10,0"/>
        <TextBlock Text="Apariencia · RUFUS" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>
    <TextBlock Grid.Row="1" Text="Tema" Style="{StaticResource SectionHeader}"/>
    <StackPanel Grid.Row="2" Margin="0,0,0,16">
      <RadioButton x:Name="ThemeSystem" Content="Sistema (Windows)" GroupName="Theme" Margin="0,0,0,6"/>
      <RadioButton x:Name="ThemeLight" Content="Claro" GroupName="Theme" Margin="0,0,0,6"/>
      <RadioButton x:Name="ThemeDark" Content="Oscuro" GroupName="Theme"/>
    </StackPanel>
    <StackPanel Grid.Row="3">
      <TextBlock Text="Escala UI" Style="{StaticResource SectionHeader}"/>
      <ComboBox x:Name="ScaleCombo" SelectedIndex="1">
        <ComboBoxItem Content="90%"/>
        <ComboBoxItem Content="100%"/>
        <ComboBoxItem Content="110%"/>
        <ComboBoxItem Content="125%"/>
      </ComboBox>
    </StackPanel>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Cancelar" IsCancel="True" Margin="0,0,8,0"/>
      <Button Content="Aplicar" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Apply_Click"/>
    </StackPanel>
  </Grid>
</Window>
