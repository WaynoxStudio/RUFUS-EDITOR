<Window x:Class="RufusMapEditor.App.ContentDialogEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RufusMapEditor.App.ViewModels"
        Title="Contenido · Diálogos"
        Width="1100" Height="700"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource AppFontFamily}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <Style x:Key="SectionHeader" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>
  </Window.Resources>

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource DialogHeaderBackground}" CornerRadius="6"
            BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="12,10" Margin="0,0,0,10">
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <Button Content="Recargar NPC" Command="{Binding ReloadNpcsCommand}" Padding="10,4" Margin="0,0,8,0"/>
          <Button Content="Reloj MAX preguntas" Command="{Binding RefreshMaxCommand}" Padding="10,4" Margin="0,0,8,0"
                  ToolTip="SELECT MAX(id) FROM npc_preguntas (solo lectura)"/>
          <Button Content="Cerrar" IsCancel="True" Padding="10,4" Click="Close_Click"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Contenido → Diálogos" FontWeight="SemiBold" FontSize="15"/>
          <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="340"/>
      </Grid.ColumnDefinitions>

      <!-- NPC + tree -->
      <Border Grid.Column="0" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource Border}"
              BorderThickness="1" CornerRadius="8" Padding="10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Text="NPC borrador" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <ComboBox Grid.Row="1" ItemsSource="{Binding NpcChoices}" SelectedItem="{Binding SelectedNpc}"
                    Margin="0,0,0,8">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock>
                  <Run Text="#"/><Run Text="{Binding Id, Mode=OneWay}"/>
                  <Run Text=" — "/><Run Text="{Binding Nombre, Mode=OneWay}"/>
                </TextBlock>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="{Binding NpcHeader}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding InitialQuestionLabel}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
          </StackPanel>

          <TreeView Grid.Row="3" ItemsSource="{Binding TreeRoots}"
                    SelectedItemChanged="Tree_SelectedItemChanged"
                    BorderThickness="0" Background="Transparent">
            <TreeView.ItemTemplate>
              <HierarchicalDataTemplate DataType="{x:Type vm:DialogTreeNodeVm}" ItemsSource="{Binding Children}">
                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" MaxWidth="280"/>
              </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
            <TreeView.ItemContainerStyle>
              <Style TargetType="TreeViewItem">
                <Setter Property="IsExpanded" Value="True"/>
                <Setter Property="Padding" Value="2"/>
              </Style>
            </TreeView.ItemContainerStyle>
          </TreeView>

          <StackPanel Grid.Row="4" Margin="0,8,0,0">
            <Button Content="+ Nueva pregunta" Command="{Binding NewQuestionCommand}" Padding="8,5" Margin="0,0,0,6"/>
            <WrapPanel>
              <Button Content="Duplicar" Command="{Binding DuplicateQuestionCommand}" Padding="8,4" Margin="0,0,6,4"/>
              <Button Content="Eliminar" Command="{Binding DeleteQuestionCommand}" Padding="8,4" Margin="0,0,6,4"/>
              <Button Content="Marcar inicial" Command="{Binding SetInitialCommand}" Padding="8,4" Margin="0,0,0,4"/>
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Visual outline -->
      <Border Grid.Column="2" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource Border}"
              BorderThickness="1" CornerRadius="8" Padding="12">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding TreeRoots}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:DialogTreeNodeVm}">
                <StackPanel Margin="0,0,0,14">
                  <Border Background="{DynamicResource DialogHeaderBackground}" BorderBrush="{DynamicResource BrandAccent}"
                          BorderThickness="1" CornerRadius="6" Padding="10,8" HorizontalAlignment="Left" MaxWidth="420">
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  </Border>
                  <ItemsControl ItemsSource="{Binding Children}" Margin="28,8,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:DialogTreeNodeVm}">
                        <StackPanel Margin="0,0,0,8">
                          <TextBlock Text="│" Foreground="{DynamicResource TextMuted}" Margin="8,0,0,0"/>
                          <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6"
                                  Padding="8,6" HorizontalAlignment="Left" MaxWidth="380"
                                  Background="{DynamicResource WindowBackground}">
                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
                          </Border>
                          <ItemsControl ItemsSource="{Binding Children}" Margin="24,4,0,0">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="{x:Type vm:DialogTreeNodeVm}">
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                  <TextBlock Text="└ " Foreground="{DynamicResource TextMuted}"/>
                                  <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <!-- Side editor -->
      <Border Grid.Column="4" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource Border}"
              BorderThickness="1" CornerRadius="8" Padding="12">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <!-- Question panel -->
            <StackPanel Visibility="{Binding HasQuestion, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="PREGUNTA" Style="{StaticResource SectionHeader}"/>
              <TextBlock Text="ID provisional" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding SelectedQuestion.Id, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,8" FontFamily="Consolas"/>
              <TextBlock Text="Texto (local → futuro dialog_es)" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding SelectedQuestion.TextLocal, UpdateSourceTrigger=PropertyChanged}"
                       TextChanged="Field_TextChanged" AcceptsReturn="True" Height="72" TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"/>
              <Expander Header="Avanzado (params / alternos)" IsExpanded="{Binding AdvancedExpanded}" Margin="0,0,0,8">
                <StackPanel Margin="0,8,0,0">
                  <TextBlock Text="params" Style="{StaticResource FieldLabel}"/>
                  <TextBox Text="{Binding SelectedQuestion.Params, UpdateSourceTrigger=PropertyChanged}"
                           TextChanged="Field_TextChanged" Margin="0,0,0,6" FontFamily="Consolas"/>
                  <TextBlock Text="alternos (raw)" Style="{StaticResource FieldLabel}"/>
                  <TextBox Text="{Binding SelectedQuestion.Alternos, UpdateSourceTrigger=PropertyChanged}"
                           TextChanged="Field_TextChanged" AcceptsReturn="True" Height="48" FontFamily="Consolas"/>
                </StackPanel>
              </Expander>
              <Button Content="+ Añadir respuesta" Command="{Binding AddResponseCommand}" Padding="8,5"/>
            </StackPanel>

            <!-- Response panel -->
            <StackPanel Visibility="{Binding HasResponse, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="RESPUESTA" Style="{StaticResource SectionHeader}"/>
              <TextBlock Text="Texto (local → futuro dialog_es)" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding SelectedResponse.TextLocal, UpdateSourceTrigger=PropertyChanged}"
                       TextChanged="Field_TextChanged" AcceptsReturn="True" Height="64" TextWrapping="Wrap" Margin="0,0,0,8"/>
              <WrapPanel Margin="0,0,0,8">
                <Button Content="Duplicar" Command="{Binding DuplicateResponseCommand}" Padding="8,4" Margin="0,0,6,4"/>
                <Button Content="Eliminar" Command="{Binding DeleteResponseCommand}" Padding="8,4" Margin="0,0,6,4"/>
                <Button Content="↑" Command="{Binding MoveResponseUpCommand}" Padding="8,4" Margin="0,0,6,4"/>
                <Button Content="↓" Command="{Binding MoveResponseDownCommand}" Padding="8,4" Margin="0,0,0,4"/>
              </WrapPanel>
              <TextBlock Text="Añadir acción" FontWeight="SemiBold" Margin="0,4,0,6"/>
              <WrapPanel>
                <Button Content="Ir a pregunta (1)" Command="{Binding AddGotoActionCommand}" Padding="8,4" Margin="0,0,6,4"
                        ToolTip="accion=1"/>
                <Button Content="Dar misión (44)" Command="{Binding AddQuestActionCommand}" Padding="8,4" Margin="0,0,6,4"
                        ToolTip="accion=44"/>
                <Button Content="Teleport (0)" Command="{Binding AddTeleportActionCommand}" Padding="8,4" Margin="0,0,6,4"
                        ToolTip="accion=0 · args mapa,celda"/>
                <Button Content="Acción avanzada" Command="{Binding AddAdvancedActionCommand}" Padding="8,4" Margin="0,0,0,4"/>
              </WrapPanel>
            </StackPanel>

            <!-- Action panel -->
            <StackPanel Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="ACCIÓN" Style="{StaticResource SectionHeader}"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="90"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="accion" Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedAction.Accion, UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="Field_TextChanged" Margin="0,0,0,6" FontFamily="Consolas"/>
                <TextBlock Grid.Row="1" Text="args" Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedAction.Args, UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="Field_TextChanged" Margin="0,0,0,6" FontFamily="Consolas"/>
                <TextBlock Grid.Row="2" Text="condicion" Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedAction.Condicion, UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="Field_TextChanged" Margin="0,0,0,8" FontFamily="Consolas"/>
              </Grid>

              <StackPanel Visibility="{Binding IsGotoAction, Converter={StaticResource BoolToVis}}" Margin="0,4,0,8">
                <TextBlock Text="Ramificación (accion=1)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Text="Enlazar pregunta existente" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding QuestionChoices}" SelectedItem="{Binding LinkTargetQuestion}"
                          Margin="0,0,0,6">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock>
                        <Run Text="#"/><Run Text="{Binding Id, Mode=OneWay}"/>
                        <Run Text=" — "/><Run Text="{Binding TextLocal, Mode=OneWay}"/>
                      </TextBlock>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <WrapPanel>
                  <Button Content="+ Crear pregunta y enlazar" Command="{Binding CreateLinkedQuestionCommand}"
                          Padding="8,4" Margin="0,0,6,0"/>
                  <Button Content="Quitar enlace" Command="{Binding ClearLinkCommand}" Padding="8,4"/>
                </WrapPanel>
              </StackPanel>

              <StackPanel Visibility="{Binding IsStartQuestAction, Converter={StaticResource BoolToVis}}" Margin="0,4,0,8">
                <TextBlock Text="Dar / iniciar misión (accion=44)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Text="Misión borrador" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding MissionChoices}" SelectedItem="{Binding LinkTargetMission}"
                          Margin="0,0,0,6">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Nombre}"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                           Text="Quest ID numérico se asignará en CONT.5. Args queda vacío hasta publicar."/>
              </StackPanel>

              <Button Content="Eliminar acción" Command="{Binding DeleteActionCommand}" Padding="8,5" Margin="0,4,0,0"/>
            </StackPanel>

            <TextBlock Margin="0,16,0,0" FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                       Text="Borradores locales. Sin INSERT BD. Sin dialog_es. Respuestas usan DraftId interno (IDs numéricos en CONT.5)."/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <TextBlock Grid.Row="2" Margin="0,10,0,0" FontSize="11" Foreground="{DynamicResource TextMuted}"
               Text="Escrituras BD: 0 · SFTP: 0 · Preguntas: lote global MAX+1 · Respuestas: sin MAX(90001)+1"/>
  </Grid>
</Window>
