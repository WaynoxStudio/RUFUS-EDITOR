<Window x:Class="RufusMapEditor.App.NpcGfxPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RufusMapEditor.App.Controls"
        Title="Elegir apariencia NPC"
        Height="620" Width="900"
        MinHeight="420" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <TextBlock x:Name="PreviewNote" TextWrapping="Wrap" FontSize="11"
                 Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Seleccionar" Padding="12,6" IsDefault="True" Click="Ok_Click"/>
        <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
      </DockPanel>
    </StackPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <Border x:Name="ClipsHintPanel" Background="{DynamicResource ElevatedSurface}"
              BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4"
              Padding="10,8" Margin="0,0,0,8" Visibility="Collapsed">
        <DockPanel LastChildFill="True">
          <Button DockPanel.Dock="Right" Content="Configurar" Padding="10,4" Margin="12,0,0,0"
                  Click="ConfigureClips_Click"/>
          <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                     Text="Configura la carpeta del cliente para mostrar nombres y vistas previas."/>
        </DockPanel>
      </Border>
      <TextBlock x:Name="StatusText" Margin="0,0,0,6" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
      <TextBox x:Name="SearchBox" Padding="6,4"
               Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}"
               TextChanged="SearchBox_TextChanged"
               ToolTip="GFX ID, nombre de apariencia o nombre de NPC"/>
    </StackPanel>
    <!-- UniformGrid Columns=3: 1 ListBoxItem = 1 GFX. Viewbox escala artwork al ancho de celda. -->
    <ListBox x:Name="ResultList"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.CanContentScroll="False"
             Background="{DynamicResource SurfaceBackground}"
             BorderBrush="{DynamicResource Border}"
             MouseDoubleClick="ResultList_MouseDoubleClick"
             SelectionChanged="ResultList_SelectionChanged">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="3"/>
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="VerticalContentAlignment" Value="Stretch"/>
          <Setter Property="Padding" Value="0"/>
          <Setter Property="Margin" Value="4"/>
          <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Card"
                        Background="{DynamicResource ElevatedSurface}"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="6,6,6,8"
                        SnapsToDevicePixels="True">
                  <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource SurfaceBackground}"/>
                  </Trigger>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                    <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource SurfaceBackground}"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
              <TextBlock Text="{Binding DisplayName}"
                         FontWeight="SemiBold"
                         FontSize="12"
                         TextAlignment="Center"
                         TextTrimming="CharacterEllipsis"
                         TextWrapping="NoWrap"/>
              <TextBlock Text="{Binding GfxIdLabel}"
                         FontFamily="Consolas"
                         FontSize="11"
                         TextAlignment="Center"
                         Foreground="{DynamicResource TextSecondary}"
                         Margin="0,2,0,0"/>
            </StackPanel>
            <!-- Viewbox: rellena el ancho de la celda; Stretch.Uniform en Image evita deformar/recortar. -->
            <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Stretch">
              <controls:LazyArtworkImage GfxId="{Binding GfxId}"
                                         UseNpcSpritePreview="False"
                                         Width="256" Height="256"/>
            </Viewbox>
          </DockPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
