<Window x:Class="RufusMapEditor.App.NpcGfxPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RufusMapEditor.App.Controls"
        Title="Elegir apariencia NPC"
        Height="560" Width="980"
        MinHeight="420" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <TextBlock x:Name="PreviewNote" TextWrapping="Wrap" FontSize="11"
                 Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Seleccionar" Padding="12,6" IsDefault="True" Click="Ok_Click"/>
        <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
      </DockPanel>
    </StackPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <Border x:Name="ClipsHintPanel" Background="{DynamicResource ElevatedSurface}"
              BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4"
              Padding="10,8" Margin="0,0,0,8" Visibility="Collapsed">
        <DockPanel LastChildFill="True">
          <Button DockPanel.Dock="Right" Content="Configurar" Padding="10,4" Margin="12,0,0,0"
                  Click="ConfigureClips_Click"/>
          <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                     Text="Configura la carpeta del cliente para mostrar nombres y previews."/>
        </DockPanel>
      </Border>
      <TextBlock x:Name="StatusText" Margin="0,0,0,6" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
      <TextBox x:Name="SearchBox" Padding="6,4"
               Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}"
               TextChanged="SearchBox_TextChanged"
               ToolTip="GFX ID, nombre de apariencia o nombre de NPC"/>
    </StackPanel>
    <Border DockPanel.Dock="Right" Width="220" Margin="12,0,0,0"
            Background="{DynamicResource ElevatedSurface}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6"
            Padding="12">
      <StackPanel>
        <TextBlock Text="Preview GFX" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="4"
                HorizontalAlignment="Center" Padding="8" Margin="0,0,0,10">
          <controls:LazyArtworkImage x:Name="PreviewSpriteImage"
                                     UseNpcSpritePreview="True"
                                     Width="160" Height="160"/>
        </Border>
        <TextBlock x:Name="PreviewNameText" FontWeight="SemiBold" TextWrapping="Wrap"
                   TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="PreviewGfxText" FontFamily="Consolas" FontSize="12"
                   Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
        <TextBlock x:Name="PreviewUsageText" FontSize="11"
                   Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"
                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="Sprite ingame · staticR" FontSize="10"
                   Foreground="{DynamicResource TextMuted}" Margin="0,8,0,0"/>
      </StackPanel>
    </Border>
    <ListBox x:Name="ResultList"
             VirtualizingPanel.IsVirtualizing="True"
             VirtualizingPanel.VirtualizationMode="Recycling"
             VirtualizingPanel.ScrollUnit="Pixel"
             ScrollViewer.CanContentScroll="True"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             Background="{DynamicResource SurfaceBackground}"
             BorderBrush="{DynamicResource Border}"
             MouseDoubleClick="ResultList_MouseDoubleClick"
             SelectionChanged="ResultList_SelectionChanged">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="Padding" Value="0"/>
          <Setter Property="Margin" Value="0,0,0,4"/>
          <Setter Property="Focusable" Value="False"/>
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Padding="8,6" Margin="0,0,3,0"
                    Background="{DynamicResource ElevatedSurface}" CornerRadius="4"
                    Cursor="Hand" MouseLeftButtonUp="GfxCard_MouseLeftButtonUp"
                    Tag="{Binding Left}">
              <Border.Style>
                <Style TargetType="Border">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Left}" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Hidden"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <DockPanel>
                <controls:LazyArtworkImage DockPanel.Dock="Left" GfxId="{Binding Left.GfxId}"
                                           UseNpcSpritePreview="False"
                                           Width="56" Height="56" Margin="0,0,8,0"/>
                <StackPanel>
                  <TextBlock Text="{Binding Left.DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Left.GfxIdLabel}" FontFamily="Consolas" FontSize="11"
                             Foreground="{DynamicResource TextSecondary}"/>
                  <TextBlock Text="{Binding Left.UsageSummary}" FontSize="11"
                             Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Grid.Column="1" Padding="8,6" Margin="3,0,0,0"
                    Background="{DynamicResource ElevatedSurface}" CornerRadius="4"
                    Cursor="Hand" MouseLeftButtonUp="GfxCard_MouseLeftButtonUp"
                    Tag="{Binding Right}">
              <Border.Style>
                <Style TargetType="Border">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Right}" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Hidden"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <DockPanel>
                <controls:LazyArtworkImage DockPanel.Dock="Left" GfxId="{Binding Right.GfxId}"
                                           UseNpcSpritePreview="False"
                                           Width="56" Height="56" Margin="0,0,8,0"/>
                <StackPanel>
                  <TextBlock Text="{Binding Right.DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Right.GfxIdLabel}" FontFamily="Consolas" FontSize="11"
                             Foreground="{DynamicResource TextSecondary}"/>
                  <TextBlock Text="{Binding Right.UsageSummary}" FontSize="11"
                             Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
