<Window x:Class="RufusMapEditor.App.GfxVisualSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Buscar GFX por imagen"
        Width="920" Height="640"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        PreviewKeyDown="Window_PreviewKeyDown">
  <DockPanel Margin="12">
    <Border DockPanel.Dock="Top" Background="{DynamicResource DialogHeaderBackground}" CornerRadius="6"
            BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="12,10" Margin="0,0,0,10">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
          <Border Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource BrandAccent}" Margin="0,0,10,0"/>
          <TextBlock Text="Buscar GFX por recorte" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="Pegar captura (Ctrl+V) o Abrir · recorta SOLO el ítem (poco fondo) · comparación local por color+forma (sin IA)."
                   FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,16,0"
                 Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
      <Button Content="Cancelar" IsCancel="True" Margin="0,0,8,0"/>
      <Button x:Name="UseButton" Content="Usar seleccionado" Style="{StaticResource PrimaryButton}"
              IsEnabled="False" Click="Use_Click"/>
    </StackPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.4*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
          <Button Content="Pegar captura" Click="Paste_Click" Padding="10,4" Margin="0,0,6,0"
                  ToolTip="Ctrl+V · captura del juego"/>
          <Button Content="Abrir…" Click="Open_Click" Padding="10,4" Margin="0,0,6,0"/>
          <Button Content="Limpiar" Click="ClearCrop_Click" Padding="10,4" Margin="0,0,12,0"
                  ToolTip="Quita la captura y el recorte para pegar otra"/>
          <ComboBox x:Name="ScopeBox" Width="140" VerticalAlignment="Center" Margin="0,0,8,0"
                    SelectedIndex="0">
            <ComboBoxItem Content="Capa actual"/>
            <ComboBoxItem Content="Suelos"/>
            <ComboBoxItem Content="Objetos"/>
            <ComboBoxItem Content="Fondos"/>
            <ComboBoxItem Content="Todo"/>
          </ComboBox>
          <Button x:Name="SearchButton" Content="Buscar" Style="{StaticResource PrimaryButton}"
                  Padding="12,4" Click="Search_Click" IsEnabled="False"/>
        </StackPanel>
        <ProgressBar x:Name="ProgressBar" DockPanel.Dock="Bottom" Height="4" Margin="0,6,0,0"
                     Visibility="Collapsed"/>
        <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4"
                Background="{DynamicResource SurfaceBackground}" ClipToBounds="True">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                        Background="Transparent">
            <Grid x:Name="ImageHost" Background="Transparent"
                  MouseLeftButtonDown="ImageHost_MouseLeftButtonDown"
                  MouseMove="ImageHost_MouseMove"
                  MouseLeftButtonUp="ImageHost_MouseLeftButtonUp"
                  MouseLeave="ImageHost_MouseLeave">
              <Image x:Name="SourceImage" Stretch="None" SnapsToDevicePixels="True"/>
              <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False"/>
            </Grid>
          </ScrollViewer>
        </Border>
      </DockPanel>

      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" Text="Candidatos" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <ListBox x:Name="ResultsList" Background="{DynamicResource SurfaceBackground}"
                 BorderBrush="{DynamicResource Border}" BorderThickness="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="ResultsList_MouseDoubleClick"
                 SelectionChanged="ResultsList_SelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Width="120" Height="132" Margin="4" Padding="4" CornerRadius="4"
                      Background="{DynamicResource ThumbBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                <StackPanel>
                  <Border Height="80" Background="{DynamicResource CheckerA}" CornerRadius="3" ClipToBounds="True">
                    <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                  </Border>
                  <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontFamily="Consolas" FontSize="11"
                             Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,0"/>
                  <TextBlock Text="{Binding ScoreText}" HorizontalAlignment="Center" FontSize="10"
                             Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel/>
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
        </ListBox>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
