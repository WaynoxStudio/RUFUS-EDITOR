<Window x:Class="RufusMapEditor.App.ClipsSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ruta de clips / previews"
        Width="560" Height="280"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
               Text="Carpeta del cliente DOFUS Retro (…/retroclient/clips). Debe contener sprites\sprites.xml."/>
    <TextBlock Text="Carpeta clips" FontWeight="SemiBold" Margin="0,0,0,6"/>
    <DockPanel Grid.Row="1" Margin="0,0,0,8">
      <Button DockPanel.Dock="Right" Content="Buscar…" Padding="10,4" Margin="8,0,0,0" Click="Browse_Click"/>
      <TextBox x:Name="PathBox" Padding="6,4"/>
    </DockPanel>
    <TextBlock x:Name="StatusText" Grid.Row="2" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <TextBlock Grid.Row="3" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondary}"
               Text="Las miniaturas se generan bajo demanda y se guardan en Library/cache/artworks/{gfxID}.png (clave = gfxID)."/>
    <DockPanel Grid.Row="4">
      <Button DockPanel.Dock="Left" Content="Vaciar caché de previews" Padding="10,4" Click="ClearCache_Click"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancelar" Width="100" Margin="0,0,8,0" Padding="8,4" IsCancel="True" Click="Cancel_Click"/>
        <Button Content="Guardar" Width="100" Padding="8,4" Style="{StaticResource PrimaryButton}"
                IsDefault="True" Click="Save_Click"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
