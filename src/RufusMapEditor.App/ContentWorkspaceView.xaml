<UserControl x:Class="RufusMapEditor.App.ContentWorkspaceView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RufusMapEditor.App.ViewModels"
        xmlns:ctrl="clr-namespace:RufusMapEditor.App.Controls"
        xmlns:content="clr-namespace:RufusMapEditor.LegacyCompatibility.Content;assembly=RufusMapEditor.LegacyCompatibility"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource AppFontFamily}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style x:Key="AccordionStatus" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="12,0,0,0"/>
      <Setter Property="Foreground" Value="{DynamicResource HeaderForeground}"/>
      <Setter Property="Opacity" Value="0.85"/>
    </Style>
    <Style x:Key="ListColumnHeader" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
      <Setter Property="Margin" Value="4,0"/>
    </Style>
    <Style x:Key="SectionBlockHeader" TargetType="Border" BasedOn="{StaticResource BrownHeaderBar}">
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="10,7"/>
    </Style>
  </UserControl.Resources>

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource DialogHeaderBackground}" CornerRadius="4"
            BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="12,10" Margin="0,0,0,10">
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Top">
          <Button Content="Leer MAX" Command="{Binding RefreshMaxCommand}" Style="{StaticResource SecondaryButton}"
                  Padding="10,4" Margin="0,0,8,0" ToolTip="SELECT MAX (solo lectura)"/>
          <Button Content="Publicar cliente" Command="{Binding PublishClientCommand}" Style="{StaticResource PrimaryButton}"
                  Padding="12,5" Margin="0,0,8,0"
                  ToolTip="CONT.8 · dialog_es + npc_es N+1 por SFTP · una sola actualización versions_es · no escribe BD"/>
          <Button Content="Publicar contenido en BD" Command="{Binding PublishCommand}" Style="{StaticResource PrimaryButton}"
                  Padding="12,5" Margin="0,0,8,0"
                  ToolTip="CONT.5 · NPC/diálogos/ubicaciones. Publicación segura de misiones nuevas: ADMIN.UI.4C (pendiente)."/>
          <Button x:Name="CloseButton" Content="✕" Style="{StaticResource DeleteButton}"
                  IsCancel="True" Padding="10,4" MinWidth="32" Click="Close_Click" ToolTip="Cerrar"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Contenido" FontWeight="SemiBold" FontSize="16"
                     Foreground="{DynamicResource HeaderForeground}"/>
          <TextBlock Text="{Binding StatusText}" FontSize="11"
                     Foreground="{DynamicResource HeaderForeground}" Opacity="0.85"
                     TextWrapping="Wrap" Margin="0,2,0,8"/>
          <WrapPanel x:Name="LocalConnectionPanel">
            <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4"
                    Padding="10,6" Margin="0,0,10,6" Background="{DynamicResource PanelBackground}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="BD" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="{Binding DatabaseStatusLabel}" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{DynamicResource TextPrimary}" ToolTip="{Binding DatabaseDetail}"/>
                <Button Content="Comprobar BD" Command="{Binding CheckDatabaseCommand}" Style="{StaticResource SecondaryButton}"
                        Padding="8,3" ToolTip="SELECT 1 · misma configuración global que Mapas · solo lectura"/>
              </StackPanel>
            </Border>
            <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4"
                    Padding="10,6" Margin="0,0,0,6" Background="{DynamicResource PanelBackground}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="SFTP" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="{Binding SftpStatusLabel}" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{DynamicResource TextPrimary}" ToolTip="{Binding SftpDetail}"/>
                <Button Content="Comprobar SFTP" Command="{Binding CheckSftpCommand}" Style="{StaticResource SecondaryButton}"
                        Padding="8,3" ToolTip="Acceso RO a lang/ y swf/ · misma configuración global que Mapas"/>
              </StackPanel>
            </Border>
          </WrapPanel>
          <StackPanel x:Name="LocalConnectionDetails">
            <TextBlock FontSize="10" Foreground="{DynamicResource HeaderForeground}" Opacity="0.7"
                       TextWrapping="Wrap" Margin="0,2,0,0" Text="{Binding DatabaseDetail}"/>
            <TextBlock FontSize="10" Foreground="{DynamicResource HeaderForeground}" Opacity="0.7"
                       TextWrapping="Wrap" Text="{Binding SftpDetail}"/>
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource Border}"
              BorderThickness="1" CornerRadius="4" Padding="0">
        <Grid DataContext="{Binding Npc}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Style="{StaticResource BrownHeaderBar}" CornerRadius="4,4,0,0">
            <TextBlock Text="Lista de NPCs" Style="{StaticResource BrownHeaderText}"/>
          </Border>

          <DockPanel Grid.Row="1" Margin="8,8,8,6">
            <Button DockPanel.Dock="Right" Content="+ Nuevo NPC" Style="{StaticResource PrimaryButton}"
                    Command="{Binding DataContext.NewNpcCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Padding="10,5" Margin="8,0,0,0"/>
            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8,5" VerticalContentAlignment="Center"
                     ToolTip="buscar..."/>
          </DockPanel>

          <Grid Grid.Row="2" Margin="8,0,8,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="52"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Estado" Style="{StaticResource ListColumnHeader}"/>
            <TextBlock Grid.Column="1" Text="Nombre" Style="{StaticResource ListColumnHeader}"/>
          </Grid>

          <ListBox Grid.Row="3" ItemsSource="{Binding FilteredItems}" SelectedItem="{Binding Selected}"
                   BorderThickness="0" Background="Transparent" Margin="4,0">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:NpcDraftItemViewModel}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"
                             Text="{Binding Id, Mode=OneWay}"/>
                  <TextBlock Grid.Column="1" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" Text="{Binding Nombre, Mode=OneWay}"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Grid.Row="4" HorizontalAlignment="Right" Margin="8,4,8,4"
                     FontSize="11" Foreground="{DynamicResource TextMuted}"
                     Text="{Binding ItemCountLabel}"/>

          <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="8,0,8,8">
            <Button Content="Duplicar" Style="{StaticResource SecondaryButton}"
                    Command="{Binding DataContext.DuplicateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Padding="10,4" Margin="0,0,8,0"/>
            <Button Content="Eliminar" Style="{StaticResource DeleteButton}"
                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Padding="10,4"/>
          </StackPanel>
        </Grid>
      </Border>

      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    IsEnabled="{Binding EditorEnabled}">
        <StackPanel Margin="0,0,4,0">
          <TextBlock Margin="0,0,0,8" TextWrapping="Wrap"
                     Foreground="{DynamicResource BrandAccent}"
                     Visibility="{Binding HasIncompleteDialogResponses, Converter={StaticResource BoolToVis}}"
                     Text="⚠ Respuesta sin acción: añade al menos una acción antes de publicar."/>

          <!-- 1. IDENTIDAD -->
          <Expander Style="{StaticResource ContentAccordionExpander}" IsExpanded="{Binding IdentityExpanded, Mode=TwoWay}">
            <Expander.Header>
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource AccordionStatus}"
                           Text="{Binding IdentitySectionStatus}"/>
                <TextBlock Text="1. IDENTIDAD" FontWeight="SemiBold" FontSize="13"/>
              </DockPanel>
            </Expander.Header>
            <Border Padding="12,8,12,12">
              <StackPanel>
                <!-- ADMIN.UI.4B.2A.2 — Identidad: ID+Nombre, GFX+Sexo, Tamaño+Accesorios+Acciones -->
                <Grid DataContext="{Binding Npc.Selected}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="0" Text="ID" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                  <TextBlock Grid.Row="0" Grid.Column="2" Text="Nombre" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding IdDisplay, Mode=OneWay}"
                             FontFamily="Consolas" FontSize="13" VerticalAlignment="Center"
                             Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"
                             ToolTip="ID provisional · solo lectura · MAX(real)+1"/>
                  <ctrl:NpcNameAiField Grid.Row="1" Grid.Column="2"
                                       Margin="0,0,0,8" VerticalAlignment="Center"
                                       Nombre="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                                       AiAssistant="{Binding DataContext.AiAssistant, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       IsEditorEnabled="{Binding DataContext.EditorEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="GFX" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                  <TextBlock Grid.Row="2" Grid.Column="2" Text="Sexo" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                  <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,8">
                    <Border Padding="10" CornerRadius="6"
                            Background="{DynamicResource ElevatedSurface}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1">
                      <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Bottom" Content="Elegir apariencia"
                                Command="{Binding DataContext.Npc.PickGfxAppearanceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="0,8,0,0"
                                HorizontalAlignment="Left"
                                ToolTip="Galería de apariencias confirmadas en npcs_modelo"/>
                        <DockPanel>
                          <ctrl:LazyArtworkImage DockPanel.Dock="Left" GfxId="{Binding GfxId}"
                                                     UseNpcSpritePreview="False"
                                                     Width="64" Height="64" Margin="0,0,10,0"/>
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding GfxDisplayName, Mode=OneWay}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding GfxIdTechnicalLabel, Mode=OneWay}" FontFamily="Consolas" FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding GfxUsageHint, Mode=OneWay}" FontSize="11"
                                       Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                        </DockPanel>
                      </DockPanel>
                    </Border>
                    <Expander Header="Vista técnica · GFX ID" FontSize="11"
                              Foreground="{DynamicResource TextMuted}" Margin="0,6,0,0">
                      <TextBox Text="{Binding GfxId, UpdateSourceTrigger=PropertyChanged}"
                               Margin="0,6,0,0" FontFamily="Consolas" VerticalAlignment="Center"
                               ToolTip="Edición manual del gfxID (publica a npcs_modelo.gfxID)"/>
                    </Expander>
                  </StackPanel>
                  <ComboBox Grid.Row="3" Grid.Column="2"
                            ItemsSource="{x:Static vm:NpcDraftItemViewModel.SexoUiOptions}"
                            SelectedItem="{Binding SexoUi, Mode=TwoWay}"
                            Margin="0,0,0,8" VerticalAlignment="Center"/>

                  <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="72"/>
                      <ColumnDefinition Width="12"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="12"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Tamaño" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Column="2" Text="Accesorios" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Column="4" Text="Acciones" Style="{StaticResource FieldLabel}"/>
                  </Grid>
                  <Grid Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="72"/>
                      <ColumnDefinition Width="12"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="12"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding Tamaño, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas" VerticalAlignment="Center" MaxWidth="72"/>
                    <TextBox Grid.Column="2"
                             Text="{Binding Accesorios, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas" VerticalAlignment="Center"/>
                    <ctrl:NpcClientActionsPicker Grid.Column="4"
                                                 Actions="{Binding ClientActions}"
                                                 DisplayText="{Binding ClientActionsCompactSummary}"/>
                  </Grid>

                  <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
                             Text="{Binding UnequalScaleHint}" FontSize="11"
                             Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"
                             Visibility="{Binding ShowUnequalScaleHint, Converter={StaticResource BoolToVis}}"/>

                  <Grid Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,0"
                        Visibility="{Binding ShowCommerceFields, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="130"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Ventas" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Ventas, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,6" FontFamily="Consolas"/>
                    <TextBlock Grid.Row="1" Text="ObjetoCompra" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ObjetoCompra, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas"/>
                  </Grid>
                </Grid>
              </StackPanel>
            </Border>
          </Expander>

          <!-- 2. INTERACCIONES Y DIÁLOGO -->
          <Expander Style="{StaticResource ContentAccordionExpander}" IsExpanded="{Binding InteractionsExpanded, Mode=TwoWay}">
            <Expander.Header>
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource AccordionStatus}"
                           Text="{Binding InteractionsSectionStatus}"/>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="2. INTERACCIONES Y DIÁLOGO" FontWeight="SemiBold" FontSize="13"/>
                  <TextBlock Text="  · OBLIGATORIO" FontWeight="SemiBold" FontSize="12"
                             Foreground="{DynamicResource BrandAccent}" VerticalAlignment="Center"/>
                </StackPanel>
              </DockPanel>
            </Expander.Header>
            <Border Padding="12,8,12,12">
              <StackPanel>
                <TextBlock Text="DIÁLOGO" FontWeight="SemiBold" Margin="0,0,0,8"/>

                <!-- ADMIN.UI.3.2 — Generar diálogo / conversación + resultados en sección 2 -->
                <Border Margin="0,0,0,12" Padding="10"
                        BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6"
                        Background="{DynamicResource ElevatedSurface}"
                        DataContext="{Binding AiAssistant}"
                        Visibility="{Binding DataContext.EditorEnabled, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                  <StackPanel>
                    <TextBlock Text="ASISTENTE IA · DIÁLOGO" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Usa la misma configuración creativa de Identidad (actitud, contexto…). Resultados aquí, junto al diálogo del NPC."/>
                    <WrapPanel Margin="0,0,0,8">
                      <Button Content="✨ Generar diálogo" Command="{Binding GenerateDialogCommand}"
                              Padding="12,6" Margin="0,0,8,6"
                              ToolTip="Genera texto de diálogo simple · aplica al borrador con Usar"/>
                      <Button Content="✨ Generar conversación" Command="{Binding GenerateConversationCommand}"
                              Padding="12,6" Margin="0,0,8,6"
                              ToolTip="1 frase NPC + exactamente 3 respuestas del jugador"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Foreground="{DynamicResource BrandAccent}"
                               Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}"/>

                    <Border Visibility="{Binding ShowInteractionsAiResult, Converter={StaticResource BoolToVis}}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6"
                            Padding="10" Margin="0,0,0,8" Background="{DynamicResource PanelBackground}">
                      <StackPanel>
                        <TextBlock Text="{Binding ValidationDebugText}" FontSize="11" FontFamily="Consolas"
                                   Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8" TextWrapping="Wrap"/>

                        <StackPanel Visibility="{Binding HasDialoguePreview, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                          <TextBlock Text="DIÁLOGO GENERADO" FontWeight="SemiBold" Margin="0,0,0,6"/>
                          <TextBlock Text="Texto generado" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                          <TextBox Text="{Binding DialoguePreviewText, Mode=OneWay}" IsReadOnly="True"
                                   TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" Margin="0,0,0,8"/>
                          <StackPanel Orientation="Horizontal">
                            <Button Content="Usar" Command="{Binding UseDialogueCommand}"
                                    Padding="10,4" Margin="0,0,8,0"
                                    ToolTip="Aplicar texto al diálogo del borrador (no publica · no crea D.q)"/>
                            <Button Content="Regenerar" Command="{Binding RegenerateCommand}" Padding="10,4"
                                    ToolTip="Nueva generación · no aplica al NPC"/>
                          </StackPanel>
                        </StackPanel>

                        <StackPanel Visibility="{Binding HasConversationPreview, Converter={StaticResource BoolToVis}}">
                          <TextBlock Text="CONVERSACIÓN GENERADA" FontWeight="SemiBold" Margin="0,0,0,6"/>
                          <TextBlock Text="NPC:" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                          <TextBox Text="{Binding ConversationNpcText, Mode=OneWay}" IsReadOnly="True"
                                   TextWrapping="Wrap" AcceptsReturn="True" MinHeight="48" Margin="0,0,0,8"/>
                          <TextBlock Text="RESPUESTAS:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                          <ItemsControl ItemsSource="{Binding ConversationReplyItems}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border Padding="0,0,0,6">
                                  <StackPanel>
                                    <TextBlock Text="{Binding Display}" TextWrapping="Wrap"/>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}">
                                      <Run Text="tono: "/><Run Text="{Binding Tono, Mode=OneWay}"/>
                                    </TextBlock>
                                  </StackPanel>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Usar conversación" Command="{Binding UseConversationCommand}"
                                    Padding="10,4" Margin="0,0,8,0"
                                    ToolTip="Aplicar textos creativos al modo interactivo (preserva acciones técnicas)"/>
                            <Button Content="Regenerar" Command="{Binding RegenerateCommand}" Padding="10,4"
                                    ToolTip="Nueva generación · no aplica al NPC"/>
                          </StackPanel>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Border>

                <Border MinHeight="420" BorderBrush="{DynamicResource Border}" BorderThickness="0">
                  <ctrl:ContentDialogEditorPanel DataContext="{Binding Dialogs}"/>
                </Border>
              </StackPanel>
            </Border>
          </Expander>

          <!-- 3. UBICACIONES -->
          <Expander Style="{StaticResource ContentAccordionExpander}" IsExpanded="{Binding LocationsExpanded, Mode=TwoWay}">
            <Expander.Header>
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource AccordionStatus}"
                           Text="{Binding LocationsSectionStatus}"/>
                <TextBlock Text="3. UBICACIONES" FontWeight="SemiBold" FontSize="13"/>
              </DockPanel>
            </Expander.Header>
            <Border Padding="12,8,12,12">
              <StackPanel DataContext="{Binding Npc.Selected}">
                <DockPanel Margin="0,0,0,8">
                  <Button DockPanel.Dock="Right" Content="+ Añadir ubicación"
                          Command="{Binding DataContext.Npc.AddLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          Padding="10,5" Click="AddLocation_Click"/>
                  <TextBlock Text="Mapa · Celda · Orientación · Condición"
                             FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Locations}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type content:NpcLocationDraft}">
                      <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6"
                              Padding="10" Margin="0,0,0,8" Background="{DynamicResource ElevatedSurface}">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="100"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Mapa ID" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MapId, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,6" FontFamily="Consolas" TextChanged="LocationField_Changed"/>
                            <TextBlock Grid.Row="1" Text="Celda" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CellId, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,6" FontFamily="Consolas" TextChanged="LocationField_Changed"/>
                            <TextBlock Grid.Row="2" Text="Orientación" Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Top" Margin="0,8,0,0"/>
                            <ctrl:NpcOrientationPicker Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"
                                                         Orientation="{Binding Orientation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         OrientationEdited="OrientationPicker_Edited"/>
                            <TextBlock Grid.Row="3" Text="Condición" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Condition, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas" TextChanged="LocationField_Changed"/>
                          </Grid>
                          <Button Grid.Column="1" Content="Eliminar" VerticalAlignment="Top" Margin="8,0,0,0"
                                  Padding="8,4" Tag="{Binding}" Click="RemoveLocation_Click"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                           Text="nombre en npcs_ubicacion = nombre del NPC (automático al publicar)."/>
              </StackPanel>
            </Border>
          </Expander>

          <!-- 4. MISIÓN -->
          <Expander Style="{StaticResource ContentAccordionExpander}" IsExpanded="{Binding MissionExpanded, Mode=TwoWay}">
            <Expander.Header>
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource AccordionStatus}"
                           Text="{Binding MissionSectionStatus}"/>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="4. MISIÓN" FontWeight="SemiBold" FontSize="13"/>
                  <TextBlock Text="  · OPCIONAL" FontSize="12"
                             Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                </StackPanel>
              </DockPanel>
            </Expander.Header>
            <Border Padding="12,8,12,12">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10"
                            Visibility="{Binding ShowCreateMissionCta, Converter={StaticResource BoolToVis}}">
                  <TextBlock Text="Configura una misión asociada a este NPC." Margin="0,0,0,10"
                             Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                  <Button Content="+ Crear misión" Command="{Binding CreateMissionCommand}"
                          Padding="14,6" HorizontalAlignment="Left"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10"
                            Visibility="{Binding HasMission, Converter={StaticResource BoolToVis}}">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Quitar misión" Command="{Binding RemoveMissionCommand}"
                            Padding="10,4"/>
                    <TextBlock Text="Misión del NPC (borrador local · sin escritura BD al editar)"
                               VerticalAlignment="Center" FontWeight="SemiBold"/>
                  </DockPanel>
                </StackPanel>
                <Grid Visibility="{Binding HasMission, Converter={StaticResource BoolToVis}}" MinHeight="360">
                  <ctrl:ContentMissionEditorPanel DataContext="{Binding Missions}"/>
                </Grid>
              </DockPanel>
            </Border>
          </Expander>

          <!-- 5. REVISIÓN Y PUBLICACIÓN -->
          <Expander Style="{StaticResource ContentAccordionExpander}" IsExpanded="{Binding ReviewExpanded, Mode=TwoWay}">
            <Expander.Header>
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource AccordionStatus}"
                           Text="{Binding ReviewSectionStatus}"/>
                <TextBlock Text="5. REVISIÓN Y PUBLICACIÓN" FontWeight="SemiBold" FontSize="13"/>
              </DockPanel>
            </Expander.Header>
            <Border Padding="12,8,12,12">
              <StackPanel>
                <TextBlock Text="Resumen del borrador" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding ReviewLines}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,6">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding Mark}" FontWeight="SemiBold"
                                     Margin="16,0,0,0" Foreground="{DynamicResource TextSecondary}"/>
                          <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Margin="0,12,0,0" FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                           Text="Borrador ≠ publicado. quests_es pendiente. Publicación segura de misiones BD: ADMIN.UI.4C."/>
                <WrapPanel Margin="0,12,0,0">
                  <Button Content="Publicar cliente (CONT.8)" Command="{Binding PublishClientCommand}"
                          Padding="12,6" Margin="0,0,8,0"
                          ToolTip="dialog_es + npc_es · no escribe BD · no quests_es"/>
                  <Button Content="Publicar contenido en BD (CONT.5)" Command="{Binding PublishCommand}"
                          Padding="12,6"
                          ToolTip="NPC/diálogos/ubicaciones. Misiones nuevas: fase ADMIN.UI.4C."/>
                </WrapPanel>
              </StackPanel>
            </Border>
          </Expander>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <TextBlock Grid.Row="2" Margin="0,10,0,0" FontSize="11"
               Foreground="{DynamicResource ChromeForegroundMuted}"
               Text="Flujo · Identidad → Interacciones → Ubicaciones → Misión → Revisión · Cliente = CONT.8 · BD = CONT.5"/>
  </Grid>
</UserControl>