<UserControl x:Class="RufusMapEditor.App.ContentWorkspaceView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RufusMapEditor.App.ViewModels"
        xmlns:ctrl="clr-namespace:RufusMapEditor.App.Controls"
        xmlns:app="clr-namespace:RufusMapEditor.App"
        xmlns:content="clr-namespace:RufusMapEditor.LegacyCompatibility.Content;assembly=RufusMapEditor.LegacyCompatibility"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource AppFontFamily}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <Style x:Key="LibraryModeChip" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
      <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackground}"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Margin" Value="0,0,8,4"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource HeaderForeground}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style x:Key="AccordionStatus" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="12,0,0,0"/>
      <Setter Property="Foreground" Value="{DynamicResource HeaderForeground}"/>
      <Setter Property="Opacity" Value="0.85"/>
    </Style>
    <Style x:Key="ListColumnHeader" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
      <Setter Property="Margin" Value="4,0"/>
    </Style>
    <Style x:Key="SectionBlockHeader" TargetType="Border" BasedOn="{StaticResource BrownHeaderBar}">
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="10,7"/>
    </Style>
    <Style x:Key="GfxPickerImageButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SecondaryButtonBackground}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="GfxIdLinkButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource BrandAccent}"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.5"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource DialogHeaderBackground}" CornerRadius="4"
            BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="10,8" Margin="0,0,0,8"
            TextElement.Foreground="{DynamicResource HeaderForeground}">
      <DockPanel LastChildFill="True">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
          <TextBlock Text="{Binding ClientPublishStatusLabel}" FontSize="11" VerticalAlignment="Center"
                     Margin="0,0,10,0" Foreground="{DynamicResource HeaderOnBrownSubtle}"
                     Visibility="{Binding ShowClientPublishStatus, Converter={StaticResource BoolToVis}}"/>
          <TextBlock Text="{Binding BdPublishStatusLabel}" FontSize="11" VerticalAlignment="Center"
                     Margin="0,0,10,0" Foreground="{DynamicResource HeaderOnBrownSubtle}"
                     Visibility="{Binding ShowBdPublishStatus, Converter={StaticResource BoolToVis}}"/>
          <Button Content="Leer MAX" Command="{Binding RefreshMaxCommand}" Style="{StaticResource SecondaryButton}"
                  Padding="8,4" Margin="0,0,6,0"
                  ToolTip="SELECT MAX(id) · npcs_modelo / npc_preguntas / npc_respuestas / misiones / mision_etapas / mision_objetivos. Muestra un aviso si MySQL falla."/>
          <Button Content="Publicar cliente" Command="{Binding PublishClientCommand}" Style="{StaticResource PrimaryButton}"
                  Padding="10,4" Margin="0,0,6,0"
                  Visibility="{Binding ShowPublishClientButton, Converter={StaticResource BoolToVis}}"
                  IsEnabled="{Binding EnablePublishClientButton}"
                  ToolTip="Sube SWF (dialog_es / npc_es / quests_es) por SFTP. Con diálogo simple nuevo: haz esto ANTES que BD."/>
          <Button Content="Publicar contenido en BD" Command="{Binding PublishCommand}" Style="{StaticResource PrimaryButton}"
                  Padding="10,4" Margin="0,0,6,0"
                  Visibility="{Binding ShowPublishBdButton, Converter={StaticResource BoolToVis}}"
                  IsEnabled="{Binding EnablePublishBdButton}"
                  ToolTip="Escribe NPC/diálogos/misiones en MySQL. Si está deshabilitado (BD requiere revisión), publica primero el cliente (dialog_es)."/>
          <Button x:Name="CloseButton" Content="✕" Style="{StaticResource DeleteButton}"
                  IsCancel="True" Padding="8,3" MinWidth="28" Click="Close_Click" ToolTip="Cerrar"/>
        </StackPanel>
        <StackPanel VerticalAlignment="Center">
          <DockPanel Margin="0,0,0,2">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
              <TextBlock Text="Contenido" FontWeight="SemiBold" FontSize="15"
                         Foreground="{DynamicResource HeaderForeground}" VerticalAlignment="Center"/>
              <Button Content="Editor" Command="{Binding ShowEditorCommand}" Style="{StaticResource SecondaryButton}"
                      Padding="8,3" Margin="12,0,4,0" ToolTip="Editor del NPC seleccionado"/>
              <Button Content="Biblioteca" Command="{Binding ShowLibraryCommand}" Style="{StaticResource SecondaryButton}"
                      Padding="8,3" ToolTip="Todo el workspace local (workspace.json)"/>
            </StackPanel>
            <TextBlock Text="{Binding StatusText}" FontSize="11"
                       Foreground="{DynamicResource HeaderOnBrownSubtle}"
                       TextTrimming="CharacterEllipsis" Margin="12,2,0,0"
                       VerticalAlignment="Center" DockPanel.Dock="Left"
                       Visibility="{Binding ShowEditor, Converter={StaticResource BoolToVis}}"/>
          </DockPanel>
          <WrapPanel x:Name="LocalConnectionPanel">
            <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4"
                    Padding="10,6" Margin="0,0,10,6" Background="{DynamicResource PanelBackground}"
                    TextElement.Foreground="{DynamicResource TextPrimary}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="BD" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="{Binding DatabaseStatusLabel}" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{DynamicResource TextPrimary}" ToolTip="{Binding DatabaseDetail}"/>
                <Button Content="Comprobar BD" Command="{Binding CheckDatabaseCommand}" Style="{StaticResource SecondaryButton}"
                        Padding="8,3" ToolTip="SELECT 1 · misma configuración global que Mapas · solo lectura"/>
              </StackPanel>
            </Border>
            <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4"
                    Padding="10,6" Margin="0,0,0,6" Background="{DynamicResource PanelBackground}"
                    TextElement.Foreground="{DynamicResource TextPrimary}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="SFTP" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="{Binding SftpStatusLabel}" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{DynamicResource TextPrimary}" ToolTip="{Binding SftpDetail}"/>
                <Button Content="Comprobar SFTP" Command="{Binding CheckSftpCommand}" Style="{StaticResource SecondaryButton}"
                        Padding="8,3" ToolTip="Acceso RO a lang/ y swf/ · misma configuración global que Mapas"/>
              </StackPanel>
            </Border>
          </WrapPanel>
          <StackPanel x:Name="LocalConnectionDetails">
            <TextBlock FontSize="10" Foreground="{DynamicResource HeaderOnBrownSubtle}"
                       TextWrapping="Wrap" Margin="0,2,0,0" Text="{Binding DatabaseDetail}"/>
            <TextBlock FontSize="10" Foreground="{DynamicResource HeaderOnBrownSubtle}"
                       TextWrapping="Wrap" Text="{Binding SftpDetail}"/>
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <!-- Biblioteca — proyección de workspace.json -->
      <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource Border}"
              BorderThickness="1" CornerRadius="4" Padding="10"
              DataContext="{Binding Library}">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding DataContext.ShowLibrary, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Biblioteca" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"
                       DockPanel.Dock="Left" Foreground="{DynamicResource TextPrimary}"/>
            <Button Content="Actualizar" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}"
                    Padding="8,3" DockPanel.Dock="Right" Margin="8,0,0,0"/>
            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Padding="8,4"
                     VerticalContentAlignment="Center" Margin="16,0,0,0"
                     ToolTip="Nombre · NPC ID · Quest ID"/>
          </DockPanel>

          <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="{Binding CountersLine}" FontSize="11" Margin="0,0,0,6"
                       Foreground="{DynamicResource TextMuted}"/>
            <WrapPanel Margin="0,0,0,4">
              <RadioButton Content="NPC + Diálogo" GroupName="LibraryMode" IsChecked="{Binding IsNpcAndDialogMode, Mode=OneWay}"
                           Style="{StaticResource LibraryModeChip}"
                           Command="{Binding SetModeCommand}" CommandParameter="NpcAndDialog"
                           ToolTip="Un bloque por NPC · diálogo incluido · no aparece en Misiones"/>
              <RadioButton Content="Misiones" GroupName="LibraryMode" IsChecked="{Binding IsMissionsMode, Mode=OneWay}"
                           Style="{StaticResource LibraryModeChip}"
                           Command="{Binding SetModeCommand}" CommandParameter="Missions"
                           ToolTip="Solo misiones · NPC+diálogo no se listan aquí"/>
            </WrapPanel>
            <WrapPanel>
              <Button Content="Todos" Command="{Binding SetFilterCommand}" CommandParameter="All"
                      Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="0,0,6,4"/>
              <Button Content="Borradores" Command="{Binding SetFilterCommand}" CommandParameter="Drafts"
                      Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="0,0,6,4"/>
              <Button Content="Cambios pendientes" Command="{Binding SetFilterCommand}" CommandParameter="PendingChanges"
                      Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="0,0,6,4"/>
              <Button Content="Publicados" Command="{Binding SetFilterCommand}" CommandParameter="Published"
                      Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="0,0,6,4"/>
              <Button Content="{Binding EmptyLinkFilterLabel}" Command="{Binding SetFilterCommand}"
                      CommandParameter="WithoutStartNpc"
                      Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="0,0,6,4"/>
            </WrapPanel>
            <DockPanel Margin="0,4,0,0">
              <TextBlock Text="{Binding SelectionLine}" FontSize="11" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextMuted}" DockPanel.Dock="Left"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Seleccionar borradores" Command="{Binding SelectVisibleDraftsCommand}"
                        Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="0,0,6,0" FontSize="11"
                        ToolTip="Marca solo borradores no publicados visibles"/>
                <Button Content="Limpiar selección" Command="{Binding ClearSelectionCommand}"
                        Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="0,0,6,0" FontSize="11"/>
                <Button Content="{Binding RemoveCheckedLabel}" Command="{Binding RemoveCheckedCommand}"
                        Style="{StaticResource DeleteButton}" Padding="8,3" FontSize="11"
                        ToolTip="Elimina borradores / quita copias locales seleccionadas · sin tocar producción"/>
              </StackPanel>
            </DockPanel>
          </StackPanel>

          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
            <ItemsControl ItemsSource="{Binding Sections}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ContentLibrarySectionVm}">
                  <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                               Margin="0,8,0,6" TextTrimming="CharacterEllipsis">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="FontSize" Value="13"/>
                          <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSubSection}" Value="True">
                              <Setter Property="FontSize" Value="12"/>
                              <Setter Property="Margin" Value="8,4,0,6"/>
                              <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Cards}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ContentLibraryCardVm}">
                          <Border Width="280" MinHeight="128" Margin="0,0,12,12" Padding="0"
                                  CornerRadius="10" BorderThickness="1"
                                  Background="{DynamicResource PanelElevated}"
                                  TextElement.Foreground="{DynamicResource TextPrimary}"
                                  Cursor="Hand"
                                  ToolTipService.InitialShowDelay="400"
                                  ToolTipService.ShowDuration="60000"
                                  ToolTipService.BetweenShowDelay="100"
                                  MouseLeftButtonDown="LibraryCard_MouseLeftButtonDown">
                            <Border.Effect>
                              <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.10" Direction="270"/>
                            </Border.Effect>
                            <Border.ToolTip>
                              <ToolTip MaxWidth="380">
                                <TextBlock Text="{Binding Entry.HoverTooltip}" TextWrapping="Wrap"
                                           FontSize="12" LineHeight="18"
                                           Foreground="{DynamicResource TextPrimary}"/>
                              </ToolTip>
                            </Border.ToolTip>
                            <Border.Style>
                              <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
                                <Style.Triggers>
                                  <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource BrandAccent}"/>
                                  </Trigger>
                                  <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource BrandAccent}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                              </Grid.ColumnDefinitions>
                              <Border Grid.Column="0" Background="{DynamicResource BrandAccent}"
                                      CornerRadius="10,0,0,10"/>
                              <Grid Grid.Column="1" Margin="12,10,12,10">
                              <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                              </Grid.RowDefinitions>
                              <DockPanel LastChildFill="True">
                                <CheckBox DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Top"
                                          IsChecked="{Binding IsChecked}"
                                          Visibility="{Binding CanMultiSelect, Converter={StaticResource BoolToVis}}"
                                          ToolTip="Incluir en eliminación múltiple"/>
                                <StackPanel>
                                  <TextBlock Text="{Binding Entry.Title}" FontWeight="SemiBold" FontSize="14"
                                             TextTrimming="CharacterEllipsis" MaxHeight="40"
                                             TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"/>
                                  <TextBlock Text="{Binding Entry.Status}" FontSize="11" Margin="0,5,0,0"
                                             FontWeight="SemiBold"
                                             Foreground="{DynamicResource BrandAccent}"/>
                                  <TextBlock Text="{Binding Entry.CardIdLine}" FontSize="12" Margin="0,5,0,0"
                                             Foreground="{DynamicResource TextSecondary}"
                                             Visibility="{Binding Entry.ShowCardIdLine, Converter={StaticResource BoolToVis}}"/>
                                  <TextBlock Text="{Binding Entry.CardLinkLine}" FontSize="12" Margin="0,3,0,0"
                                             Foreground="{DynamicResource TextSecondary}"
                                             TextTrimming="CharacterEllipsis"/>
                                  <TextBlock Text="{Binding Entry.CardStatsLine}" FontSize="12" Margin="0,3,0,0"
                                             Foreground="{DynamicResource TextMuted}"
                                             Visibility="{Binding Entry.ShowCardStatsLine, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                              </DockPanel>
                              <DockPanel Grid.Row="1" Margin="0,10,0,0" LastChildFill="False"
                                         DataContext="{Binding Entry}">
                                <Button Content="Abrir" Style="{StaticResource PrimaryButton}"
                                        Padding="12,5" Margin="0,0,6,0" FontSize="12"
                                        Click="LibraryOpen_Click"/>
                                <Button Content="Duplicar" Style="{StaticResource SecondaryButton}"
                                        Padding="12,5" Margin="0,0,6,0" FontSize="12"
                                        Visibility="{Binding CanDuplicate, Converter={StaticResource BoolToVis}}"
                                        Click="LibraryDuplicate_Click"/>
                                <Button Content="⋯" Style="{StaticResource SecondaryButton}"
                                        Padding="10,5" MinWidth="34" FontSize="13"
                                        Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}"
                                        Click="LibraryMore_Click" ToolTip="Más acciones">
                                  <Button.ContextMenu>
                                    <ContextMenu>
                                      <MenuItem Header="{Binding RemoveActionLabel}"
                                                Click="LibraryRemoveMenu_Click"/>
                                    </ContextMenu>
                                  </Button.ContextMenu>
                                </Button>
                              </DockPanel>
                              </Grid>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <TextBlock Grid.Row="3" Margin="0,8,0,0" FontSize="11"
                     Foreground="{DynamicResource TextMuted}" Text="{Binding StatusLine}"/>
        </Grid>
      </Border>

      <Grid>
        <Grid.Style>
          <Style TargetType="Grid">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding ShowLibrary}" Value="True">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Lista NPCs — expandida -->
      <Border Grid.Column="0" Width="236"
              Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource Border}"
              BorderThickness="1" CornerRadius="4" Padding="0">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding NpcListExpanded}" Value="False">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid DataContext="{Binding Npc}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Style="{StaticResource BrownHeaderBar}" CornerRadius="4,4,0,0">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="«" Style="{StaticResource SecondaryButton}"
                      Padding="6,2" Margin="6,0,0,0" FontSize="11" Click="CollapseNpcList_Click"
                      ToolTip="Plegar lista de NPCs"/>
              <TextBlock Text="Lista de NPCs" Style="{StaticResource BrownHeaderText}" VerticalAlignment="Center"/>
            </DockPanel>
          </Border>

          <DockPanel Grid.Row="1" Margin="6,6,6,4">
            <Button DockPanel.Dock="Right" Content="+ Nuevo NPC" Style="{StaticResource PrimaryButton}"
                    Command="{Binding DataContext.NewNpcCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Padding="8,4" Margin="6,0,0,0"/>
            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     Padding="6,4" VerticalContentAlignment="Center"
                     ToolTip="buscar..."/>
          </DockPanel>

          <Grid Grid.Row="2" Margin="6,0,6,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="48"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="ID" Style="{StaticResource ListColumnHeader}"/>
            <TextBlock Grid.Column="1" Text="Nombre" Style="{StaticResource ListColumnHeader}"/>
            <TextBlock Grid.Column="2" Text="Mapa" Style="{StaticResource ListColumnHeader}" Margin="6,0,0,0"/>
          </Grid>

          <ListBox Grid.Row="3" ItemsSource="{Binding FilteredItems}" SelectedItem="{Binding Selected}"
                   BorderThickness="0" Background="Transparent" Margin="2,0">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:NpcDraftItemViewModel}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"
                             Text="{Binding Id, Mode=OneWay}"/>
                  <TextBlock Grid.Column="1" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" Text="{Binding Nombre, Mode=OneWay}" Margin="0,0,6,0"/>
                  <TextBlock Grid.Column="2" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"
                             Foreground="{DynamicResource TextMuted}"
                             Text="{Binding LocationCoordsLabel, Mode=OneWay}"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Grid.Row="4" HorizontalAlignment="Right" Margin="6,2,6,2"
                     FontSize="11" Foreground="{DynamicResource TextMuted}"
                     Text="{Binding ItemCountLabel}"/>

          <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="6,0,6,6">
            <Button Content="Duplicar" Style="{StaticResource SecondaryButton}"
                    Command="{Binding DataContext.DuplicateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Padding="8,3" Margin="0,0,6,0"/>
            <Button Content="Eliminar" Style="{StaticResource DeleteButton}"
                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Padding="8,3"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Lista NPCs — plegada (barra estrecha) -->
      <Border Grid.Column="0" Width="36"
              Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource Border}"
              BorderThickness="1" CornerRadius="4">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding NpcListExpanded}" Value="False">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Button Style="{StaticResource SecondaryButton}" Padding="0" Margin="4"
                VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                Click="ExpandNpcList_Click" ToolTip="Mostrar lista de NPCs">
          <TextBlock Text="NPC" FontSize="10" FontWeight="SemiBold"
                     RenderTransformOrigin="0.5,0.5">
            <TextBlock.RenderTransform>
              <RotateTransform Angle="-90"/>
            </TextBlock.RenderTransform>
          </TextBlock>
        </Button>
      </Border>

      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    IsEnabled="{Binding EditorEnabled}">
        <StackPanel Margin="0,0,4,0">
          <TextBlock Margin="0,0,0,8" TextWrapping="Wrap"
                     Foreground="{DynamicResource BrandAccent}"
                     Visibility="{Binding HasIncompleteDialogResponses, Converter={StaticResource BoolToVis}}"
                     Text="⚠ Respuesta sin acción: añade al menos una acción antes de publicar."/>

          <!-- 1. IDENTIDAD -->
          <Expander Style="{StaticResource ContentAccordionExpander}" IsExpanded="{Binding IdentityExpanded, Mode=TwoWay}">
            <Expander.Header>
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource AccordionStatus}"
                           Text="{Binding IdentitySectionStatus}"/>
                <TextBlock Text="1. IDENTIDAD" FontWeight="SemiBold" FontSize="13"/>
              </DockPanel>
            </Expander.Header>
            <Border Padding="10,6,10,8">
              <StackPanel>
                <!-- ADMIN.UI.4B.2A.3G.7 — ID|Nombre|Sexo|Tamaño|Accesorios · GFX|Mapa|Celda|Acciones · Ventas|ObjetoCompra condicional -->
                <Grid DataContext="{Binding Npc.Selected}">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <!-- Fila 1: ID | Nombre | Sexo | Tamaño | Accesorios -->
                  <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" MinWidth="72"/>
                      <ColumnDefinition Width="10"/>
                      <ColumnDefinition Width="2*"/>
                      <ColumnDefinition Width="10"/>
                      <ColumnDefinition Width="*" MinWidth="88" MaxWidth="140"/>
                      <ColumnDefinition Width="10"/>
                      <ColumnDefinition Width="64"/>
                      <ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="ID" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Nombre" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Sexo" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                    <TextBlock Grid.Row="0" Grid.Column="6" Text="Tamaño" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                    <TextBlock Grid.Row="0" Grid.Column="8" Text="Accesorios" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                    <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding IdDisplay, Mode=OneWay}"
                             IsReadOnly="True" IsTabStop="False"
                             FontFamily="Consolas" VerticalAlignment="Center" MinWidth="68"
                             Padding="6,4"
                             Background="{DynamicResource InputBackground}"
                             BorderBrush="{DynamicResource InputBorder}"
                             Foreground="{DynamicResource TextMuted}"
                             ToolTip="ID provisional · solo lectura · MAX(real)+1"/>
                    <ctrl:NpcNameAiField Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"
                                         Nombre="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                                         AiAssistant="{Binding DataContext.AiAssistant, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         IsEditorEnabled="{Binding DataContext.EditorEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <ComboBox Grid.Row="1" Grid.Column="4"
                              ItemsSource="{x:Static vm:NpcDraftItemViewModel.SexoUiOptions}"
                              SelectedItem="{Binding SexoUi, Mode=TwoWay}"
                              VerticalAlignment="Center" Padding="4,2"/>
                    <TextBox Grid.Row="1" Grid.Column="6"
                             Text="{Binding Tamaño, UpdateSourceTrigger=LostFocus}"
                             FontFamily="Consolas" VerticalAlignment="Center" MaxWidth="64" Padding="4,3"
                             ToolTip="{Binding ScaleValidationMessage}"/>
                    <TextBlock Grid.Row="1" Grid.Column="6" VerticalAlignment="Bottom" Margin="0,0,0,-14"
                               FontSize="10" Foreground="{DynamicResource Error}"
                               Text="{Binding ScaleValidationMessage}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBox Grid.Row="1" Grid.Column="8"
                             Text="{Binding Accesorios, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas" VerticalAlignment="Center" Padding="4,3"/>
                  </Grid>

                  <!-- Fila 2: GFX + ubicación (izq) | Acciones (der) -->
                  <Grid Grid.Row="1" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="1.6*"/>
                      <ColumnDefinition Width="10"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                      <TextBlock Text="GFX · Ubicación" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                      <Border Padding="10" CornerRadius="6"
                              Background="{DynamicResource ElevatedSurface}"
                              BorderBrush="{DynamicResource Border}" BorderThickness="1">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>

                          <StackPanel Grid.Column="0">
                            <DockPanel>
                              <Button DockPanel.Dock="Left" Style="{StaticResource GfxPickerImageButton}"
                                      Margin="0,0,10,0"
                                      Command="{Binding DataContext.Npc.PickGfxAppearanceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      ToolTip="Clic para elegir apariencia">
                                <ctrl:LazyArtworkImage GfxId="{Binding GfxId}"
                                                       UseNpcSpritePreview="False"
                                                       Width="104" Height="104"
                                                       IsHitTestVisible="False"/>
                              </Button>
                              <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding GfxDisplayName, Mode=OneWay}" FontWeight="SemiBold" FontSize="13"
                                           TextTrimming="CharacterEllipsis"/>
                                <Button Style="{StaticResource GfxIdLinkButton}" Margin="0,2,0,0"
                                        Command="{Binding DataContext.Npc.PickGfxAppearanceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ToolTip="Clic para elegir apariencia">
                                  <TextBlock Text="{Binding GfxIdTechnicalLabel, Mode=OneWay}"
                                             FontFamily="Consolas" FontSize="11"/>
                                </Button>
                              </StackPanel>
                            </DockPanel>

                            <Grid Margin="0,10,0,0" DataContext="{Binding PrimaryLocation}">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="88"/>
                              </Grid.ColumnDefinitions>
                              <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                              </Grid.RowDefinitions>
                              <TextBlock Grid.Row="0" Grid.Column="0" Text="Mapa" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                              <TextBlock Grid.Row="0" Grid.Column="2" Text="Celda" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                              <TextBox Grid.Row="1" Grid.Column="0"
                                       Text="{Binding MapId, UpdateSourceTrigger=PropertyChanged}"
                                       FontFamily="Consolas" VerticalAlignment="Center" Padding="4,3"
                                       ToolTip="Mapa donde aparece el NPC" TextChanged="LocationField_Changed"
                                       GotFocus="ZeroDefaultIntField_GotFocus"
                                       LostFocus="ZeroDefaultIntField_LostFocus"/>
                              <TextBox Grid.Row="1" Grid.Column="2"
                                       Text="{Binding CellId, UpdateSourceTrigger=PropertyChanged}"
                                       FontFamily="Consolas" VerticalAlignment="Center" Padding="4,3"
                                       ToolTip="Celda en el mapa" TextChanged="LocationField_Changed"
                                       GotFocus="ZeroDefaultIntField_GotFocus"
                                       LostFocus="ZeroDefaultIntField_LostFocus"/>
                            </Grid>
                          </StackPanel>

                          <StackPanel Grid.Column="2" VerticalAlignment="Top"
                                      DataContext="{Binding PrimaryLocation}">
                            <TextBlock Text="Orientación" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                            <ctrl:NpcOrientationPicker
                                   Orientation="{Binding Orientation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   OrientationEdited="OrientationPicker_Edited"
                                   HorizontalAlignment="Left"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </StackPanel>

                    <Grid Grid.Column="2" VerticalAlignment="Top">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <TextBlock Grid.Row="0" Text="Acciones" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                      <ctrl:NpcClientActionsPicker Grid.Row="1" Margin="0,0,0,6"
                                                   Actions="{Binding ClientActions}"
                                                   DisplayText="{Binding ClientActionsCompactSummary}"/>
                      <!-- Campos de comercio debajo de Acciones (aparecen al seleccionar acciones relevantes) -->
                      <Grid Grid.Row="2"
                            Visibility="{Binding ShowCommerceFields, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="12"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Ventas" Style="{StaticResource FieldLabel}"
                                   Margin="0,0,8,4"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="ObjetoCompra" Style="{StaticResource FieldLabel}"
                                   Margin="0,0,8,4"/>
                        <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                 Text="{Binding Ventas, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,0,0"/>
                        <TextBox Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2"
                                 Text="{Binding ObjetoCompra, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas" VerticalAlignment="Center"/>
                      </Grid>
                    </Grid>
                  </Grid>

                  <TextBlock Grid.Row="2"
                             Text="{Binding UnequalScaleHint}" FontSize="11"
                             Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"
                             Visibility="{Binding ShowUnequalScaleHint, Converter={StaticResource BoolToVis}}"/>
                </Grid>
              </StackPanel>
            </Border>
          </Expander>

          <!-- 2. INTERACCIONES, DIÁLOGO Y MISIÓN -->
          <Expander Style="{StaticResource ContentAccordionExpander}" IsExpanded="{Binding InteractionsExpanded, Mode=TwoWay}">
            <Expander.Header>
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <TextBlock Style="{StaticResource AccordionStatus}" Text="{Binding MissionSectionStatus}" Margin="0,0,10,0"/>
                  <TextBlock Style="{StaticResource AccordionStatus}" Text="{Binding InteractionsSectionStatus}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="2. INTERACCIONES, DIÁLOGO Y MISIÓN" FontWeight="SemiBold" FontSize="13"/>
                  <TextBlock Text="  · OBLIGATORIO" FontWeight="SemiBold" FontSize="12"
                             Foreground="{DynamicResource BrandAccent}" VerticalAlignment="Center"/>
                </StackPanel>
              </DockPanel>
            </Expander.Header>
            <Border Padding="10,6,10,8">
              <StackPanel>
                <!-- Editor de conversación — plegable -->
                <Expander IsExpanded="{Binding DialogConversationExpanded, Mode=TwoWay}"
                          Style="{StaticResource ContentAccordionExpander}" Margin="0,0,0,8">
                  <Expander.Header>
                    <TextBlock Text="EDITOR DE CONVERSACIÓN" FontWeight="SemiBold" FontSize="12"/>
                  </Expander.Header>
                  <Border MinHeight="280" BorderBrush="{DynamicResource Border}" BorderThickness="0">
                    <ctrl:ContentDialogEditorPanel DataContext="{Binding Dialogs}"
                                                   AiAssistant="{Binding DataContext.AiAssistant, RelativeSource={RelativeSource AncestorType=app:ContentWorkspaceView}}"
                                                   MissionEditor="{Binding DataContext.Missions, RelativeSource={RelativeSource AncestorType=app:ContentWorkspaceView}}"
                                                   MissionHost="{Binding DataContext, RelativeSource={RelativeSource AncestorType=app:ContentWorkspaceView}}"/>
                  </Border>
                </Expander>

                <!-- Misión huérfana: existe draft pero ninguna acción 44 -->
                <Border Margin="0,0,0,8" Padding="12" CornerRadius="6"
                        Visibility="{Binding ShowOrphanMissionWarning, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource ElevatedSurface}"
                        BorderBrush="{DynamicResource Border}" BorderThickness="1">
                  <StackPanel>
                    <TextBlock Text="Existe una misión sin acción «Iniciar misión» asociada."
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10"/>
                    <Button Content="Vincular a una respuesta" Command="{Binding LinkOrphanMissionCommand}"
                            Padding="12,6" HorizontalAlignment="Left"
                            ToolTip="Añade o vincula acción 44 en la respuesta seleccionada del canvas"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </Expander>

          <!-- 3. REVISIÓN Y PUBLICACIÓN -->
          <Expander Style="{StaticResource ContentAccordionExpander}" IsExpanded="{Binding ReviewExpanded, Mode=TwoWay}">
            <Expander.Header>
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource AccordionStatus}"
                           Text="{Binding ReviewSectionStatus}"/>
                <TextBlock Text="3. REVISIÓN Y PUBLICACIÓN" FontWeight="SemiBold" FontSize="13"/>
              </DockPanel>
            </Expander.Header>
            <Border Padding="12,8,12,12">
              <StackPanel>
                <TextBlock Text="Resumen del borrador" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding ReviewLines}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,6">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding Mark}" FontWeight="SemiBold"
                                     Margin="16,0,0,0" Foreground="{DynamicResource TextSecondary}"/>
                          <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Margin="0,12,0,0" FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                           Text="Borrador ≠ publicado. quests_es vía Publicar cliente tras BD. Publicación segura BD: ADMIN.UI.4C."/>
                <WrapPanel Margin="0,12,0,0">
                  <Button Content="Publicar cliente (CONT.8)" Command="{Binding PublishClientCommand}"
                          Padding="12,6" Margin="0,0,8,0"
                          Visibility="{Binding ShowPublishClientButton, Converter={StaticResource BoolToVis}}"
                          IsEnabled="{Binding EnablePublishClientButton}"
                          ToolTip="dialog_es + npc_es + quests_es · no escribe BD"/>
                  <Button Content="Publicar contenido en BD (CONT.5)" Command="{Binding PublishCommand}"
                          Padding="12,6"
                          Visibility="{Binding ShowPublishBdButton, Converter={StaticResource BoolToVis}}"
                          IsEnabled="{Binding EnablePublishBdButton}"
                          ToolTip="NPC/diálogos/ubicaciones. Misiones nuevas: fase ADMIN.UI.4C."/>
                  <TextBlock Text="{Binding ClientPublishStatusLabel}" FontSize="11" VerticalAlignment="Center"
                             Margin="0,0,12,0" Foreground="{DynamicResource TextMuted}"
                             Visibility="{Binding ShowClientPublishStatus, Converter={StaticResource BoolToVis}}"/>
                  <TextBlock Text="{Binding BdPublishStatusLabel}" FontSize="11" VerticalAlignment="Center"
                             Foreground="{DynamicResource TextMuted}"
                             Visibility="{Binding ShowBdPublishStatus, Converter={StaticResource BoolToVis}}"/>
                </WrapPanel>
              </StackPanel>
            </Border>
          </Expander>
        </StackPanel>
      </ScrollViewer>
      </Grid>
    </Grid>

    <TextBlock Grid.Row="2" Margin="0,6,0,0" FontSize="11"
               Foreground="{DynamicResource ChromeForegroundMuted}"
               Text="Flujo · Identidad (con ubicaciones) → Interacciones → Misión → Revisión · Cliente = CONT.8 · BD = CONT.5"/>
  </Grid>
</UserControl>