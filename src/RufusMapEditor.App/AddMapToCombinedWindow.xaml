<Window x:Class="RufusMapEditor.App.AddMapToCombinedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Añadir al combinado"
        Height="360" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FF1A1814"
        Foreground="#FFF5F0E6">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Background="#FF2A2620" CornerRadius="6" BorderBrush="#FF4A453C" BorderThickness="1"
            Padding="12,10" Margin="0,0,0,12">
      <TextBlock x:Name="TitleText" FontWeight="SemiBold" Foreground="#FFF5F0E6"/>
    </Border>

    <TextBlock x:Name="HintText" Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,12"
               Foreground="#FFB8B0A0" FontSize="12"/>

    <StackPanel Grid.Row="2" Margin="0,0,0,12">
      <TextBlock Text="Posición" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#FFF5F0E6"/>
      <RadioButton x:Name="RadioUp" Content="Arriba" Margin="0,0,0,4" Foreground="#FFF5F0E6"/>
      <RadioButton x:Name="RadioDown" Content="Abajo" Margin="0,0,0,4" Foreground="#FFF5F0E6"/>
      <RadioButton x:Name="RadioLeft" Content="Izquierda" Margin="0,0,0,4" Foreground="#FFF5F0E6"/>
      <RadioButton x:Name="RadioRight" Content="Derecha" Margin="0,0,0,4" Foreground="#FFF5F0E6"/>
      <RadioButton x:Name="RadioIndependent" Content="Independiente (ventana aparte)"
                   Margin="0,4,0,0" Foreground="#FFF5F0E6"/>
    </StackPanel>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Añadir" Width="100" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"
              Background="#FFC4A35A" Foreground="#FF1A1814" FontWeight="SemiBold" Padding="10,6"/>
      <Button Content="Cancelar" Width="88" IsCancel="True" Padding="10,6"
              Background="#FF2A2620" Foreground="#FFF5F0E6"/>
    </StackPanel>
  </Grid>
</Window>
