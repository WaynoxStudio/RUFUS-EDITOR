<Window x:Class="RufusMapEditor.App.DatabaseSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración BD"
        Width="560" Height="720"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Background="{DynamicResource DialogHeaderBackground}" CornerRadius="6"
            BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="12,10" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal">
        <Border Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource BrandAccent}" Margin="0,0,10,0"/>
        <TextBlock Text="MySQL · publicación de mapas" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
    <StackPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="120"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Text="Host" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
      <TextBox x:Name="HostBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" FontFamily="Consolas"/>

      <TextBlock Grid.Row="1" Text="Puerto" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
      <TextBox x:Name="PortBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" FontFamily="Consolas"/>

      <TextBlock Grid.Row="2" Text="Usuario" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
      <TextBox x:Name="UserBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" FontFamily="Consolas"/>

      <TextBlock Grid.Row="3" Text="Contraseña" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
      <PasswordBox x:Name="PasswordBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"/>

      <TextBlock Grid.Row="4" Text="Base de datos" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
      <TextBox x:Name="DatabaseBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" FontFamily="Consolas"/>

      <TextBlock Grid.Row="5" Text="Tabla" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
      <TextBox x:Name="TableBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" FontFamily="Consolas"/>
    </Grid>

    <Expander Header="Valores para mapas nuevos (avanzado · 10B.2)" IsExpanded="False" Margin="0,12,0,0">
      <Grid Margin="0,10,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="170"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="key" VerticalAlignment="Center"/><TextBox x:Name="DefaultKeyBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" ToolTip="Vacío: RUFUS '' o DEFAULT BD"/>
        <TextBlock Grid.Row="1" Text="mobs" VerticalAlignment="Center"/><TextBox x:Name="DefaultMobsBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" ToolTip="Vacío: RUFUS '' o DEFAULT BD"/>
        <TextBlock Grid.Row="2" Text="subArea" VerticalAlignment="Center"/><TextBox x:Name="DefaultSubAreaBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" ToolTip="Vacío: RUFUS 0 o DEFAULT BD"/>
        <TextBlock Grid.Row="3" Text="maxGrupoMobs" VerticalAlignment="Center"/><TextBox x:Name="DefaultMaxGrupoMobsBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" ToolTip="Vacío: RUFUS 4 o DEFAULT BD"/>
        <TextBlock Grid.Row="4" Text="maxMobsPorGrupo" VerticalAlignment="Center"/><TextBox x:Name="DefaultMaxMobsPorGrupoBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,6" ToolTip="Vacío: RUFUS 8 o DEFAULT BD"/>
        <TextBlock Grid.Row="5" Text="minNivelGrupoMob" VerticalAlignment="Center"/><TextBox x:Name="DefaultMinNivelGrupoMobBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,6" ToolTip="Vacío: RUFUS 0 o DEFAULT BD"/>
        <TextBlock Grid.Row="6" Text="maxNivelGrupoMob" VerticalAlignment="Center"/><TextBox x:Name="DefaultMaxNivelGrupoMobBox" Grid.Row="6" Grid.Column="1" Margin="0,0,0,6" ToolTip="Vacío: RUFUS 0 o DEFAULT BD"/>
        <TextBlock Grid.Row="7" Text="maxMercantes" VerticalAlignment="Center"/><TextBox x:Name="DefaultMaxMercantesBox" Grid.Row="7" Grid.Column="1" Margin="0,0,0,6" ToolTip="Vacío: RUFUS 5 o DEFAULT BD"/>
        <TextBlock Grid.Row="8" Text="maxPeleas" VerticalAlignment="Center"/><TextBox x:Name="DefaultMaxPeleasBox" Grid.Row="8" Grid.Column="1" Margin="0,0,0,6" ToolTip="Vacío: RUFUS 99 o DEFAULT BD"/>
        <TextBlock Grid.Row="9" Text="minMobsPorGrupo" VerticalAlignment="Center"/><TextBox x:Name="DefaultMinMobsPorGrupoBox" Grid.Row="9" Grid.Column="1" Margin="0,0,0,6" ToolTip="Vacío: RUFUS 1 o DEFAULT BD"/>
      </Grid>
    </Expander>
    <TextBlock Text="Opcional. Vacío = defaults RUFUS (o DEFAULT MySQL si existe). No es obligatorio para crear un mapa."
               TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondary}"/>
    </StackPanel>
    </ScrollViewer>

    <TextBlock x:Name="StatusText" Grid.Row="2" TextWrapping="Wrap" Margin="0,8,0,8"
               Foreground="{DynamicResource TextSecondary}" MinHeight="36"/>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Probar conexión" Padding="10,4" Margin="0,0,8,0" Click="Test_Click"/>
      <Button Content="Cancelar" Padding="10,4" Margin="0,0,8,0" IsCancel="True"/>
      <Button Content="Guardar" Padding="10,4" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/>
    </StackPanel>
  </Grid>
</Window>
