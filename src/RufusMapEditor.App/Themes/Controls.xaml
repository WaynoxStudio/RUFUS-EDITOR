  <!-- Interruptor sol / luna (claro ↔ oscuro). Usa Margin, no Canvas.Left. -->
  <Style x:Key="ThemeSunMoonToggle" TargetType="ToggleButton">
    <Setter Property="Width" Value="58"/>
    <Setter Property="Height" Value="30"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="ToolTip" Value="Tema claro / oscuro"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Track" CornerRadius="15" Background="#FFE8B84A" ClipToBounds="True">
            <Border.Effect>
              <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.25" Color="#FF000000"/>
            </Border.Effect>
            <Grid>
              <Canvas x:Name="Stars" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left" Width="28" Margin="6,6,0,6">
                <Ellipse Width="2" Height="2" Fill="#EEFFFFFF" Canvas.Left="4" Canvas.Top="3"/>
                <Ellipse Width="1.5" Height="1.5" Fill="#CCFFFFFF" Canvas.Left="14" Canvas.Top="10"/>
                <Ellipse Width="2" Height="2" Fill="#DDFFFFFF" Canvas.Left="8" Canvas.Top="14"/>
              </Canvas>
              <Border x:Name="Thumb" Width="24" Height="24" CornerRadius="12"
                      HorizontalAlignment="Left" VerticalAlignment="Center"
                      Margin="3,0,0,0"
                      Background="#FFFFF8E7" BorderBrush="#33FFFFFF" BorderThickness="1"
                      RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                  <RotateTransform Angle="0"/>
                </Border.RenderTransform>
                <Border.Effect>
                  <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.35" Color="#FF000000"/>
                </Border.Effect>
                <Grid>
                  <Viewbox x:Name="SunIcon" Width="14" Height="14" Opacity="1">
                    <Canvas Width="24" Height="24">
                      <Ellipse Canvas.Left="7" Canvas.Top="7" Width="10" Height="10" Fill="#FFF59E0B"/>
                      <Path Stroke="#FFF59E0B" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                            Data="M12,2 L12,4 M12,20 L12,22 M2,12 L4,12 M20,12 L22,12 M4.9,4.9 L6.3,6.3 M17.7,17.7 L19.1,19.1 M4.9,19.1 L6.3,17.7 M17.7,6.3 L19.1,4.9"/>
                    </Canvas>
                  </Viewbox>
                  <Viewbox x:Name="MoonIcon" Width="13" Height="13" Opacity="0">
                    <Path Fill="#FFE2E8F0"
                          Data="M14.5,2.2 A9.2,9.2 0 1 0 21.8,14.2 A7.2,7.2 0 1 1 14.5,2.2 Z"/>
                  </Viewbox>
                </Grid>
              </Border>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Thumb" Property="Margin" Value="31,0,0,0"/>
              <Setter TargetName="Track" Property="Background" Value="#FF1E293B"/>
              <Setter TargetName="Thumb" Property="Background" Value="#FF334155"/>
              <Setter TargetName="SunIcon" Property="Opacity" Value="0"/>
              <Setter TargetName="MoonIcon" Property="Opacity" Value="1"/>
              <Setter TargetName="Stars" Property="Opacity" Value="1"/>
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ThicknessAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="Margin"
                                        To="31,0,0,0" Duration="0:0:0.28">
                      <ThicknessAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseInOut"/>
                      </ThicknessAnimation.EasingFunction>
                    </ThicknessAnimation>
                    <DoubleAnimation Storyboard.TargetName="Thumb"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                     To="180" Duration="0:0:0.28">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                    To="#FF1E293B" Duration="0:0:0.28"/>
                    <ColorAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                    To="#FF334155" Duration="0:0:0.28"/>
                    <DoubleAnimation Storyboard.TargetName="SunIcon" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.15"/>
                    <DoubleAnimation Storyboard.TargetName="MoonIcon" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.25" BeginTime="0:0:0.05"/>
                    <DoubleAnimation Storyboard.TargetName="Stars" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.3" BeginTime="0:0:0.08"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ThicknessAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="Margin"
                                        To="3,0,0,0" Duration="0:0:0.28">
                      <ThicknessAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseInOut"/>
                      </ThicknessAnimation.EasingFunction>
                    </ThicknessAnimation>
                    <DoubleAnimation Storyboard.TargetName="Thumb"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                     To="0" Duration="0:0:0.28">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                    To="#FFE8B84A" Duration="0:0:0.28"/>
                    <ColorAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                    To="#FFFFF8E7" Duration="0:0:0.28"/>
                    <DoubleAnimation Storyboard.TargetName="MoonIcon" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.15"/>
                    <DoubleAnimation Storyboard.TargetName="SunIcon" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.25" BeginTime="0:0:0.05"/>
                    <DoubleAnimation Storyboard.TargetName="Stars" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.18"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
