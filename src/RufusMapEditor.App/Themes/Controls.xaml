                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{DynamicResource HeaderForeground}"/>
                        <Path x:Name="Arrow" Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z"
                              Fill="{DynamicResource HeaderForeground}" VerticalAlignment="Center" Margin="8,0,0,0"/>
