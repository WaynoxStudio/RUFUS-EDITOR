  <SolidColorBrush x:Key="PreviewEmpty" Color="#FFEDE8D4"/>
  <SolidColorBrush x:Key="PreviewEmptyBorder" Color="#FFC4BAA0"/>
  <SolidColorBrush x:Key="CheckerA" Color="#FFE6E0C8"/>
  <SolidColorBrush x:Key="CheckerB" Color="#FFEDE8D4"/>
  <SolidColorBrush x:Key="SplitterBrush" Color="#FFC4BAA0"/>
  <SolidColorBrush x:Key="SplitterHoverBrush" Color="#FFF39C12"/>
  <SolidColorBrush x:Key="ToolSidebarActive" Color="#FFF39C12"/>
  <SolidColorBrush x:Key="MapBoundaryBrush" Color="#FFF39C12"/>
  <SolidColorBrush x:Key="InspectorCardBackground" Color="#FFE6E0C8"/>
