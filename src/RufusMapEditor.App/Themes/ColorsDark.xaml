  <SolidColorBrush x:Key="OverlayCellIdShadow" Color="#99000000"/>
  <SolidColorBrush x:Key="OverlayUnwalkableFill" Color="#50EF5350"/>
  <SolidColorBrush x:Key="OverlayUnwalkableStroke" Color="#FFE53935"/>
