<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- WPF popups/menus use SystemColors; warm palette on beige surfaces -->
  <Color x:Key="{x:Static SystemColors.MenuColorKey}" A="255" R="230" G="224" B="200"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FFE6E0C8"/>
  <Color x:Key="{x:Static SystemColors.MenuTextColorKey}" A="255" R="44" G="36" B="22"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#FF2C2416"/>
  <Color x:Key="{x:Static SystemColors.MenuBarColorKey}" A="255" R="26" G="26" B="26"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}" Color="#FF1A1A1A"/>
  <Color x:Key="{x:Static SystemColors.HighlightColorKey}" A="255" R="243" G="156" B="18"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FFF39C12"/>
  <Color x:Key="{x:Static SystemColors.HighlightTextColorKey}" A="255" R="255" G="255" B="255"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFFFF"/>
  <Color x:Key="{x:Static SystemColors.GrayTextColorKey}" A="255" R="122" G="107" B="85"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#FF7A6B55"/>
  <Color x:Key="{x:Static SystemColors.WindowColorKey}" A="255" R="230" G="224" B="200"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FFE6E0C8"/>
  <Color x:Key="{x:Static SystemColors.WindowTextColorKey}" A="255" R="44" G="36" B="22"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FF2C2416"/>
  <Color x:Key="{x:Static SystemColors.ControlColorKey}" A="255" R="255" G="255" B="255"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FFFFFFFF"/>
  <Color x:Key="{x:Static SystemColors.ControlTextColorKey}" A="255" R="51" G="51" B="51"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FF333333"/>

  <!-- Semantic palette — Warm editor (Dofus-style) -->
  <SolidColorBrush x:Key="WindowBackground" Color="#FF1A1A1A"/>
  <SolidColorBrush x:Key="CanvasBackground" Color="#FF141414"/>
  <SolidColorBrush x:Key="PanelBackground" Color="#FFE6E0C8"/>
  <SolidColorBrush x:Key="SurfaceBackground" Color="#FFE6E0C8"/>
  <SolidColorBrush x:Key="ElevatedSurface" Color="#FFEDE8D4"/>
  <SolidColorBrush x:Key="BrandBarBackground" Color="#FF1A1A1A"/>
  <SolidColorBrush x:Key="Border" Color="#FFC4BAA0"/>
  <SolidColorBrush x:Key="Divider" Color="#FFD5CCB5"/>
  <SolidColorBrush x:Key="TextPrimary" Color="#FF2C2416"/>
  <SolidColorBrush x:Key="TextSecondary" Color="#FF5C4F3A"/>
  <SolidColorBrush x:Key="TextMuted" Color="#FF7A6B55"/>
  <SolidColorBrush x:Key="TextDisabled" Color="#FF9A8E7A"/>
  <SolidColorBrush x:Key="ShellForeground" Color="#FFF3F3F3"/>
  <SolidColorBrush x:Key="HeaderForeground" Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="InputForeground" Color="#FF333333"/>
  <SolidColorBrush x:Key="SecondaryButtonBackground" Color="#FFD5CCB5"/>
  <SolidColorBrush x:Key="OverlayPaintTargetFill" Color="#66FF1493"/>
  <SolidColorBrush x:Key="OverlayPaintTargetStroke" Color="#FFFF1493"/>
  <SolidColorBrush x:Key="BrandAccent" Color="#FFF39C12"/>
  <SolidColorBrush x:Key="BrandAccentHover" Color="#FFF5AB35"/>
