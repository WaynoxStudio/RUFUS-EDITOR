<Window x:Class="RufusMapEditor.App.MobsFixConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Guardar mobs en SQL"
        Width="560" Height="580"
        MinWidth="440" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Background="{DynamicResource DialogHeaderBackground}" CornerRadius="6"
            BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="12,10" Margin="0,0,0,12">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
          <Border Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource BrandAccent}" Margin="0,0,10,0"/>
          <TextBlock Text="Guardar mobs en SQL" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="REPLACE mobs_fix · PK mapa + celda" FontSize="12"
                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
    <Border Grid.Row="1" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource Border}"
            BorderThickness="1" CornerRadius="6" Padding="12">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="BodyText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                   Foreground="{DynamicResource TextPrimary}"/>
      </ScrollViewer>
    </Border>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="CANCELAR" Width="110" Margin="0,0,8,0" Padding="8,4" IsCancel="True" Click="Cancel_Click"/>
      <Button Content="GUARDAR MOBS" MinWidth="130" Padding="8,4" Style="{StaticResource PrimaryButton}"
              IsDefault="True" Click="Save_Click"/>
    </StackPanel>
  </Grid>
</Window>
