<Window x:Class="RufusMapEditor.App.WorldCoordInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cambiar coordenadas"
        Width="360"
        SizeToContent="Height"
        MinHeight="168"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,12"
               Foreground="{DynamicResource TextSecondary}"/>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
      <TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
      <TextBox x:Name="XBox" Width="72" Padding="6,4" FontFamily="Consolas"
               Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}"/>
      <TextBlock Text="Y" VerticalAlignment="Center" Margin="16,0,8,0" FontWeight="SemiBold"/>
      <TextBox x:Name="YBox" Width="72" Padding="6,4" FontFamily="Consolas"
               Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}"/>
    </StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Aceptar" MinWidth="90" Margin="0,0,8,0" Padding="12,6" IsDefault="True" Click="Ok_Click"/>
      <Button Content="Cancelar" MinWidth="90" Padding="12,6" IsCancel="True" Click="Cancel_Click"/>
    </StackPanel>
  </Grid>
</Window>
