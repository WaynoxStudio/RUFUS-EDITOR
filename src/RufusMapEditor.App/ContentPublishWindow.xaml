<Window x:Class="RufusMapEditor.App.ContentPublishWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Publicar contenido en BD"
        Width="560" Height="680"
        MinWidth="480" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource AppFontFamily}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
  </Window.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Text="Contenido → Publicar BD" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>

    <Border Grid.Row="1" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6"
            Background="{DynamicResource PanelBackground}" Padding="10" Margin="0,0,0,10"
            Visibility="{Binding HasNpcChoices, Converter={StaticResource BoolToVis}}">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
          <TextBlock Text="NPCs a publicar" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <Button Content="Todos" Command="{Binding SelectAllCommand}" Padding="8,2" Margin="0,0,6,0"/>
          <Button Content="Ninguno" Command="{Binding SelectNoneCommand}" Padding="8,2"/>
        </StackPanel>
        <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding NpcChoices}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <CheckBox Content="{Binding DisplayLabel}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                          Margin="0,2" FontSize="12"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Border Grid.Row="2" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6"
            Background="{DynamicResource PanelBackground}" Padding="12">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <TextBlock Text="{Binding Summary}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
      </ScrollViewer>
    </Border>

    <TextBlock Grid.Row="3" Text="{Binding Status}" Margin="0,10,0,10" TextWrapping="Wrap"
               FontSize="11" Foreground="{DynamicResource TextSecondary}"/>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="CANCELAR" Command="{Binding CancelCommand}" Padding="14,6" Margin="0,0,8,0" IsCancel="True"/>
      <Button Content="PUBLICAR" Command="{Binding PublishCommand}" Padding="14,6" FontWeight="SemiBold"
              IsDefault="True"/>
    </StackPanel>
  </Grid>
</Window>
