<Window x:Class="RufusMapEditor.App.MapIdInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Map ID local"
        Width="400" Height="200"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <TextBlock Grid.Row="1" Text="Map ID" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
    <TextBox x:Name="IdBox" Grid.Row="2" FontFamily="Consolas"/>
    <TextBlock Grid.Row="3" Text="ID local pendiente de validar en BD" Foreground="{DynamicResource TextMuted}" FontSize="11"
               VerticalAlignment="Bottom" Margin="0,8,0,8"/>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Aceptar" Width="90" Margin="0,0,8,0" Padding="8,4" IsDefault="True" Click="Ok_Click"/>
      <Button Content="Cancelar" Width="90" Padding="8,4" IsCancel="True" Click="Cancel_Click"/>
    </StackPanel>
  </Grid>
</Window>
