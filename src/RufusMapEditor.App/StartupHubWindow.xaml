<Window x:Class="RufusMapEditor.App.StartupHubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RUFUS Map Editor"
        Width="780" Height="560"
        MinWidth="660" MinHeight="480"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#FF0A0A0B"
        Foreground="#FFF3F3F3"
        FontFamily="{DynamicResource AppFontFamily}"
        MouseMove="Window_MouseMove"
        MouseLeave="Window_MouseLeave">
  <Window.Resources>
    <SolidColorBrush x:Key="HubBg" Color="#FF0A0A0B"/>
    <SolidColorBrush x:Key="HubSurface" Color="#FF161618"/>
    <SolidColorBrush x:Key="HubSurfaceElevated" Color="#FF1E1E22"/>
    <SolidColorBrush x:Key="HubBorder" Color="#FF3A3A40"/>
    <SolidColorBrush x:Key="HubAccent" Color="#FFC62828"/>
    <SolidColorBrush x:Key="HubAccentPressed" Color="#FF8E1B1B"/>
    <SolidColorBrush x:Key="HubAccentSubtle" Color="#33C62828"/>
    <SolidColorBrush x:Key="HubSelection" Color="#FF2A1214"/>
    <SolidColorBrush x:Key="HubText" Color="#FFF3F3F3"/>
    <SolidColorBrush x:Key="HubTextSecondary" Color="#FFB8B8BC"/>
    <SolidColorBrush x:Key="HubTextMuted" Color="#FF8A8A90"/>

    <Style x:Key="HubModuleCard" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource HubSurface}"/>
      <Setter Property="Foreground" Value="{StaticResource HubText}"/>
      <Setter Property="BorderBrush" Value="{StaticResource HubBorder}"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="CardBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="16"
                    ClipToBounds="True"
                    SnapsToDevicePixels="True"
                    RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
              </Border.RenderTransform>
              <Border.Effect>
                <DropShadowEffect x:Name="CardShadow"
                                  BlurRadius="22" ShadowDepth="6"
                                  Opacity="0.32" Direction="270" Color="#000000"/>
              </Border.Effect>
              <Grid>
                <Border x:Name="AccentGlow"
                        CornerRadius="16"
                        Background="{StaticResource HubAccentSubtle}"
                        Opacity="0"/>
                <Ellipse x:Name="LiquidSheen"
                         Width="220" Height="220"
                         IsHitTestVisible="False"
                         Opacity="0"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"
                         Margin="-110,-110,0,0">
                  <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="SheenTransform"/>
                  </Ellipse.RenderTransform>
                  <Ellipse.Fill>
                    <RadialGradientBrush>
                      <GradientStop Color="#66FF8A80" Offset="0"/>
                      <GradientStop Color="#33C62828" Offset="0.35"/>
                      <GradientStop Color="#00C62828" Offset="1"/>
                    </RadialGradientBrush>
                  </Ellipse.Fill>
                </Ellipse>
                <Border x:Name="FocusRing"
                        CornerRadius="16"
                        BorderBrush="{StaticResource HubAccent}"
                        BorderThickness="2"
                        Opacity="0"
                        Margin="-1"/>
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX"
                                       To="1.045" Duration="0:0:0.28">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY"
                                       To="1.045" Duration="0:0:0.28">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="AccentGlow" Storyboard.TargetProperty="Opacity"
                                       To="1" Duration="0:0:0.22"/>
                      <DoubleAnimation Storyboard.TargetName="LiquidSheen" Storyboard.TargetProperty="Opacity"
                                       To="0.95" Duration="0:0:0.2"/>
                      <DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="BlurRadius"
                                       To="36" Duration="0:0:0.28"/>
                      <DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="Opacity"
                                       To="0.48" Duration="0:0:0.28"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX"
                                       To="1" Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY"
                                       To="1" Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="AccentGlow" Storyboard.TargetProperty="Opacity"
                                       To="0" Duration="0:0:0.2"/>
                      <DoubleAnimation Storyboard.TargetName="LiquidSheen" Storyboard.TargetProperty="Opacity"
                                       To="0" Duration="0:0:0.2"/>
                      <DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="BlurRadius"
                                       To="22" Duration="0:0:0.25"/>
                      <DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="Opacity"
                                       To="0.32" Duration="0:0:0.25"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource HubAccent}"/>
                <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource HubSurfaceElevated}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource HubAccentPressed}"/>
                <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource HubSelection}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX"
                                       To="0.985" Duration="0:0:0.08"/>
                      <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY"
                                       To="0.985" Duration="0:0:0.08"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource HubAccent}"/>
                <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                <Setter TargetName="AccentGlow" Property="Opacity" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="HubBackButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="MinWidth" Value="100"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="{StaticResource HubSurfaceElevated}"/>
      <Setter Property="Foreground" Value="{StaticResource HubText}"/>
      <Setter Property="BorderBrush" Value="{StaticResource HubAccent}"/>
    </Style>

    <Storyboard x:Key="HubAmbientStoryboard" RepeatBehavior="Forever">
      <PointAnimationUsingKeyFrames Storyboard.TargetName="PrimaryGlowBrush"
                                    Storyboard.TargetProperty="Center">
        <EasingPointKeyFrame KeyTime="0:0:0" Value="0.42,0.16"/>
        <EasingPointKeyFrame KeyTime="0:0:7" Value="0.68,0.30">
          <EasingPointKeyFrame.EasingFunction>
            <CubicEase EasingMode="EaseInOut"/>
          </EasingPointKeyFrame.EasingFunction>
        </EasingPointKeyFrame>
        <EasingPointKeyFrame KeyTime="0:0:14" Value="0.30,0.38">
          <EasingPointKeyFrame.EasingFunction>
            <CubicEase EasingMode="EaseInOut"/>
          </EasingPointKeyFrame.EasingFunction>
        </EasingPointKeyFrame>
        <EasingPointKeyFrame KeyTime="0:0:21" Value="0.42,0.16">
          <EasingPointKeyFrame.EasingFunction>
            <CubicEase EasingMode="EaseInOut"/>
          </EasingPointKeyFrame.EasingFunction>
        </EasingPointKeyFrame>
      </PointAnimationUsingKeyFrames>
      <DoubleAnimation Storyboard.TargetName="PrimaryGlowBrush" Storyboard.TargetProperty="RadiusX"
                       From="0.55" To="0.92" Duration="0:0:8" AutoReverse="True">
        <DoubleAnimation.EasingFunction>
          <CubicEase EasingMode="EaseInOut"/>
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="PrimaryGlowBrush" Storyboard.TargetProperty="RadiusY"
                       From="0.40" To="0.72" Duration="0:0:9.5" AutoReverse="True">
        <DoubleAnimation.EasingFunction>
          <CubicEase EasingMode="EaseInOut"/>
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="PrimaryGlowLayer" Storyboard.TargetProperty="Opacity"
                       From="0.65" To="1" Duration="0:0:4.2" AutoReverse="True">
        <DoubleAnimation.EasingFunction>
          <SineEase EasingMode="EaseInOut"/>
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="LogoShadow" Storyboard.TargetProperty="Opacity"
                       From="0.38" To="0.78" Duration="0:0:3.6" AutoReverse="True">
        <DoubleAnimation.EasingFunction>
          <SineEase EasingMode="EaseInOut"/>
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="LogoShadow" Storyboard.TargetProperty="BlurRadius"
                       From="20" To="40" Duration="0:0:3.6" AutoReverse="True">
        <DoubleAnimation.EasingFunction>
          <SineEase EasingMode="EaseInOut"/>
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
    </Storyboard>
  </Window.Resources>

  <Grid x:Name="RootGrid" Background="{StaticResource HubBg}">
    <!-- Background that warps under the pointer (no blobs) -->
    <Grid x:Name="BackdropHost" IsHitTestVisible="False" ClipToBounds="True">
      <Grid x:Name="AmbientSource" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
          <TransformGroup>
            <ScaleTransform x:Name="WarpScale" ScaleX="1" ScaleY="1"/>
            <SkewTransform x:Name="WarpSkew" AngleX="0" AngleY="0"/>
          </TransformGroup>
        </Grid.RenderTransform>

        <Rectangle x:Name="PrimaryGlowLayer">
          <Rectangle.Fill>
            <RadialGradientBrush x:Name="PrimaryGlowBrush" Center="0.45,0.18" RadiusX="0.72" RadiusY="0.55">
              <GradientStop Color="#77C62828" Offset="0"/>
              <GradientStop Color="#33A01818" Offset="0.4"/>
              <GradientStop Color="#FF0A0A0B" Offset="1"/>
            </RadialGradientBrush>
          </Rectangle.Fill>
        </Rectangle>

        <Rectangle Opacity="0.07" Margin="20">
          <Rectangle.RenderTransform>
            <TranslateTransform x:Name="GridWarp"/>
          </Rectangle.RenderTransform>
          <Rectangle.Fill>
            <DrawingBrush TileMode="Tile" Viewport="0,0,28,28" ViewportUnits="Absolute">
              <DrawingBrush.Drawing>
                <GeometryDrawing Brush="Transparent">
                  <GeometryDrawing.Pen>
                    <Pen Brush="#FFC62828" Thickness="0.7"/>
                  </GeometryDrawing.Pen>
                  <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="0,0,28,28"/>
                  </GeometryDrawing.Geometry>
                </GeometryDrawing>
              </DrawingBrush.Drawing>
            </DrawingBrush>
          </Rectangle.Fill>
        </Rectangle>

        <Rectangle Opacity="0.35">
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#22C62828" Offset="0"/>
              <GradientStop Color="#00000000" Offset="0.5"/>
              <GradientStop Color="#148E1B1B" Offset="1"/>
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
      </Grid>

      <!-- Liquid lens: magnified/warped slice of the ambient backdrop under the cursor -->
      <Ellipse x:Name="DistortionLens"
               Width="240" Height="240"
               Opacity="0"
               IsHitTestVisible="False">
        <Ellipse.Fill>
          <VisualBrush x:Name="LensBrush"
                       Visual="{Binding ElementName=AmbientSource}"
                       ViewboxUnits="Absolute"
                       ViewportUnits="RelativeToBoundingBox"
                       Viewport="0,0,1,1"
                       Stretch="Fill"
                       AlignmentX="Left"
                       AlignmentY="Top"/>
        </Ellipse.Fill>
        <Ellipse.OpacityMask>
          <RadialGradientBrush>
            <GradientStop Color="#E6FFFFFF" Offset="0"/>
            <GradientStop Color="#66FFFFFF" Offset="0.55"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.OpacityMask>
        <Ellipse.RenderTransform>
          <TransformGroup>
            <ScaleTransform x:Name="LensMagnify" ScaleX="1.14" ScaleY="1.14" CenterX="120" CenterY="120"/>
            <TranslateTransform x:Name="LensTransform"/>
          </TransformGroup>
        </Ellipse.RenderTransform>
      </Ellipse>
    </Grid>

    <Grid x:Name="SelectionView" Margin="40,28,40,32">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Image Grid.Row="0"
             Source="pack://application:,,,/Assets/RME.png"
             Width="132" Height="132"
             Stretch="Uniform"
             HorizontalAlignment="Center"
             RenderOptions.BitmapScalingMode="HighQuality"
             Margin="0,0,0,6">
        <Image.Effect>
          <DropShadowEffect x:Name="LogoShadow"
                            BlurRadius="28" ShadowDepth="0"
                            Opacity="0.55" Color="#C62828"/>
        </Image.Effect>
      </Image>

      <TextBlock Grid.Row="1"
                 Text="¿Qué quieres crear?"
                 HorizontalAlignment="Center"
                 FontSize="18"
                 Foreground="{StaticResource HubTextSecondary}"
                 Margin="0,2,0,22"/>

      <UniformGrid Grid.Row="2" Columns="2" Rows="1"
                   HorizontalAlignment="Center" VerticalAlignment="Center">
        <Button Style="{StaticResource HubModuleCard}"
                Width="250" Height="250"
                Margin="12,0"
                Click="MapsCard_Click"
                MouseMove="ModuleCard_MouseMove"
                ToolTip="Abrir el editor de mapas">
          <StackPanel VerticalAlignment="Center" Margin="18">
            <Border Width="80" Height="80" CornerRadius="16"
                    Background="{StaticResource HubAccentSubtle}"
                    HorizontalAlignment="Center" Margin="0,0,0,18">
              <Viewbox Width="44" Height="44">
                <Canvas Width="48" Height="48">
                  <Path Stroke="{StaticResource HubAccent}" StrokeThickness="2.2"
                        StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        Data="M 8,18 L 24,10 L 40,18 L 24,26 Z
                              M 8,18 L 8,30 L 24,38 L 24,26
                              M 40,18 L 40,30 L 24,38
                              M 16,22 L 16,28
                              M 32,22 L 32,28"/>
                </Canvas>
              </Viewbox>
            </Border>
            <TextBlock Text="MAPAS" FontSize="22" FontWeight="SemiBold"
                       FontFamily="{DynamicResource AppFontFamilyDisplay}"
                       Foreground="{StaticResource HubText}"
                       HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Text="Crear, editar y publicar mapas." FontSize="13"
                       Foreground="{StaticResource HubTextSecondary}"
                       TextAlignment="Center" TextWrapping="Wrap"
                       MaxWidth="190" HorizontalAlignment="Center"/>
          </StackPanel>
        </Button>

        <Button Style="{StaticResource HubModuleCard}"
                Width="250" Height="250"
                Margin="12,0"
                Click="ContentCard_Click"
                MouseMove="ModuleCard_MouseMove"
                ToolTip="Workspace único: NPC, diálogos y misiones">
          <StackPanel VerticalAlignment="Center" Margin="18">
            <Border Width="80" Height="80" CornerRadius="16"
                    Background="{StaticResource HubAccentSubtle}"
                    HorizontalAlignment="Center" Margin="0,0,0,18">
              <Viewbox Width="44" Height="44">
                <Canvas Width="48" Height="48">
                  <Path Stroke="{StaticResource HubAccent}" StrokeThickness="2.2"
                        StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        Fill="Transparent"
                        Data="M 14,8 L 30,8 L 36,14 L 36,40 L 14,40 Z
                              M 30,8 L 30,14 L 36,14
                              M 20,22 L 30,22
                              M 20,28 L 30,28
                              M 20,34 L 26,34"/>
                </Canvas>
              </Viewbox>
            </Border>
            <TextBlock Text="CONTENIDO" FontSize="22" FontWeight="SemiBold"
                       FontFamily="{DynamicResource AppFontFamilyDisplay}"
                       Foreground="{StaticResource HubText}"
                       HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Text="NPC, diálogos y misiones en un workspace." FontSize="13"
                       Foreground="{StaticResource HubTextSecondary}"
                       TextAlignment="Center" TextWrapping="Wrap"
                       MaxWidth="190" HorizontalAlignment="Center"/>
          </StackPanel>
        </Button>
      </UniformGrid>

      <StackPanel Grid.Row="3" Margin="0,14,0,0">
        <TextBlock Text="Elige un módulo para continuar"
                   HorizontalAlignment="Center" FontSize="12"
                   Foreground="{StaticResource HubTextMuted}"/>
        <TextBlock x:Name="LicenseStatusLabel"
                   HorizontalAlignment="Center" FontSize="11"
                   Foreground="{StaticResource HubTextMuted}"
                   Margin="0,6,0,0"
                   Visibility="Collapsed"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
