<Window x:Class="RufusMapEditor.App.ReplaceGfxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reemplazar / operaciones GFX"
        Height="460" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FF1A1814"
        Foreground="#FFF5F0E6">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Background="#FF2A2620" CornerRadius="6"
            BorderBrush="#FF4A453C" BorderThickness="1" Padding="12,10" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal">
        <Border Width="3" Height="16" CornerRadius="1.5" Background="#FFC4A35A" Margin="0,0,10,0"/>
        <TextBlock Text="Reemplazar GFX" FontWeight="SemiBold" VerticalAlignment="Center"
                   Foreground="#FFF5F0E6"/>
      </StackPanel>
    </Border>

    <TextBlock x:Name="LayerHint" Grid.Row="1" Margin="0,0,0,10"
               TextWrapping="Wrap" Foreground="#FFB8B0A0" FontSize="12"/>

    <StackPanel Grid.Row="2" Margin="0,0,0,10">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
        <TextBlock Text="Buscar GfxID:" Width="120" VerticalAlignment="Center" Foreground="#FFB8B0A0"/>
        <TextBox x:Name="FindBox" Width="140" Background="#FF2A2620" Foreground="#FFF5F0E6"
                 BorderBrush="#FF4A453C" CaretBrush="#FFF5F0E6"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Reemplazar por:" Width="120" VerticalAlignment="Center" Foreground="#FFB8B0A0"/>
        <TextBox x:Name="ReplaceBox" Width="140" Background="#FF2A2620" Foreground="#FFF5F0E6"
                 BorderBrush="#FF4A453C" CaretBrush="#FFF5F0E6"/>
      </StackPanel>
    </StackPanel>

    <GroupBox Grid.Row="3" Header="Alcance" Margin="0,0,0,10" Foreground="#FFF5F0E6"
              BorderBrush="#FF4A453C" Padding="8,6">
      <StackPanel>
        <RadioButton x:Name="ScopeSelection" Content="Solo selección de celdas" IsChecked="True"
                     Margin="0,0,0,4" Foreground="#FFF5F0E6"/>
        <RadioButton x:Name="ScopeWholeMap" Content="Todo el mapa" Foreground="#FFF5F0E6"/>
      </StackPanel>
    </GroupBox>

    <GroupBox Grid.Row="4" Header="Capas" Margin="0,0,0,10" Foreground="#FFF5F0E6"
              BorderBrush="#FF4A453C" Padding="8,6">
      <StackPanel>
        <RadioButton x:Name="LayerActive" Content="Capa activa (destino actual)" IsChecked="True"
                     Margin="0,0,0,4" Foreground="#FFF5F0E6"/>
        <RadioButton x:Name="LayerObject1" Content="Solo Capa 1" Margin="0,0,0,4" Foreground="#FFF5F0E6"/>
        <RadioButton x:Name="LayerObject2" Content="Solo Capa 2" Margin="0,0,0,4" Foreground="#FFF5F0E6"/>
        <RadioButton x:Name="LayerObjects" Content="Capa 1 + Capa 2" Margin="0,0,0,4" Foreground="#FFF5F0E6"/>
        <RadioButton x:Name="LayerAll" Content="Todas (Suelo + C1 + C2)" Foreground="#FFF5F0E6"/>
      </StackPanel>
    </GroupBox>

    <GroupBox Grid.Row="5" Header="Transformación al reemplazar" Margin="0,0,0,10"
              Foreground="#FFF5F0E6" BorderBrush="#FF4A453C" Padding="8,6">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
          <TextBlock Text="Rotación:" Width="80" VerticalAlignment="Center" Foreground="#FFB8B0A0"/>
          <ComboBox x:Name="RotationBox" Width="220"
                    Background="#FF2A2620" Foreground="#FFF5F0E6" BorderBrush="#FF4A453C"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Flip:" Width="80" VerticalAlignment="Center" Foreground="#FFB8B0A0"/>
          <ComboBox x:Name="FlipBox" Width="220"
                    Background="#FF2A2620" Foreground="#FFF5F0E6" BorderBrush="#FF4A453C"/>
        </StackPanel>
      </StackPanel>
    </GroupBox>

    <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Aplicar" Width="96" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"
              Background="#FFC4A35A" Foreground="#FF1A1814" FontWeight="SemiBold" Padding="10,6"/>
      <Button Content="Cancelar" Width="88" IsCancel="True" Padding="10,6"
              Background="#FF2A2620" Foreground="#FFF5F0E6"/>
    </StackPanel>
  </Grid>
</Window>
