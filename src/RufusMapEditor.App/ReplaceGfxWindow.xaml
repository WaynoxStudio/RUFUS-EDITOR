<Window x:Class="RufusMapEditor.App.ReplaceGfxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reemplazar GFX" Height="200" Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Background="{DynamicResource DialogHeaderBackground}" CornerRadius="6"
            BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="12,10" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal">
        <Border Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource BrandAccent}" Margin="0,0,10,0"/>
        <TextBlock Text="Reemplazar GFX" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>
    <TextBlock x:Name="LayerLabel" Grid.Row="1" Margin="0,0,0,12" Foreground="{DynamicResource TextSecondary}"/>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
      <TextBlock Text="Buscar GfxID:" Width="110" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
      <TextBox x:Name="FindBox" Width="120"/>
    </StackPanel>
    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Top">
      <TextBlock Text="Reemplazar por:" Width="110" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
      <TextBox x:Name="ReplaceBox" Width="120"/>
    </StackPanel>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Aplicar" Width="88" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Ok_Click"/>
      <Button Content="Cancelar" Width="88" IsCancel="True"/>
    </StackPanel>
  </Grid>
</Window>
